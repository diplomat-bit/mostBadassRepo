#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

echo "==> Running Go build"
go build ./...

echo "==> Checking tests compile"
go test -run=^$ ./...


================================================================================
// APPENDED FROM REPO: diplomat-bit/jocall3-node | ORIGINAL PATH: diplomat-bit-jocall3-node-fae6abf/scripts/lint
================================================================================

#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

echo "==> Running eslint"
ESLINT_USE_FLAT_CONFIG="false" ./node_modules/.bin/eslint --ext ts,js .

echo "==> Running tsc"
./node_modules/.bin/tsc --noEmit


