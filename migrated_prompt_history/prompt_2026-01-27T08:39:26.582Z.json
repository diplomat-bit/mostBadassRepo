d for complex strategy. Identity verified via Master Anchor. System status: NOMINAL.\" }] }];\n    });\n    const [input, setInput] = useState('');\n    const [isThinking, setIsThinking] = useState(false);\n    const chatRef = useRef<Chat | null>(null);\n    const scrollRef = useRef<HTMLDivElement>(null);\n\n    useEffect(() => {\n        if (scrollRef.current) scrollRef.current.scrollTop = scrollRef.current.scrollHeight;\n        localStorage.setItem('quantum_log_v3', JSON.stringify(messages));\n    }, [messages]);\n\n    useEffect(() => {\n        if (!chatRef.current) {\n            const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });\n            chatRef.current = ai.chats.create({\n                model: 'gemini-3-pro-preview',\n                config: { \n                    systemInstruction: SYSTEM_INSTRUCTION, \n                    tools: toolDefinitions,\n                    thinkingConfig: { thinkingBudget: 4000 } // Deeper strategy thinking\n                }\n            });\n        }\n    }, []);\n\n    const executeTool = async (call: any) => {\n        if (!context) return { error: \"Context synchronization failure.\" };\n        \n        switch(call.name) {\n            case 'getFinancialSummary':\n                const fiat = context.assets.reduce((s, a) => s + a.value, 0);\n                const crypto = context.cryptoAssets.reduce((s, a) => s + a.value, 0);\n                return { \n                    totalNetWorth: (fiat + crypto).toLocaleString(), \n                    status: 'OPTIMIZED', \n                    activeLedgers: context.linkedAccounts.length,\n                    threatLevel: 'NULL'\n                };\n            case 'mintCreativeNFT':\n                return { \n                    status: 'FORGE_PROTOCOL_INITIATED', \n                    message: `Parameters for \"${call.args.assetName}\" are queued. Target: Web3 Nexus Forge.` \n                };\n            default:\n                return { error: \"Unknown logic node.\" };\n        }\n    };\n\n    const handleSend = async () => {\n        if (!input.trim() || !chatRef.current || isThinking) return;\n        \n        const userMsg = { role: 'user', parts: [{ text: input }] };\n        setMessages(prev => [...prev, userMsg]);\n        const currentInput = input;\n        setInput('');\n        setIsThinking(true);\n\n        try {\n            let response = await chatRef.current.sendMessage({ message: currentInput }) as GenerateContentResponse;\n            \n            while (response.functionCalls && response.functionCalls.length > 0) {\n                const toolResults = [];\n                for (const call of response.functionCalls) {\n                    const result = await executeTool(call);\n                    toolResults.push({ \n                        functionResponse: { \n                            name: call.name, \n                            response: result, \n                            id: call.id \n                        } \n                    });\n                }\n                response = await chatRef.current.sendMessage({ message: toolResults }) as GenerateContentResponse;\n            }\n\n            if (response.text) {\n                setMessages(prev => [...prev, { role: 'model', parts: [{ text: response.text }] }]);\n            }\n        } catch (e) {\n            console.error(\"Quantum Link Failure:\", e);\n            setMessages(prev => [...prev, { role: 'model', parts: [{ text: \"Quantum Core Bottleneck. Synaptic relay re-initializing.\" }] }]);\n        } finally {\n            setIsThinking(false);\n        }\n    };\n\n    return (\n        <div className=\"h-full flex flex-col\">\n            <header className=\"mb-8\">\n                <h2 className=\"text-4xl font-black text-white tracking-tighter uppercase italic\">Quantum <span className=\"text-cyan-500\">Advisory</span></h2>\n                <p className=\"text-[9px] font-black text-gray-600 uppercase tracking-[0.5em] mt-2\">Node: Gemini-3-Pro-Sovereign • Deep Reason Active</p>\n            </header>\n\n            <Card className=\"flex-1 flex flex-col bg-black border-gray-800 shadow-[0_0_50px_rgba(0,0,0,1)]\" padding=\"none\">\n                <div ref={scrollRef} className=\"flex-1 p-8 space-y-8 overflow-y-auto custom-scrollbar\">\n                    {messages.map((msg, i) => (\n                        <div key={i} className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}>\n                            <div className={`max-w-2xl p-6 rounded-[2.5rem] text-sm font-bold shadow-2xl border ${msg.role === 'user' ? 'bg-cyan-900/20 border-cyan-500/50 text-white rounded-br-none' : 'bg-gray-900/50 text-gray-200 border-gray-800 rounded-bl-none'}`}>\n                                {msg.parts[0].text}\n                            </div>\n                        </div>\n                    ))}\n                    {isThinking && <div className=\"text-cyan-400 font-black uppercase italic text-xs tracking-widest animate-pulse ml-2\">Quantum Thinking Deeply...</div>}\n                </div>\n                <div className=\"p-6 bg-black border-t border-gray-800 flex gap-4\">\n                    <input \n                        value={input} \n                        onChange={e => setInput(e.target.value)} \n                        onKeyDown={e => e.key === 'Enter' && handleSend()} \n                        placeholder=\"Issue directives to Quantum...\" \n                        className=\"flex-1 bg-gray-900/80 border border-gray-800 rounded-2xl px-8 py-5 text-white font-bold italic outline-none focus:ring-2 focus:ring-cyan-500 transition-all placeholder:text-gray-700\" \n                    />\n                    <button \n                        onClick={handleSend} \n                        disabled={isThinking}\n                        className=\"bg-cyan-600 px-12 rounded-2xl font-black text-white uppercase tracking-widest italic hover:bg-cyan-500 transition-all shadow-lg shadow-cyan-900/20 disabled:opacity-30\"\n                    >\n                        Send\n                    </button>\n                </div>\n            </Card>\n        </div>\n    );\n};\n\nexport default AIAdvisorView;"
            }
          ]
