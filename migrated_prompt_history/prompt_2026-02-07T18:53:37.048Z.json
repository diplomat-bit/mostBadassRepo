              "replacement": "\nimport React, { useState, useEffect } from 'react';\nimport { \n  PlaidCredentials, \n  Account, \n  Transaction,\n  MarqetaCredentials,\n  MarqetaCardProduct,\n  MarqetaCard\n} from '../types';\nimport { \n  CreditCard, Wallet, Search, \n  ExternalLink, ChevronRight, Database, Landmark,\n  RefreshCcw, AlertCircle, Info,\n  ArrowUpRight, ArrowDownLeft, ShieldCheck, Zap,\n  Activity, Settings, Box, Plus, Sparkles, X, CheckCircle, Cpu, UserCheck\n} from 'lucide-react';\n\ninterface Props {\n  accessToken: string;\n  credentials: PlaidCredentials;\n  marqetaCreds: MarqetaCredentials;\n  proxy: string;\n  addLog: (msg: any, type?: 'req' | 'res' | 'err') => void;\n}\n\nconst CARD_PRODUCT_CONFIG = {\n  \"token\": \"nexus_prod_\" + Math.random().toString(36).substring(7),\n  \"name\": \"Nexus Elite v1\",\n  \"active\": true,\n  \"config\": {\n    \"poi\": {\n      \"other\": { \"allow\": true, \"card_presence_required\": false, \"cardholder_presence_required\": false },\n      \"ecommerce\": true,\n      \"atm\": true\n    },\n    \"transaction_controls\": {\n      \"accepted_countries_token\": \"accept_us_only\",\n      \"always_require_pin\": false,\n      \"allow_gpa_auth\": true,\n      \"enable_partial_auth_approval\": true,\n      \"address_verification\": {\n        \"av_messages\": { \"validate\": true, \"decline_on_address_number_mismatch\": false, \"decline_on_postal_code_mismatch\": true }\n      }\n    },\n    \"card_life_cycle\": {\n      \"activate_upon_issue\": true,\n      \"expiration_offset\": { \"unit\": \"YEARS\", \"value\": 10 },\n      \"card_service_code\": 101\n    },\n    \"payment_instrument\": \"VIRTUAL_PAN\",\n    \"bin_prefix\": \"444444\",\n    \"fulfillment_provider\": \"PERFECTPLASTIC\",\n    \"allow_card_creation\": true\n  }\n};\n\nexport const Dashboard: React.FC<Props> = ({ accessToken, credentials, marqetaCreds, proxy, addLog }) => {\n  const [accounts, setAccounts] = useState<Account[]>([]);\n  const [transactions, setTransactions] = useState<Transaction[]>([]);\n  const [cardProducts, setCardProducts] = useState<MarqetaCardProduct[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [marqetaLoading, setMarqetaLoading] = useState(true);\n  const [isMinting, setIsMinting] = useState(false);\n  const [newCard, setNewCard] = useState<MarqetaCard | null>(null);\n  const [error, setError] = useState<string | null>(null);\n\n  const marqetaFetch = async (endpoint: string, method: string = 'GET', body?: any) => {\n    const targetUrl = `https://sandbox-api.marqeta.com/v3${endpoint}`;\n    const finalUrl = proxy ? `${proxy}${encodeURIComponent(targetUrl)}` : targetUrl;\n    const auth = btoa(`${marqetaCreds.applicationToken}:${marqetaCreds.adminAccessToken}`);\n    \n    addLog(`${method} ${endpoint} [MARQETA]`, 'req');\n    const response = await fetch(finalUrl, {\n      method,\n      headers: { \n        'Content-Type': 'application/json',\n        'Authorization': `Basic ${auth}`\n      },\n      body: body ? JSON.stringify(body) : undefined\n    });\n    \n    const data = await response.json();\n    if (!response.ok) {\n      addLog(data, 'err');\n      throw new Error(data.error_message || `Marqeta Error: ${response.status}`);\n    }\n    addLog(data, 'res');\n    return data;\n  };\n\n  const fetchPlaidData = async () => {\n    try {\n      const baseUrl = `https://${credentials.environment}.plaid.com`;\n      const fetchWithProxy = async (endpoint: string) => {\n        const targetUrl = `${baseUrl}${endpoint}`;\n        const finalUrl = proxy ? `${proxy}${encodeURIComponent(targetUrl)}` : targetUrl;\n        addLog(`POST ${endpoint} [PLAID]`, 'req');\n        const response = await fetch(finalUrl, {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({ client_id: credentials.clientId, secret: credentials.secret, access_token: accessToken })\n        });\n        const data = await response.json();\n        if (!response.ok) throw new Error(data.error_message || `API Error: ${response.status}`);\n        addLog(data, 'res');\n        return data;\n      };\n\n      const accountData = await fetchWithProxy('/accounts/get');\n      setAccounts(accountData.accounts.map((a: any) => ({\n        id: a.account_id, name: a.name, mask: a.mask, type: a.type, subtype: a.subtype,\n        balance: { available: a.balances.available, current: a.balances.current, limit: a.balances.limit, currency: a.balances.iso_currency_code || 'USD' }\n      })));\n      \n      const txData = await fetchWithProxy('/transactions/sync');\n      if (txData.added) {\n        setTransactions(txData.added.map((t: any) => ({\n          id: t.transaction_id, date: t.date, name: t.name, amount: t.amount, category: t.category, pending: t.pending\n        })));\n      }\n    } catch (err: any) {\n      setError(err.message);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const fetchMarqetaProducts = async () => {\n    setMarqetaLoading(true);\n    try {\n      const data = await marqetaFetch('/cardproducts?sort_by=-lastModifiedTime');\n      setCardProducts(data.data || []);\n    } catch (err: any) {\n      console.error(err);\n    } finally {\n      setMarqetaLoading(false);\n    }\n  };\n\n  const mintFullCard = async () => {\n    setIsMinting(true);\n    setError(null);\n    try {\n      // 1. Create User\n      const user = await marqetaFetch('/users', 'POST', {\n        token: \"user_nexus_\" + Math.random().toString(36).substring(7),\n        first_name: \"Nexus\",\n        last_name: \"Operator\"\n      });\n\n      // 2. Ensure we have a Card Product. If none exists, create the default one.\n      let productToken = cardProducts[0]?.token;\n      if (!productToken) {\n        const product = await marqetaFetch('/cardproducts', 'POST', CARD_PRODUCT_CONFIG);\n        productToken = product.token;\n        await fetchMarqetaProducts();\n      }\n\n      // 3. Issue Card\n      const card = await marqetaFetch('/cards?show_pan=true&show_cvv_number=true', 'POST', {\n        user_token: user.token,\n        card_product_token: productToken\n      });\n\n      setNewCard({\n        token: card.token,\n        user_token: card.user_token,\n        card_product_token: card.card_product_token,\n        last_four: card.last_four,\n        pan: card.pan,\n        expiration: card.expiration,\n        cvv: card.cvv_number,\n        state: card.state\n      });\n    } catch (err: any) {\n      setError(\"Card Issuance Failed: \" + err.message);\n    } finally {\n      setIsMinting(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchPlaidData();\n    fetchMarqetaProducts();\n  }, [accessToken, proxy]);\n\n  const totalBalance = accounts.reduce((acc, curr) => \n    curr.type === 'depository' ? acc + curr.balance.current : acc - curr.balance.current, 0\n  );\n\n  return (\n    <div className=\"space-y-12 pb-20 animate-in fade-in slide-in-from-bottom-8 duration-1000 relative\">\n      \n      {/* SUCCESS MODAL - BAD ASS UI */}\n      {newCard && (\n        <div className=\"fixed inset-0 z-[100] flex items-center justify-center p-6 bg-slate-950/90 backdrop-blur-2xl animate-in fade-in duration-500\">\n          <div className=\"absolute inset-0 overflow-hidden pointer-events-none\">\n             <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-blue-600/20 blur-[120px] rounded-full animate-pulse\" />\n          </div>\n          \n          <div className=\"relative bg-slate-900 border border-white/10 p-12 rounded-[3rem] shadow-[0_0_100px_rgba(37,99,235,0.2)] max-w-xl w-full text-center space-y-10 animate-in zoom-in-95 slide-in-from-bottom-20 duration-700\">\n            <button onClick={() => setNewCard(null)} className=\"absolute top-8 right-8 text-slate-500 hover:text-white transition-colors\">\n              <X size={32} />\n            </button>\n\n            <div className=\"space-y-4\"