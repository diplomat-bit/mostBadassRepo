no text-blue-400 focus:outline-none\" />\n                </div>\n              </div>\n           </div>\n        </div>\n      )}\n\n      <main className=\"flex-1 flex flex-col xl:flex-row max-w-[1600px] mx-auto w-full p-8 lg:p-12 gap-12 relative z-10\">\n        <div className=\"flex-1 space-y-12\">\n          {/* Progress Stepper */}\n          <div className=\"bg-slate-900/40 p-6 rounded-[2rem] border border-white/5 flex items-center justify-between gap-4 overflow-x-auto scrollbar-hide backdrop-blur-md\">\n            {[\n              { s: FlowStep.CREDENTIALS, icon: Shield, label: 'Identify' },\n              { s: FlowStep.LINK_TOKEN, icon: Key, label: 'Handshake' },\n              { s: FlowStep.LINK_UI, icon: LinkIcon, label: 'Link UI' },\n              { s: FlowStep.EXCHANGE, icon: Database, label: 'Exchange' },\n              { s: FlowStep.DASHBOARD, icon: LayoutDashboard, label: 'Nexus' }\n            ].map((item, idx) => (\n              <React.Fragment key={item.s}>\n                <div className={`flex flex-col items-center gap-3 transition-all ${step === item.s ? 'scale-105' : 'opacity-40'}`}>\n                  <div className={`w-14 h-14 rounded-2xl flex items-center justify-center border-2 transition-all duration-500 relative\n                    ${step === item.s ? 'bg-blue-600 border-blue-400 shadow-[0_0_20px_rgba(37,99,235,0.4)] text-white' : 'border-white/10 bg-slate-950/50 text-slate-500'}`}>\n                    <item.icon size={22} />\n                  </div>\n                  <span className=\"text-[10px] font-black uppercase tracking-[0.2em]\">{item.label}</span>\n                </div>\n                {idx < 4 && <div className=\"flex-1 min-w-[40px] h-[2px] bg-white/5\" />}\n              </React.Fragment>\n            ))}\n          </div>\n\n          <div className=\"relative\">\n            {error && (\n              <div className=\"mb-10 bg-red-500/5 border border-red-500/20 p-8 rounded-[2rem] flex items-start gap-6\">\n                <div className=\"w-12 h-12 rounded-2xl bg-red-500/10 flex items-center justify-center text-red-500 shrink-0\">\n                  <AlertCircle size={28} />\n                </div>\n                <div className=\"flex-1\">\n                  <h4 className=\"text-sm font-black text-red-400 uppercase tracking-widest mb-2\">Protocol Error</h4>\n                  <p className=\"text-sm text-red-200/60 font-medium\">{error}</p>\n                </div>\n                <button onClick={() => setError(null)} className=\"text-slate-600 hover:text-white p-2 bg-slate-950 rounded-xl\"><X size={20}/></button>\n              </div>\n            )}\n\n            <div className=\"min-h-[500px]\">\n              {step === FlowStep.CREDENTIALS && <CredentialsForm onSubmit={handleCredentialsSubmit} />}\n              \n              {step === FlowStep.LINK_TOKEN && (\n                <div className=\"bg-slate-900/30 rounded-[3rem] border border-white/5 p-20 text-center space-y-12 backdrop-blur-xl animate-in fade-in zoom-in-95 duration-700\">\n                  <div className=\"relative inline-block\">\n                    <div className=\"absolute inset-0 bg-blue-500 blur-3xl opacity-20 animate-pulse\" />\n                    <div className=\"relative w-32 h-32 bg-slate-950 rounded-[2.5rem] flex items-center justify-center mx-auto text-blue-500 border border-white/5 shadow-2xl\">\n                      <Key size={56} />\n                    </div>\n                  </div>\n                  <div className=\"max-w-md mx-auto space-y-4\">\n                    <h2 className=\"text-4xl font-black text-white tracking-tighter italic uppercase leading-none\">Plaid Handshake</h2>\n                    <p className=\"text-slate-400 text-lg\">Acquiring institutional session token...</p>\n                  </div>\n                  <button onClick={createLinkToken} disabled={isLoading} className=\"w-full max-w-sm bg-blue-600 hover:bg-blue-500 text-white font-black py-6 rounded-2xl shadow-xl transition-all disabled:opacity-50 uppercase tracking-[0.2em] text-sm flex items-center justify-center gap-4 mx-auto group\">\n                    {isLoading ? <RefreshCcw className=\"animate-spin\" /> : <>Request Link Token <ChevronRight size={20} /></>}\n                  </button>\n                </div>\n              )}\n\n              {step === FlowStep.LINK_UI && (\n                <div className=\"bg-slate-900/30 rounded-[3rem] border border-white/5 p-20 text-center space-y-12 backdrop-blur-xl animate-in fade-in zoom-in-95 duration-700\">\n                  <div className=\"relative inline-block\">\n                    <div className=\"absolute inset-0 bg-emerald-500 blur-3xl opacity-20 animate-pulse\" />\n                    <div className=\"relative w-32 h-32 bg-slate-950 rounded-[2.5rem] flex items-center justify-center mx-auto text-emerald-500 border border-white/5 shadow-2xl\">\n                      <LinkIcon size={56} />\n                    </div>\n                  </div>\n                  <div className=\"max-w-md mx-auto space-y-5\">\n                    <h2 className=\"text-4xl font-black text-white tracking-tighter italic uppercase leading-none\">KYC Verification</h2>\n                    <p className=\"text-slate-400 text-lg\">Securely connecting to your bank via Plaid Link.</p>\n                  </div>\n                  <button onClick={openLink} className=\"w-full max-w-sm bg-white text-slate-950 hover:bg-slate-100 font-black py-6 rounded-2xl shadow-xl transition-all uppercase tracking-[0.2em] text-sm mx-auto flex items-center justify-center gap-4 group\">\n                    Launch Plaid Link UI <ArrowRight size={20} />\n                  </button>\n                </div>\n              )}\n\n              {step === FlowStep.EXCHANGE && (\n                <div className=\"bg-slate-900/30 rounded-[3rem] border border-white/5 p-20 text-center space-y-12 backdrop-blur-xl animate-in fade-in zoom-in-95 duration-700\">\n               