>\n            <div className=\"p-7 border-b border-white/5 bg-slate-900/40 flex items-center justify-between\">\n              <div className=\"flex items-center gap-4\">\n                <TerminalIcon size={18} className=\"text-blue-500\" />\n                <span className=\"text-[11px] font-black uppercase tracking-[0.3em] text-white block\">Network_Traffic</span>\n              </div>\n              <button onClick={() => setLogs([])} className=\"text-[10px] font-black text-slate-600 hover:text-white uppercase px-3 py-1.5 bg-slate-900 rounded-lg\">Flush</button>\n            </div>\n            \n            <div className=\"flex-1 overflow-y-auto p-7 space-y-5 font-mono text-[11px] scrollbar-thin\">\n              {logs.map((log, i) => (\n                <div key={i} className={`p-4 rounded-xl border ${\n                  log.type === 'req' ? 'bg-blue-600/5 border-blue-500/20 text-blue-400' :\n                  log.type === 'res' ? 'bg-slate-900/60 border-white/5 text-slate-400' :\n                  'bg-red-500/5 border-red-500/20 text-red-400'\n                }`}>\n                  <div className=\"flex items-center justify-between mb-2 opacity-50 text-[9px]\">\n                    <span className=\"uppercase tracking-widest\">{log.type === 'req' ? 'Out' : log.type === 'res' ? 'In' : 'Err'}</span>\n                    <span>{log.timestamp}</span>\n                  </div>\n                  <pre className=\"whitespace-pre-wrap break-all leading-relaxed\">{log.msg}</pre>\n                </div>\n              ))}\n            </div>\n          </div>\n        </aside>\n      </main>\n    </div>\n  );\n};\n\nexport default App;\n"
