              "replacement": "\nimport React, { useState, useEffect } from 'react';\nimport { \n  Terminal, Shield, Key, Link as LinkIcon, Database, \n  LayoutDashboard, Activity, AlertCircle, RefreshCcw, \n  ArrowRight, Globe, Lock, X, CheckCircle2, Settings2,\n  ChevronRight, Wifi, ShieldCheck, Terminal as TerminalIcon, CreditCard\n} from 'lucide-react';\nimport { FlowStep, PlaidCredentials, PlaidTokenState, MarqetaCredentials } from './types';\nimport { CredentialsForm } from './components/CredentialsForm';\nimport { Dashboard } from './components/Dashboard';\n\nconst App: React.FC = () => {\n  const [step, setStep] = useState<FlowStep>(FlowStep.CREDENTIALS);\n  const [sdkStatus, setSdkStatus] = useState<'loading' | 'ready' | 'error'>('loading');\n  const [credentials, setCredentials] = useState<PlaidCredentials | null>(null);\n  const [marqetaCreds, setMarqetaCreds] = useState<MarqetaCredentials | null>(null);\n  const [tokens, setTokens] = useState<PlaidTokenState>({\n    linkToken: null,\n    publicToken: null,\n    accessToken: null\n  });\n  const [logs, setLogs] = useState<{msg: string, type: 'req' | 'res' | 'err', timestamp: string}[]>([]);\n  const [isLoading, setIsLoading] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  \n  const [proxyUrl, setProxyUrl] = useState('https://corsproxy.io/?url=');\n  const [useProxy, setUseProxy] = useState(true);\n  const [showSettings, setShowSettings] = useState(false);\n\n  useEffect(() => {\n    let checkInterval: number;\n    const checkPlaid = () => {\n      if ((window as any).Plaid) {\n        setSdkStatus('ready');\n        clearInterval(checkInterval);\n      } else if ((window as any).PLAID_LOAD_ERROR) {\n        setSdkStatus('error');\n        clearInterval(checkInterval);\n      }\n    };\n    checkInterval = window.setInterval(checkPlaid, 500);\n    return () => clearInterval(checkInterval);\n  }, []);\n\n  const addLog = (msg: any, type: 'req' | 'res' | 'err' = 'res') => {\n    const stringified = typeof msg === 'string' ? msg : JSON.stringify(msg, null, 2);\n    const timestamp = new Date().toLocaleTimeString('en-US', { \n      hour12: false, \n      fractionalSecondDigits: 3 \n    } as any);\n    setLogs(prev => [{ msg: stringified, type, timestamp }, ...prev].slice(0, 50));\n  };\n\n  const plaidFetch = async (endpoint: string, body: any) => {\n    setIsLoading(true);\n    setError(null);\n    const env = credentials?.environment || 'sandbox';\n    const baseUrl = `https://${env}.plaid.com${endpoint}`;\n    const finalUrl = useProxy ? `${proxyUrl}${encodeURIComponent(baseUrl)}` : baseUrl;\n    \n    addLog(`POST ${endpoint} [PLAID]`, 'req');\n    \n    try {\n      const response = await fetch(finalUrl, {\n        method: 'POST',\n        headers: { \n          'Content-Type': 'application/json',\n          'Accept': 'application/json'\n        },\n        body: JSON.stringify({\n          client_id: credentials?.clientId,\n          secret: credentials?.secret,\n          ...body\n        })\n      });\n\n      const data = await response.json();\n      if (!response.ok) {\n        addLog(data, 'err');\n        throw new Error(data.error_message || 'Plaid API error');\n      }\n\n      addLog(data, 'res');\n      return data;\n    } catch (err: any) {\n      const msg = err.message || 'Plaid request failed.';\n      setError(msg);\n      addLog(msg, 'err');\n      throw err;\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const handleCredentialsSubmit = (plaid: PlaidCredentials, marqeta: MarqetaCredentials) => {\n    setCredentials(plaid);\n    setMarqetaCreds(marqeta);\n    setStep(FlowStep.LINK_TOKEN);\n    addLog(\"Multi-node credentials initialized.\", 'res');\n  };\n\n  const createLinkToken = async () => {\n    try {\n      const res = await plaidFetch('/link/token/create', {\n        user: { client_user_id: 'nexus_user_' + Date.now() },\n        client_name: 'Plaid Nexus',\n        products: ['auth', 'transactions'],\n        country_codes: ['US'],\n        language: 'en'\n      });\n      setTokens(prev => ({ ...prev, linkToken: res.link_token }));\n      setStep(FlowStep.LINK_UI);\n    } catch (e) {}\n  };\n\n  const openLink = () => {\n    if (sdkStatus !== 'ready') {\n      setError(\"Plaid SDK is not ready yet.\");\n      return;\n    }\n    if (!tokens.linkToken) return;\n\n    const handler = (window as any).Plaid.create({\n      token: tokens.linkToken,\n      onSuccess: (public_token: string) => {\n        setTokens(prev => ({ ...prev, publicToken: public_token }));\n        addLog({ status: \"Link Success\", public_token }, 'res');\n        setStep(FlowStep.EXCHANGE);\n      },\n      onExit: (err: any) => {\n        if (err) {\n          setError(err.message || \"Link Exit\");\n          addLog(err, 'err');\n        } else {\n          addLog(\"Link closed by user\", 'res');\n        }\n      }\n    });\n    handler.open();\n  };\n\n  const exchangeToken = async () => {\n    try {\n      const res = await plaidFetch('/item/public_token/exchange', {\n        public_token: tokens.publicToken\n      });\n      setTokens(prev => ({ ...prev, accessToken: res.access_token }));\n      setStep(FlowStep.DASHBOARD);\n    } catch (e) {}\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#020617] text-slate-200 flex flex-col font-sans selection:bg-blue-500/30 overflow-x-hidden\">\n      <div className=\"fixed inset-0 pointer-events-none overflow-hidden\">\n        <div className=\"absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-blue-600/5 blur-[120px] rounded-full\" />\n        <div className=\"absolute bottom-[-5%] right-[-5%] w-[30%] h-[30%] bg-indigo-600/5 blur-[100px] rounded-full\" />\n      </div>\n\n      <header className=\"border-b border-white/5 bg-slate-950/40 backdrop-blur-2xl sticky top-0 z-50\">\n        <div className=\"max-w-[1600px] mx-auto px-8 h-24 flex items-center justify-between\">\n          <div className=\"flex items-center gap-6\">\n            <div className=\"relative group\">\n              <div className=\"absolute inset-0 bg-blue-600 rounded-2xl blur-lg opacity-40 group-hover:opacity-60 transition-opacity\" />\n              <div className=\"relative w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-700 rounded-2xl flex items-center justify-center border border-white/10 shadow-2xl\">\n                <Activity className=\"text-white w-7 h-7\" />\n              </div>\n            </div>\n            <div>\n              <div className=\"flex items-center gap-3\">\n                <h1 className=\"text-2xl font-black tracking-tighter text-white uppercase italic leading-none\">Plaid<span className=\"text-blue-500\">Nexus</span></h1>\n                <span className=\"bg-blue-500/10 border border-blue-500/20 text-blue-400 text-[9px] font-black px-2 py-0.5 rounded-full tracking-widest uppercase\">Integration_V2</span>\n              </div>\n              <div className=\"flex items-center gap-2 mt-1\">\n                <div className={`w-1.5 h-1.5 rounded-full ${sdkStatus === 'ready' ? 'bg-emerald-500 shadow-[0_0_8px_#10b981]' : 'bg-amber-500 animate-pulse'}`} />\n                <span className=\"text-[10px] font-black text-slate-500 uppercase tracking-[0.2em]\">Live_Node</span>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-6\">\n            <button \n              onClick={() => setShowSettings(!showSettings)}\n              className={`p-3.5 rounded-2xl border transition-all duration-300 ${showSettings ? 'bg-blue-600 border-blue-500 text-white shadow-[0_0_20px_rgba(37,99,235,0.4)]' : 'bg-slate-900/50 border-white/5 text-slate-400 hover:text-white hover:bg-slate-800'}`}\n            >\n              <Settings2 size={22} />\n            </button>\n            <div className=\"h-10 w-px bg-white/5\" />\n            <div className={`px-5 py-2.5 rounded-2xl flex items-center gap-3 border transition-all ${useProxy ? 'bg-emerald-500/5 