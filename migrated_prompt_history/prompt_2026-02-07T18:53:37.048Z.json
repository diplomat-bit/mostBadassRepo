lack text-white italic tracking-tighter uppercase leading-none mb-1\">Nexus Multi-Node Auth</h2>\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse\" />\n                  <p className=\"text-[9px] font-bold text-blue-400 uppercase tracking-[0.3em]\">Status: Ready_For_Integration</p>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"p-10 space-y-12 bg-slate-900/20\">\n          {/* Plaid Node */}\n          <section className=\"space-y-6\">\n            <div className=\"flex items-center gap-3 px-1\">\n              <div className=\"w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center text-blue-500 border border-blue-500/20\">\n                <Server size={16} />\n              </div>\n              <h3 className=\"text-xs font-black text-slate-400 uppercase tracking-widest\">Plaid Connectivity Node</h3>\n            </div>\n            \n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n              <div className=\"space-y-3\">\n                <label className=\"text-[10px] font-black text-slate-500 uppercase tracking-widest flex items-center gap-2 px-1\">\n                  Client ID\n                </label>\n                <input \n                  type=\"text\"\n                  required\n                  className=\"w-full px-5 py-4 rounded-xl border border-white/5 bg-slate-950/80 text-white placeholder-slate-700 focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-all outline-none font-mono text-sm shadow-inner\"\n                  placeholder=\"PLAID_CLIENT_ID\"\n                  value={plaidData.clientId}\n                  onChange={(e) => setPlaidData(p => ({ ...p, clientId: e.target.value }))}\n                />\n              </div>\n\n              <div className=\"space-y-3\">\n                <label className=\"text-[10px] font-black text-slate-500 uppercase tracking-widest flex items-center gap-2 px-1\">\n                  Secret Key\n                </label>\n                <div className=\"relative group\">\n                  <input \n                    type={showSecret ? \"text\" : \"password\"}\n                    required\n                    className=\"w-full px-5 py-4 rounded-xl border border-white/5 bg-slate-950/80 text-white placeholder-slate-700 focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-all outline-none font-mono text-sm shadow-inner\"\n                    placeholder=\"••••••••••••••••\"\n                    value={plaidData.secret}\n                    onChange={(e) => setPlaidData(p => ({ ...p, secret: e.target.value }))}\n                  />\n                  <button \n                    type=\"button\"\n                    onClick={() => setShowSecret(!showSecret)}\n                    className=\"absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 hover:text-white p-2\"\n                  >\n                    {showSecret ? <EyeOff size={18} /> : <Eye size={18} />}\n                  </button>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-3 gap-4\">\n              {(['sandbox', 'development', 'production'] as const).map((env) => (\n                <button\n                  key={env}\n                  type=\"button\"\n                  onClick={() => setPlaidData(p => ({ ...p, environment: env }))}\n                  className={`px-4 py-3 rounded-xl border text-[10px] font-black uppercase tracking-widest transition-all duration-300\n                    ${plaidData.environment === env \n                      ? 'border-blue-600 bg-blue-600/10 text-white' \n                      : 'border-white/5 bg-white/5 text-slate-500 hover:text-slate-300'}`}\n                >\n                  {env}\n                </button>\n              ))}\n            </div>\n          </section>\n\n          <div className=\"h-px bg-white/5 w-full\" />\n\n          {/* Marqeta Node */}\n          <section className=\"space-y-6\">\n            <div className=\"flex items-center gap-3 px-1\">\n              <div className=\"w-8 h-8 rounded-lg bg-emerald-500/10 flex items-center justify-center text-emerald-500 border border-emerald-500/20\">\n                <CreditCard size={16} />\n              </div>\n              <h3 className=\"text-xs font-black text-slate-400 uppercase tracking-widest\">Marqeta Issuing Node</h3>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n              <div className=\"space-y-3\">\n                <label className=\"text-[10px] font-black text-slate-500 uppercase tracking-widest flex items-center gap-2 px-1\">\n                  App Token\n                </label>\n                <input \n                  type=\"text\"\n                  required\n                  className=\"w-full px-5 py-4 rounded-xl border border-white/5 bg-slate-950/80 text-white placeholder-slate-700 focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 transition-all outline-none font-mono text-sm shadow-inner\"\n                  placeholder=\"MARQETA_APP_TOKEN\"\n                  value={marqetaData.applicationToken}\n                  onChange={(e) => setMarqetaData(p => ({ ...p, applicationToken: e.target.value }))}\n                />\n              </div>\n\n              <div className=\"space-y-3\">\n                <label className=\"text-[10px] font-black text-slate-500 uppercase tracking-widest flex items-center gap-2 px-1\">\n                  Admin Access Token\n                </label>\n                <div className=\"relative group\">\n                  <input \n                    type={showMarqetaSecret ? \"text\" : \"password\"}\n                    required\n                    className=\"w-full px-5 py-4 rounded-xl border border-white/5 bg-slate-950/80 text-white placeholder-slate-700 focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 transition-all outline-none font-mono text-sm shadow-inner\"\n                    placeholder=\"••••••••••••••••\"\n                    value={marqetaData.adminAccessToken}\n                    onChange={(e) => setMarqetaData(p => ({ ...p, adminAccessToken: e.target.value }))}\n                  />\n                  <button \n                    type=\"button\"\n                    onClick={() => setShowMarqetaSecret(!showMarqetaSecret)}\n                    className=\"absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 hover:text-white p-2\"\n                  >\n                    {showMarqetaSecret ? <EyeOff size={18} /> : <Eye size={18} />}\n                  </button>\n                </div>\n              </div>\n            </div>\n          </section>\n\n          <button \n            type=\"submit\"\n            className=\"w-full bg-gradient-to-r from-blue-600 to-emerald-600 hover:from-blue-500 hover:to-emerald-500 text-white font-black py-5 rounded-2xl shadow-[0_15px_40px_rgba(37,99,235,0.2)] transition-all hover:-translate-y-1 active:translate-y-0.5 uppercase tracking-[0.3em] text-xs flex items-center justify-center gap-4 group\"\n          >\n            Initialize Integrated Protocol\n            <ChevronRight size={18} className=\"group-hover:translate-x-1 transition-transform\" />\n          </button>\n        </form>\n      </div>\n    </div>\n  );\n};\n"
