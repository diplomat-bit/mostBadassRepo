e italic tracking-tighter uppercase\">{prod.name}</h5>\n                       <div className=\"grid grid-cols-2 gap-6 pt-2\">\n                          <div>\n                             <span className=\"text-[8px] font-black text-slate-600 uppercase block mb-1\">Created_At</span>\n                             <p className=\"text-[10px] font-mono text-slate-300\">{new Date(prod.created_time).toLocaleDateString()}</p>\n                          </div>\n                          <div>\n                             <span className=\"text-[8px] font-black text-slate-600 uppercase block mb-1\">Auth_Model</span>\n                             <p className=\"text-[10px] font-mono text-slate-300\">JIT_FUNDING_ENABLED</p>\n                          </div>\n                       </div>\n                    </div>\n\n                    <button className=\"bg-emerald-600 hover:bg-emerald-500 text-white font-black px-8 py-4 rounded-xl text-[10px] uppercase tracking-widest transition-all shadow-lg self-end md:self-center\">\n                       Launch Product\n                    </button>\n                  </div>\n                ))}\n             </div>\n          </section>\n        </div>\n\n        {/* Global Sidebar */}\n        <aside className=\"space-y-10\">\n          <div className=\"bg-slate-950/80 p-8 rounded-[2.5rem] border border-white/5 space-y-8 shadow-2xl backdrop-blur-xl\">\n            <h4 className=\"text-[10px] font-black uppercase tracking-[0.4em] text-slate-500 flex items-center gap-3\">\n              <Activity size={16} className=\"text-blue-500\" /> Integrated Health\n            </h4>\n            \n            <div className=\"space-y-4\">\n               {[\n                 { node: 'PLAID_CORE', status: 'ONLINE', latency: '42ms' },\n                 { node: 'MARQETA_SANDBOX', status: 'CONNECTED', latency: '128ms' },\n                 { node: 'PROXY_TUNNEL', status: 'STABLE', latency: '12ms' }\n               ].map((n, idx) => (\n           