              "replacement": "\nimport React, { useState, useEffect } from 'react';\nimport { \n  PlaidCredentials, \n  Account, \n  Transaction,\n  MarqetaCredentials,\n  MarqetaCardProduct\n} from '../types';\nimport { \n  CreditCard, Wallet, Search, \n  ExternalLink, ChevronRight, Database, Landmark,\n  RefreshCcw, AlertCircle, Info,\n  ArrowUpRight, ArrowDownLeft, ShieldCheck, Zap,\n  Activity, Settings, Box\n} from 'lucide-react';\n\ninterface Props {\n  accessToken: string;\n  credentials: PlaidCredentials;\n  marqetaCreds: MarqetaCredentials;\n  proxy: string;\n  addLog: (msg: any, type?: 'req' | 'res' | 'err') => void;\n}\n\nexport const Dashboard: React.FC<Props> = ({ accessToken, credentials, marqetaCreds, proxy, addLog }) => {\n  const [accounts, setAccounts] = useState<Account[]>([]);\n  const [transactions, setTransactions] = useState<Transaction[]>([]);\n  const [cardProducts, setCardProducts] = useState<MarqetaCardProduct[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [marqetaLoading, setMarqetaLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n\n  const fetchPlaidData = async () => {\n    try {\n      const baseUrl = `https://${credentials.environment}.plaid.com`;\n      const fetchWithProxy = async (endpoint: string) => {\n        const targetUrl = `${baseUrl}${endpoint}`;\n        const finalUrl = proxy ? `${proxy}${encodeURIComponent(targetUrl)}` : targetUrl;\n        \n        addLog(`POST ${endpoint} [PLAID]`, 'req');\n        const response = await fetch(finalUrl, {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({\n            client_id: credentials.clientId,\n            secret: credentials.secret,\n            access_token: accessToken\n          })\n        });\n        const data = await response.json();\n        if (!response.ok) throw new Error(data.error_message || `API Error: ${response.status}`);\n        addLog(data, 'res');\n        return data;\n      };\n\n      const accountData = await fetchWithProxy('/accounts/get');\n      setAccounts(accountData.accounts.map((a: any) => ({\n        id: a.account_id,\n        name: a.name,\n        mask: a.mask,\n        type: a.type,\n        subtype: a.subtype,\n        balance: {\n          available: a.balances.available,\n          current: a.balances.current,\n          limit: a.balances.limit,\n          currency: a.balances.iso_currency_code || 'USD'\n        }\n      })));\n      \n      const txData = await fetchWithProxy('/transactions/sync');\n      if (txData.added) {\n        setTransactions(txData.added.map((t: any) => ({\n          id: t.transaction_id,\n          date: t.date,\n          name: t.name,\n          amount: t.amount,\n          category: t.category,\n          pending: t.pending\n        })));\n      }\n    } catch (err: any) {\n      setError(err.message);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const fetchMarqetaData = async () => {\n    setMarqetaLoading(true);\n    try {\n      const targetUrl = 'https://sandbox-api.marqeta.com/v3/cardproducts?sort_by=-lastModifiedTime';\n      const finalUrl = proxy ? `${proxy}${encodeURIComponent(targetUrl)}` : targetUrl;\n      \n      addLog(`GET /v3/cardproducts [MARQETA]`, 'req');\n      \n      // Basic Auth using provided Application Token and Admin Access Token\n      const auth = btoa(`${marqetaCreds.applicationToken}:${marqetaCreds.adminAccessToken}`);\n      \n      const response = await fetch(finalUrl, {\n        method: 'GET',\n        headers: { \n          'Content-Type': 'application/json',\n          'Authorization': `Basic ${auth}`\n        }\n      });\n      \n      const data = await response.json();\n      if (!response.ok) throw new Error(data.error_message || `Marqeta Error: ${response.status}`);\n      \n      addLog(data, 'res');\n      setCardProducts(data.data || []);\n    } catch (err: any) {\n      addLog(err.message, 'err');\n    } finally {\n      setMarqetaLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchPlaidData();\n    fetchMarqetaData();\n  }, [accessToken, proxy]);\n\n  const totalBalance = accounts.reduce((acc, curr) => \n    curr.type === 'depository' ? acc + curr.balance.current : acc - curr.balance.current, 0\n  );\n\n  if (loading) {\n    return (\n      <div className=\"flex flex-col items-center justify-center min-h-[500px] space-y-10 animate-pulse\">\n        <div className=\"w-24 h-24 border-[6px] border-blue-500/10 border-t-blue-500 rounded-full animate-spin\"></div>\n        <p className=\"text-white text-lg font-black uppercase tracking-[0.3em] italic\">Syncing Integrated Node...</p>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"space-y-12 pb-20 animate-in fade-in slide-in-from-bottom-8 duration-1000\">\n      \n      {/* Integrated Financial Overview */}\n      <section className=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n        {[\n          { label: 'Combined Liquidity', val: `$${totalBalance.toLocaleString()}`, icon: Wallet, color: 'text-blue-500' },\n          { label: 'Active Card Products', val: cardProducts.length.toString(), icon: CreditCard, color: 'text-emerald-500' },\n          { label: 'Node Status', val: 'CONNECTED', icon: ShieldCheck, color: 'text-purple-500' }\n        ].map((stat, i) => (\n          <div key={i} className=\"bg-slate-900/40 p-8 rounded-[2rem] border border-white/5 shadow-xl hover:border-white/10 transition-all backdrop-blur-sm\">\n            <div className=\"flex items-center justify-between mb-4\">\n              <span className=\"text-[10px] font-black uppercase tracking-[0.3em] text-slate-500\">{stat.label}</span>\n              <stat.icon className={`${stat.color} opacity-60`} size={20} />\n            </div>\n            <h4 className=\"text-3xl font-black text-white italic tracking-tighter\">{stat.val}</h4>\n          </div>\n        ))}\n      </section>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-12\">\n        <div className=\"lg:col-span-2 space-y-12\">\n          \n          {/* Plaid Accounts section */}\n          <section className=\"space-y-6\">\n            <h3 className=\"text-xs font-black text-slate-400 uppercase tracking-[0.3em] flex items-center gap-3\">\n              <div className=\"w-1.5 h-6 bg-blue-500 rounded-full\" />\n              Banking Infrastructure (Plaid)\n            </h3>\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n              {accounts.map(acc => (\n                <div key={acc.id} className=\"bg-slate-900/60 p-7 rounded-[2rem] border border-white/5 hover:border-blue-500/40 transition-all relative overflow-hidden group\">\n                  <Landmark className=\"absolute -right-4 -bottom-4 text-white/5 group-hover:text-blue-500/10 transition-colors\" size={100} />\n                  <div className=\"flex justify-between items-start mb-4 relative z-10\">\n                    <div className=\"w-10 h-10 rounded-xl bg-slate-950 flex items-center justify-center text-blue-400 border border-white/5\">\n                      <Landmark size={20} />\n                    </div>\n                    <span className=\"text-xs font-mono text-white font-black bg-slate-950 px-2 py-1 rounded-lg\">*{acc.mask}</span>\n                  </div>\n                  <div className=\"relative z-10\">\n                    <p className=\"text-sm font-black text-white leading-tight mb-0.5\">{acc.name}</p>\n                    <p className=\"text-[10px] text-slate-500 uppercase font-black tracking-widest mb-6\">{acc.subtype}</p>\n                    <p className=\"text-2xl font-black text-white italic tracking-tighter\">${acc.balance.current.toLocaleString()}</p>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </section>\n\n          {/* Marqeta Card Products section */}\n          <section className=\"space-y-6\">\n             <div clas