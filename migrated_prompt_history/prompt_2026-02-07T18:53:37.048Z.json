        {
          "path": "components/Dashboard.tsx",
          "generationType": 1,
          "isDone": true,
          "description": "Remove all Gemini API usage and AI-generated insights from the dashboard.",
          "diffs": [
            {
              "target": "",
              "replacement": "\nimport React, { useState, useEffect } from 'react';\nimport { \n  PlaidCredentials, \n  Account, \n  Transaction \n} from '../types';\nimport { \n  CreditCard, Wallet, Search, \n  ExternalLink, ChevronRight, Database, Landmark,\n  RefreshCcw, AlertCircle, Info,\n  ArrowUpRight, ArrowDownLeft, ShieldCheck, Zap\n} from 'lucide-react';\n\ninterface Props {\n  accessToken: string;\n  credentials: PlaidCredentials;\n  proxy: string;\n}\n\nexport const Dashboard: React.FC<Props> = ({ accessToken, credentials, proxy }) => {\n  const [accounts, setAccounts] = useState<Account[]>([]);\n  const [transactions, setTransactions] = useState<Transaction[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n\n  const fetchLiveData = async () => {\n    setLoading(true);\n    setError(null);\n    try {\n      const baseUrl = `https://${credentials.environment}.plaid.com`;\n      \n      const fetchWithProxy = async (endpoint: string) => {\n        const targetUrl = `${baseUrl}${endpoint}`;\n        const finalUrl = proxy ? `${proxy}${encodeURIComponent(targetUrl)}` : targetUrl;\n        \n        const response = await fetch(finalUrl, {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({\n            client_id: credentials.clientId,\n            secret: credentials.secret,\n            access_token: accessToken\n          })\n        });\n        \n        const data = await response.json();\n        if (!response.ok) throw new Error(data.error_message || `API Error: ${response.status}`);\n        return data;\n      };\n\n      const accountData = await fetchWithProxy('/accounts/get');\n      const mappedAccounts: Account[] = accountData.accounts.map((a: any) => ({\n        id: a.account_id,\n        name: a.name,\n        mask: a.mask,\n        type: a.type,\n        subtype: a.subtype,\n        balance: {\n          available: a.balances.available,\n          current: a.balances.current,\n          limit: a.balances.limit,\n          currency: a.balances.iso_currency_code || 'USD'\n        }\n      }));\n      setAccounts(mappedAccounts);\n      \n      const txData = await fetchWithProxy('/transactions/sync');\n      if (txData.added) {\n        setTransactions(txData.added.map((t: any) => ({\n          id: t.transaction_id,\n          date: t.date,\n          name: t.name,\n          amount: t.amount,\n          category: t.category,\n          pending: t.pending\n        })));\n      }\n    } catch (err: any) {\n      setError(err.message.includes('fetch') ? 'CORS Protocol Failure: Endpoint rejected client-side request. Verify your Proxy Tunnel.' : err.message);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchLiveData();\n  }, [accessToken, proxy]);\n\n  const totalBalance = accounts.reduce((acc, curr) => \n    curr.type === 'depository' ? acc + curr.balance.current : acc - curr.balance.current, 0\n  );\n\n  if (loading) {\n    return (\n      <div className=\"flex flex-col items-center justify-center min-h-[500px] space-y-10 animate-pulse\">\n        <div className=\"relative\">\n          <div className=\"absolute inset-0 bg-blue-500 blur-3xl opacity-20\" />\n          <div className=\"w-24 h-24 border-[6px] border-blue-500/10 border-t-blue-500 rounded-full animate-spin shadow-2xl relative z-10\"></div>\n        </div>\n        <div className=\"text-center space-y-2\">\n          <p className=\"text-white text-lg font-black uppercase tracking-[0.3em] italic\">Synchronizing Node</p>\n          <p className=\"text-slate-500 text-xs font-mono\">Fetching institutional ledger from Plaid Cloud...</p>\n        </div>\n      </div>\n    );\n  }\n\n  if (error) {\n    return (\n      <div className=\"bg-red-950/20 border border-red-500/20 p-20 rounded-[3rem] text-center space-y-10 backdrop-blur-xl animate-in zoom-in-95\">\n        <div className=\"w-24 h-24 bg-red-500/10 rounded-[2rem] flex items-center justify-center mx-auto text-red-500 border border-red-500/20\">\n          <AlertCircle size={56} />\n        </div>\n        <div className=\"space-y-4\">\n          <h3 className=\"text-3xl font-black text-white italic uppercase tracking-tighter\">Sync Interrupted</h3>\n          <p className=\"text-slate-400 max-w-md mx-auto text-base leading-relaxed\">{error}</p>\n        </div>\n        <button \n          onClick={fetchLiveData} \n          className=\"bg-red-600 hover:bg-red-500 text-white font-black px-12 py-5 rounded-2xl transition-all shadow-xl uppercase tracking-widest text-sm\"\n        >\n          Re-initialize Stream\n        </button>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"space-y-10 pb-20 animate-in fade-in slide-in-from-bottom-8 duration-1000\">\n      {/* Hero Stats */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n        {[\n          { label: 'Net Liquidity', val: `$${totalBalance.toLocaleString()}`, icon: Wallet, color: 'text-blue-500' },\n          { label: 'Total Liabilities', val: `$${accounts.filter(a => a.type === 'credit').reduce((s, a) => s + a.balance.current, 0).toLocaleString()}`, icon: CreditCard, color: 'text-rose-500' },\n          { label: 'Active Streams', val: 'Verified', icon: ShieldCheck, color: 'text-emerald-500' }\n        ].map((stat, i) => (\n          <div key={i} className=\"bg-slate-900/40 p-8 rounded-[2rem] border border-white/5 shadow-xl group hover:border-white/10 transition-all backdrop-blur-sm\">\n            <div className=\"flex items-center justify-between mb-6\">\n              <span className=\"text-[10px] font-black uppercase tracking-[0.3em] text-slate-500\">{stat.label}</span>\n              <stat.icon className={`${stat.color} opacity-60 group-hover:opacity-100 transition-opacity`} size={20} />\n            </div>\n            <div className=\"flex items-end justify-between\">\n              <h4 className=\"text-3xl font-black text-white italic tracking-tighter\">{stat.val}</h4>\n              <div className=\"text-[10px] font-mono text-emerald-500 flex items-center gap-1 font-bold\">\n                {stat.label === 'Active Streams' ? <Zap size={10} className=\"fill-current\"/> : <ArrowUpRight size={14}/>}\n                {stat.label === 'Active Streams' ? 'LIVE' : '+0.04%'}\n              </div>\n            </div>\n          </div>\n        ))}\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-12\">\n        <div className=\"lg:col-span-2 space-y-10\">\n          <div className=\"flex items-center justify-between px-2\">\n            <h3 className=\"text-xs font-black text-slate-400 uppercase tracking-[0.3em] flex items-center gap-3\">\n              <div className=\"w-1.5 h-6 bg-blue-500 rounded-full\" />\n              Institutional Accounts\n            </h3>\n            <span className=\"text-[10px] font-mono text-slate-600 uppercase tracking-widest\">{accounts.length} Total Nodes</span>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n            {accounts.map(acc => (\n              <div key={acc.id} className=\"bg-slate-900/60 p-7 rounded-[2.5rem] border border-white/5 hover:border-blue-500/40 transition-all group relative overflow-hidden\">\n                <div className=\"absolute top-0 right-0 p-4 opacity-5 group-hover:opacity-20 transition-opacity\">\n                   <Landmark size={80} />\n                </div>\n                <div className=\"flex justify-between items-start mb-6\">\n                  <div className=\"w-12 h-12 rounded-2xl bg-slate-950 flex items-center justify-center text-blue-400 group-hover:bg-blue-600 group-hover:text-white transition-all shadow-inner\">\n                    <Landmark size={22} />\n                  </div>\n                  <div className=\"text-right\">\n                    <span className=\"text-[10px] font-mono text-slate-600 uppercase block font-bold tracking-widest\">Ending In</span>\n                    <span className=\"text-xs font-mono text-white font-black\">{acc.mask}</span>\n                  </div>\n                </div>\n                <div>\n                  <p className=\"text-base font-black text-white leading-tight mb-1\">{acc.name}</p>\n                  <p className=\"text-[10px] text-slate-500 uppercase font-black tracking-[0.2em] mb-6\">{acc.subtype} • {acc.type}</p>\n                  <div className=\"flex items-end justify-between\">\n                    <div>\n                      <span className=\"text-[9px] font-black text-slate-600 uppercase block mb-1\">Balance_Current</span>\n                      <p className=\"text-2xl font-black text-white italic tracking-tighter\">${acc.balance.current.toLocaleString()}</p>\n                    </div>\n                    {acc.balance.available !== null && (\n                      <div className=\"text-right\">\n                        <span className=\"text-[9px] font-black text-slate-600 uppercase block mb-1\">Liquidity</span>\n                        <p className=\"text-xs font-bold text-emerald-400\">${acc.balance.available.toLocaleString()}</p>\n                      </div>\n                    )}\n                  </div>\n                </div>\n              </div>\n            ))}\n          </div>\n\n          <div className=\"space-y-6 pt-4\">\n            <div className=\"flex items-center justify-between px-2\">\n              <h3 className=\"text-xs font-black text-slate-400 uppercase tracking-[0.3em] flex items-center gap-3\">\n                <div className=\"w-1.5 h-6 bg-blue-500 rounded-full\" />\n                Transaction Ledger\n              </h3>\n              <button className=\"text-[10px] font-black text-blue-500 hover:text-blue-400 uppercase tracking-widest flex items-center gap-2\">\n                Export CSV <ExternalLink size={12}/>\n              </button>\n            </div>\n            \n            <div className=\"bg-slate-950/60 rounded-[2.5rem] border border-white/5 overflow-hidden backdrop-blur-md\">\n              <div className=\"overflow-x-auto\">\n                <table className=\"w-full text-left border-collapse\">\n                  <thead>\n                    <tr className=\"border-b border-white/5 bg-white/5\">\n                      <th className=\"px-8 py-5 text-[10px] font-black uppercase tracking-[0.2em] text-slate-500\">Beneficiary / Origin</th>\n                      <th className=\"px-8 py-5 text-[10px] font-black uppercase tracking-[0.2em] text-slate-500 text-right\">Settlement</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-white/5\">\n                    {transactions.map(tx => (\n                      <tr key={tx.id} className=\"hover:bg-white/5 transition-colors group\">\n                        <td className=\"px-8 py-5\">\n                          <div className=\"flex items-center gap-4\">\n                            <div className={`w-10 h-10 rounded-xl flex items-center justify-center shrink-0 border border-white/5 ${tx.amount > 0 ? 'bg-slate-900 text-slate-400' : 'bg-emerald-500/10 text-emerald-500 border-emerald-500/20'}`}>\n                               {tx.amount > 0 ? <ArrowUpRight size={18}/> : <ArrowDownLeft size={18}/>}\n                            </div>\n                            <div>\n                              <p className=\"text-sm font-black text-white group-hover:text-blue-400 transition-colors truncate max-w-[240px]\">{tx.name}</p>\n                              <div className=\"flex items-center gap-3 mt-1\">\n                                <span className=\"text-[10px] font-mono text-slate-600 font-bold\">{tx.date}</span>\n                                <span className=\"w-1 h-1 rounded-full bg-slate-800\" />\n                                <span className=\"text-[9px] font-black text-slate-700 uppercase tracking-widest truncate max-w-[100px]\">{tx.category[0] || 'Uncategorized'}</span>\n                              </div>\n                            </div>\n                          </div>\n                        </td>\n                        <td className=\"px-8 py-5 text-right\">\n                          <span className={`text-sm font-black italic tracking-tight ${tx.amount > 0 ? 'text-white' : 'text-emerald-400'}`}>\n                            {tx.amount > 0 ? `-$${tx.amount.toFixed(2)}` : `+$${Math.abs(tx.amount).toFixed(2)}`}\n                          </span>\n                        </td>\n                      </tr>\n                    ))}\n                    {transactions.length === 0 && (\n                      <tr>\n                        <td colSpan={2} className=\"px-8 py-20 text-center\">\n                          <div className=\"flex flex-col items-center gap-4 opacity-30\">\n                            <Search size={40} />\n                            <p className=\"text-xs font-black uppercase tracking-[0.3em]\">No Historical Data Found</p>\n                          </div>\n                        </td>\n                      </tr>\n                    )}\n                  </tbody>\n                </table>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Info & Metadata Panel */}\n        <aside className=\"space-y-10\">\n          <div className=\"bg-slate-950/80 p-8 rounded-[2.5rem] border border-white/5 space-y-8 shadow-2xl backdrop-blur-xl\">\n            <h4 className=\"text-[10px] font-black uppercase tracking-[0.4em] text-slate-500 flex items-center gap-3\">\n              <Database size={16} className=\"text-blue-500\" /> Node Session\n            </h4>\n            \n            <div className=\"space-y-6\">\n              <div className=\"p-6 bg-slate-900/60 rounded-2xl border border-white/5 space-y-3 group hover:border-blue-500/30 transition-all\">\n                <span className=\"text-[9px] font-black text-blue-500 uppercase tracking-widest block\">Primary_Access_Token</span>\n                <div className=\"font-mono text-[10px] text-slate-400 break-all leading-relaxed p-4 bg-black/40 rounded-xl border border-white/5 shadow-inner select-all cursor-copy\">\n                  {accessToken}\n                </div>\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-4\">\n                <div className=\"p-5 bg-slate-900/40 rounded-2xl border border-white/5\">\n                   <span className=\"text-[8px] font-black text-slate-600 uppercase block mb-1\">Environment</span>\n                   <span className=\"text-[10px] font-bold text-white uppercase\">{credentials.environment}</span>\n                </div>\n                <div className=\"p-5 bg-slate-900/40 rounded-2xl border border-white/5\">\n                   <span className=\"text-[8px] font-black text-slate-600 uppercase block mb-1\">API_Version</span>\n                   <span className=\"text-[10px] font-bold text-white uppercase\">2020-09-14</span>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"flex items-start gap-4 p-5 bg-blue-500/5 border border-blue-500/10 rounded-2xl\">\n              <Info size={20} className=\"text-blue-500 shrink-0 mt-0.5\" />\n              <div className=\"space-y-1\">\n                <p className=\"text-[10px] text-slate-400 font-bold uppercase tracking-widest leading-none\">Security_Protocol</p>\n                <p className=\"text-[10px] text-slate-500 leading-relaxed font-medium italic\">\n                  Data is streamed directly via the proxy tunnel. Credentials are never persisted to external storage.\n                </p>\n              </div>\n            </div>\n\n            <button \n              onClick={() => window.location.reload()}\n              className=\"w-full flex items-center justify-center gap-3 py-4 rounded-xl border border-white/10 text-slate-400 hover:text-white hover:bg-white/5 transition-all text-[10px] font-black uppercase tracking-widest\"\n            >\n              <RefreshCcw size={14} />\n              Terminate Session\n            </button>\n          </div>\n\n          {/* Quick Actions Card */}\n          <div className=\"bg-gradient-to-br from-slate-900 to-slate-950 p-8 rounded-[2.5rem] border border-white/5 shadow-xl space-y-6\">\n            <h4 className=\"text-[10px] font-black uppercase tracking-[0.4em] text-slate-500\">Global Actions</h4>\n            <div className=\"space-y-3\">\n              <button className=\"w-full flex items-center justify-between p-4 bg-white/5 rounded-xl border border-white/5 hover:bg-white/10 transition-all group\">\n                <span className=\"text-[11px] font-bold text-slate-300 group-hover:text-white\">Audit Security Logs</span>\n                <ChevronRight size={14} className=\"text-slate-600 group-hover:translate-x-1 transition-transform\" />\n              </button>\n              <button className=\"w-full flex items-center justify-between p-4 bg-white/5 rounded-xl border border-white/5 hover:bg-white/10 transition-all group\">\n                <span className=\"text-[11px] font-bold text-slate-300 group-hover:text-white\">Reset Token Map</span>\n                <ChevronRight size={14} className=\"text-slate-600 group-hover:translate-x-1 transition-transform\" />\n              </button>\n            </div>\n          </div>\n        </aside>\n      </div>\n    </div>\n  );\n};\n"
            }
