              "replacement": "\n{\n  \"name\": \"Plaid Nexus - Fintech Dashboard\",\n  \"description\": \"Professional-grade terminal for Plaid (PolkaID) integration. Securely manage link tokens, exchange public tokens, and visualize real-time bank data.\",\n  \"requestFramePermissions\": []\n}\n"
