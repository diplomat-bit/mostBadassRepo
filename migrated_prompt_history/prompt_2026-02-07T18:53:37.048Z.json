n className=\"h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse\" />\n                  <p className=\"text-[10px] font-bold text-blue-400 uppercase tracking-[0.3em]\">System.Ready_For_Initialization</p>\n                </div>\n              </div>\n            </div>\n            <p className=\"text-slate-400 text-base leading-relaxed max-w-xl\">\n              Establish a secure bridge to the Plaid (PolkaID) network. Your credentials are used exclusively for local browser-to-API communication.\n            </p>\n          </div>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"p-12 space-y-10 bg-slate-900/20\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-10\">\n            <div className=\"space-y-4\">\n              <label className=\"text-[11px] font-black text-slate-500 uppercase tracking-widest flex items-center gap-2 px-1\">\n                <Key size={14} className=\"text-blue-500\" /> Client Identifier\n              </label>\n              <div className=\"relative group\">\n                <input \n                  type=\"text\"\n                  required\n                  autoComplete=\"off\"\n                  className=\"w-full px-6 py-5 rounded-2xl border border-white/5 bg-slate-950/80 text-white placeholder-slate-700 focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-all outline-none font-mono text-sm shadow-inner group-hover:border-white/10\"\n                  placeholder=\"Enter your Plaid Client ID\"\n                  value={formData.clientId}\n                  onChange={(e) => setFormData(p => ({ ...p, clientId: e.target.value }))}\n                />\n              </div>\n            </div>\n\n            <div className=\"space-y-4\">\n              <label className=\"text-[11px] font-black text-slate-500 uppercase tracking-widest flex items-center gap-2 px-1\">\n                <Lock size={14} className=\"text-blue-500\" /> Private Secret Key\n              </label>\n              <div className=\"relative group\">\n                <input \n                  type={showSecret ? \"text\" : \"password\"}\n                  required\n                  className=\"w-full px-6 py-5 rounded-2xl border border-white/5 bg-slate-950/80 text-white placeholder-slate-700 focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-all outline-none font-mono text-sm shadow-inner group-hover:border-white/10\"\n                  placeholder=\"••••••••••••••••••••••••\"\n                  value={formData.secret}\n                  onChange={(e) => setFormData(p => ({ ...p, secret: e.target.value }))}\n                />\n                <button \n                  type=\"button\"\n                  onClick={() => setShowSecret(!showSecret)}\n                  className=\"absolute right-6 top-1/2 -translate-y-1/2 text-slate-500 hover:text-white transition-colors p-2\"\n                >\n                  {showSecret ? <EyeOff size={20} /> : <Eye size={20} />}\n                </button>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"space-y-5\">\n            <div className=\"flex items-center justify-between px-1\">\n              <label className=\"text-[11px] font-black text-slate-500 uppercase tracking-widest flex items-center gap-2\">\n                <Server size={14} className=\"text-blue-500\" /> Deployment Node\n              </label>\n              <span className=\"text-[10px] font-mono text-blue-500/50 uppercase tracking-tighter\">API V2020-09-14</span>\n            </div>\n            <div className=\"grid grid-cols-3 gap-5\">\n              {(['sandbox', 'development', 'production'] as const).map((env) => (\n                <button\n                  key={env}\n                  type=\"button\"\n                  onClick={() => setFormData(p => ({ ...p, environment: env }))}\n                  className={`relative px-4 py-5 rounded-2xl border-2 text-[11px] font-black uppercase tracking-widest transition-all duration-300 overflow-hidden group\n                    ${formData.environment === env \n                      ? 'border-blue-600 bg-blue-600/10 text-white shadow-[0_10px_30px_rgba(37,99,235,0.2)]' \n                      : 'border-white/5 bg-white/5 text-slate-500 hover:border-white/10 hover:text-slate-300'}`}\n                >\n                  {formData.environment === env && (\n                    <div className=\"absolute top-0 right-0 p-1\">\n                      <div className=\"w-1.5 h-1.5 rounded-full bg-blue-400\" />\n                    </div>\n                  )}\n                  <span className=\"relative z-10\">{env}</span>\n                </button>\n              ))}\n            </div>\n          </div>\n\n          <div className=\"flex items-start gap-5 p-6 bg-blue-500/5 rounded-3xl border border-blue-500/10 transition-colors hover:bg-blue-500/10\">\n            <div className=\"w-10 h-10 rounded-xl bg-blue-500/10 flex items-center justify-center text-blue-500 shrink-0\">\n              <Info size={22} />\n            </div>\n            <div className=\"space-y-1\">\n              <p className=\"text-xs text-slate-300 leading-relaxed font-bold italic\">\n                Environment Note:\n              </p>\n              <p className=\"text-xs text-slate-500 leading-relaxed\">\n                Use <span className=\"text-blue-400 font-black\">Sandbox</span> for development. It accepts any credentials and allows simulation of various banking scenarios using \"user_good\" / \"pass_good\".\n              </p>\n            </div>\n          </div>\n\n          <button \n            type=\"submit\"\n            className=\"w-full bg-blue-600 hover:bg-blue-500 text-white font-black py-6 rounded-[1.5rem] shadow-[0_15px_40px_rgba(37,99,235,0.3)] transition-all hover:-translate-y-1 active:translate-y-0.5 uppercase tracking-[0.3em] text-sm flex items-center justify-center gap-4 group\"\n          >\n            <Cpu size={20} className=\"group-hover:rotate-12 transition-transform\" />\n            Initialize Handshake\n            <ChevronRight size={20} className=\"group-hover:translate-x-1 transition-transform\" />\n          </button>\n        </form>\n      </div>\n      \n      <div className=\"mt-8 flex items-center justify-center gap-8 text-[10px] font-black text-slate-700 uppercase tracking-widest\">\n        <div className=\"flex items-center gap-2\"><Lock size={12}/> AES-256 Memory Encryption</div>\n        <div className=\"w-1 h-1 rounded-full bg-slate-800\" />\n        <div className=\"flex items-center gap-2\"><Server size={12}/> Direct API Routing</div>\n        <div className=\"w-1 h-1 rounded-full bg-slate-800\" />\n        <div className=\"flex items-center gap-2\"><Shield size={12}/> Zero Persistency</div>\n      </div>\n    </div>\n  );\n};\n"
