|| '');\n    const [sKey, setSKey] = useState(stripeSecretKey || '');\n    const [gKey, setGKey] = useState(geminiApiKey || '');\n    const [reownId, setReownId] = useState(reownProjectId || '');\n\n    const handleSave = () => {\n        if (modal === 'mt') { setModernTreasuryApiKey(mtKey); setModernTreasuryOrganizationId(mtOrg); }\n        if (modal === 'plaid') { setPlaidClientId(pId); setPlaidSecret(pSec); }\n        if (modal === 'stripe') { setStripeSecretKey(sKey); }\n        if (modal === 'gemini') { setGeminiApiKey(gKey); }\n        if (modal === 'reown') { setReownProjectId(reownId); window.location.reload(); }\n        setModal(null);\n    };\n\n    const StatusIndicator: React.FC<{ status: APIStatus['status'] }> = ({ status }) => {\n        const statusMap = {\n            'Operational': 'bg-green-500/20 text-green-300 dot:bg-green-400',\n            'Degraded Performance': 'bg-yellow-500/20 text-yellow-300 dot:bg-yellow-400',\n            'Partial Outage': 'bg-orange-500/20 text-orange-300 dot:bg-orange-400',\n            'Major Outage': 'bg-red-500/20 text-red-300 dot:bg-red-400'\n        };\n        const style = statusMap[status] || statusMap['Operational'];\n        const dotColor = style.split('dot:')[1];\n        \n        return (\n            <div className={`flex items-center gap-2 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest ${style.split(' dot:')[0]}`}>\n                <div className={`w-1.5 h-1.5 rounded-full ${dotColor}`}></div>\n                {status}\n            </div>\n        );\n    };\n\n    return (\n        <div className=\"space-y-8 pb-20\">\n            <header>\n                <h2 className=\"text-5xl font-black text-white tracking-tighter uppercase italic drop-shadow-2xl\">Developer Portal</h2>\n                <p className=\"text-gray-500 font-bold tracking-widest mt-2 uppercase text-xs\">Infrastructure Registry & Secure Anchoring</p>\n            </header>\n\n            <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-8\">\n                <Card title=\"Infrastructure Registry\">\n                    <div className=\"space-y-4\">\n                        {apiStatus.map(api => (\n                            <div key={api.provider} className=\"flex flex-col sm:flex-row justify-between items-center p-5 bg-gray-900 border border-gray-800 rounded-3xl group hover:border-cyan-500/50 transition-all shadow-xl\">\n                                <div className=\"flex flex-col gap-1\">\n                                    <div className=\"flex items-center gap-5\">\n                                        <h4 className=\"font-black text-white text-lg italic tracking-tight uppercase\">{api.provider}</h4>\n                                        <StatusIndicator status={api.status} />\n                                    </div>\n                                    <p className=\"text-[9px] text-gray-600 font-mono tracking-widest uppercase\">\n                                        {/* FIX: Comparison with 'Reown' is now valid as types overlap after updating APIProvider in types.ts. */}\n                                        {api.provider === 'Plaid' && (plaidClientId ? 'Authorized' : 'Requires Config')}\n                                        {api.provider === 'Modern Treasury' && (modernTreasuryApiKey ? 'Authorized' : 'Requires Config')}\n                                        {api.provider === 'Stripe' && (stripeSecretKey ? 'Authorized' : 'Requires Config')}\n                                        {api.provider === 'Google Gemini' && (geminiApiKey ? 'Authorized' : 'Requires Config')}\n                                        {api.provider === 'Reown' && (reownProjectId ? 'Authorized' : 'Requires Config')}\n                                    </p>\n                                </div>\n                                <div className=\"flex items-center gap-8\">\n                                    <p className=\"text-[10px] text-gray-500 font-mono tracking-