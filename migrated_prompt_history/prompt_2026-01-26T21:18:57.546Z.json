 -20%; right: -20%;\n                    animation-delay: -10s;\n                }\n                @keyframes aurora-flow {\n                    0% { transform: translate(0, 0) rotate(0deg); }\n                    50% { transform: translate(100px, 100px) rotate(180deg); }\n                    100% { transform: translate(0, 0) rotate(360deg); }\n                }\n            `}</style>}</div>\n    );\n};\n\nexport default App;"
