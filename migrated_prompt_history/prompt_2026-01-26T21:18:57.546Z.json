pe=\"password\" value={pSec} onChange={e => setPSec(e.target.value)} placeholder=\"Secret Key\" className=\"w-full bg-black border border-gray-800 rounded-2xl px-6 py-4 text-white focus:ring-2 focus:ring-cyan-500 outline-none\" />\n                                    </div>\n                                </div>\n                            )}\n                            {modal === 'stripe' && (\n                                <div className=\"space-y-2\">\n                                    <label className=\"text-[9px] font-black uppercase text-gray-500 tracking-[0.2em] ml-2\">Stripe Secret Key</label>\n                                    <input type=\"password\" value={sKey} onChange={e => setSKey(e.target.value)} placeholder=\"sk_test_...\" className=\"w-full bg-black border border-gray-800 rounded-2xl px-6 py-4 text-white focus:ring-2 focus:ring-cyan-500 outline-none\" />\n                                </div>\n                            )}\n                            {modal === 'gemini' && (\n                                <div className=\"space-y-2\">\n                                    <label className=\"text-[9px] font-black uppercase text-gray-500 tracking-[0.2em] ml-2\">Gemini API Key</label>\n                                    <input type=\"password\" value={gKey} onChange={e => setGKey(e.target.value)} placeholder=\"AIza...\" className=\"w-full bg-black border border-gray-800 rounded-2xl px-6 py-4 text-white focus:ring-2 focus:ring-cyan-500 outline-none\" />\n                                </div>\n                            )}\n                            {modal === 'reown' && (\n                                <div className=\"space-y-2\">\n                                    <label className=\"text-[9px] font-black uppercase text-gray-500 tracking-[0.2em] ml-2\">Project ID</label>\n                                    <input type=\"text\" value={reownId} onChange={e => setReownId(e.target.value)} placeholder=\"Project ID\" className=\"w-ful