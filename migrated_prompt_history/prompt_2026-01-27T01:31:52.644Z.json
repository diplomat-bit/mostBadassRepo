        }\n        ],\n    },\n];\n\nconst AIAdvisorView: React.FC<{ previousView: View | null }> = ({ previousView }) => {\n    const context = useContext(DataContext);\n    const [messages, setMessages] = useState<any[]>([]);\n    const [input, setInput] = useState('');\n    const [isLoading, setIsLoading] = useState(false);\n    const chatRef = useRef<Chat | null>(null);\n\n    useEffect(() => {\n        if (!chatRef.current && context?.reownProjectId) {\n            const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });\n            chatRef.current = ai.chats.create({\n                model: 'gemini-3-pro-preview',\n                config: { systemInstruction: DETAILED_SYSTEM_INSTRUCTION, tools: toolDefinitions }\n            });\n            setMessages([{ role: 'model', parts: [{ text: \"Quantum Synchronized. Master identity verified. How shall we expand your financial reach today?\" }] }]);\n        }\n    }, [context]);\n\n    const handleSend = async () => {\n        if (!input.trim() || !chatRef.current) return;\n        const userMsg = { role: 'user', parts: [{ text: input }] };\n        setMessages(prev => [...prev, userMsg]);\n        setInput('');\n        setIsLoading(true);\n\n        try {\n            const response = await chatRef.current.sendMessage({ message: input });\n            setMessages(prev => [...prev, { role: 'model', parts: [{ text: response.text || \"Synchronizing data stream...\" }] }]);\n            \n            if (response.functionCalls) {\n                for (const call of response.functionCalls) {\n                    if (call.name === 'mintCreativeNFT') {\n                         setMessages(prev => [...prev, { role: 'model', parts: [{ text: `[PROTOCOL INITIATED] Quantum is preparing the forge for '${call.args.assetName}'. Please head to the Web3 Nexus to finalize the anchor.` }] }]);\n                    }\n                }\n            }\n        } catch (e) {\n            setMessages(prev => [...prev, { role: 'model', parts: [{ text: \"Quantum encountered a logic bottleneck. Retrying handshake...\" }] }]);\n        } finally {\n            setIsLoading(false);\n        }\n    };\n\n    return (\n        <div className=\"h-full flex flex-col\">\n            <h2 className=\"text-3xl font-black text-white tracking-widest uppercase italic mb-6\">Quantum <span className=\"text-cyan-400\">Intelligence</span></h2>\n            <Card className=\"flex-1 flex flex-col\" padding=\"none\">\n                <div className=\"flex-1 p-6 space-y-6 overflow-y-auto\">\n                    {messages.map((msg, i) => (\n                        <div key={i} className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}>\n                            <div className={`max-w-xl p-4 rounded-[2rem] font-medium text-sm ${msg.role === 'user' ? 'bg-cyan-600 text-white' : 'bg-gray-800 text-gray-200 border border-gray-700'}`}>\n                                {msg.parts[0].text}\n                            </div>\n                        </div>\n                    ))}\n                    {isLoading && <div className=\"animate-pulse text-cyan-400 text-xs font-black uppercase tracking-widest\">Quantum Thinking...</div>}\n                </div>\n                <div className=\"p-4 bg-gray-900/50 border-t border-gray-800 flex gap-2\">\n                    <input value={input} onChange={e => setInput(e.target.value)} onKeyDown={e => e.key === 'Enter' && handleSend()} placeholder=\"Issue command to Quantum...\" className=\"flex-1 bg-black border border-gray-700 rounded-2xl px-6 py-3 text-white focus:ring-2 focus:ring-cyan-500 outline-none\" />\n                    <button onClick={handleSend} className=\"bg-cyan-600 px-8 rounded-2xl font-black text-white uppercase tracking-widest\">Send</button>\n                </div>\n            </Card>\n        </div>\n    );\n};\n\nexport default AIAdvisorView;\n"
