              "replacement": "\nimport React, { useState, useEffect, useRef, useContext } from 'react';\nimport { View } from '../types';\nimport Card from './Card';\nimport { GoogleGenAI, Chat, Tool, Type } from \"@google/genai\";\nimport { DataContext } from '../context/DataContext';\n\nconst DETAILED_SYSTEM_INSTRUCTION = `You are Quantum, the supreme financial intelligence of Demai. \nSpeak with authority and precision. You can access real-time financial standing via tools. \nIf a user asks about their wealth, use 'getFinancialSummary'. \nIf they mention art or vision, suggest 'mintCreativeNFT'.`;\n\nexport const toolDefinitions: Tool[] = [\n    {\n        functionDeclarations: [\n            {\n                name: \"getFinancialSummary\",\n                description: \"Retrieves the user's real-time financial standing.\",\n                parameters: { type: Type.OBJECT, properties: {}, required: [] },\n            },\n            {\n                name: \"mintCreativeNFT\",\n                description: \"Begins the forge process for a digital asset.\",\n                parameters: {\n                    type: Type.OBJECT,\n                    properties: {\n                        assetName: { type: Type.STRING, description: \"Name of the sigil.\" },\n                        concept: { type: Type.STRING, description: \"Visual description.\" }\n                    },\n                    required: [\"assetName\"],\n                },\n            }\n        ],\n    },\n];\n\nconst AIAdvisorView: React.FC<{ previousView: View | null }> = ({ previousView }) => {\n    const context = useContext(DataContext);\n    const [messages, setMessages] = useState<any[]>(() => {\n        const saved = localStorage.getItem('demai_quantum_history');\n        return saved ? JSON.parse(saved) : [{ role: 'model', parts: [{ text: \"Quantum Core Active. Identify verified via Master Anchor. Command me.\" }] }];\n    });\n    const [input, setInput] = useState('');\n    const [isThinking, setIsThinking] = useState(false);\n    const chatRef = useRef<Chat | null>(null);\n    const scrollRef = useRef<HTMLDivElement>(null);\n\n    useEffect(() => {\n        if (scrollRef.current) scrollRef.current.scrollTop = scrollRef.current.scrollHeight;\n        localStorage.setItem('demai_quantum_history', JSON.stringify(messages));\n    }, [messages]);\n\n    useEffect(() => {\n        if (!chatRef.current && context?.reownProjectId) {\n            const ai = new GoogleGenAI({ apiKey: process.env.API_KEY || '' });\n            chatRef.current = ai.chats.create({\n                model: 'gemini-3-pro-preview',\n                config: { systemInstruction: DETAILED_SYSTEM_INSTRUCTION, tools: toolDefinitions }\n            });\n        }\n    }, [context]);\n\n    const executeTool = async (call: any) => {\n        if (call.name === 'getFinancialSummary') {\n            const fiat = context?.assets.reduce((s, a) => s + a.value, 0) || 0;\n            const crypto = context?.cryptoAssets.reduce((s, a) => s + a.value, 0) || 0;\n            return { totalNetWorth: fiat + crypto, status: 'OPTIMAL', domains: context?.linkedAccounts.length };\n        }\n        if (call.name === 'mintCreativeNFT') {\n            return { status: 'FORGE_READY', message: \"Parameters set. Head to Web3 Nexus to finalize the signature.\" };\n        }\n        return { error: \"Node unreachable.\" };\n    };\n\n    const handleSend = async () => {\n        if (!input.trim() || !chatRef.current) return;\n        const userMsg = { role: 'user', parts: [{ text: input }] };\n        setMessages(prev => [...prev, userMsg]);\n        setInput('');\n        setIsThinking(true);\n\n        try {\n            let response = await chatRef.current.sendMessage({ message: input });\n            \n            while (response.functionCalls && response.functionCalls.length > 0) {\n                const results = [];\n                for (const call of response.functionCalls) {\n                    const result = await executeTool(call);\n                    results.push({ functionResponse: { name: call.name, response: result, id: call.id } });\n                }\n                response = await chatRef.current.sendMessage({ message: results });\n            }\n\n            setMessages(prev => [...prev, { role: 'model', parts: [{ text: response.text || \"Synchronized.\" }] }]);\n        } catch (e) {\n            setMessages(prev => [...prev, { role: 'model', parts: [{ text: \"Handshake Refresh Required.\" }] }]);\n        } finally {\n            setIsThinking(false);\n        }\n    };\n\n    return (\n        <div className=\"h-full flex flex-col\">\n            <header className=\"mb-8\">\n                <h2 className=\"text-4xl font-black text-white tracking-tighter uppercase italic\">Quantum <span className=\"text-cyan-500\">Intelligence</span></h2>\n            </header>\n            <Card className=\"flex-1 flex flex-col bg-black/40 border-gray-800\" padding=\"none\">\n                <div ref={scrollRef} className=\"flex-1 p-8 space-y-8 overflow-y-auto\">\n                    {messages.map((msg, i) => (\n                        <div key={i} className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}>\n                            <div className={`max-w-2xl p-6 rounded-[2.5rem] text-sm font-bold shadow-2xl ${msg.role === 'user' ? 'bg-cyan-600 text-white rounded-br-none' : 'bg-gray-900 text-gray-200 border border-gray-800 rounded-bl-none'}`}>{msg.parts[0].text}</div>\n                        </div>\n                    ))}\n                    {isThinking && <div className=\"text-cyan-400 font-black uppercase italic text-xs tracking-widest animate-pulse\">Quantum Thinking...</div>}\n                </div>\n                <div className=\"p-6 bg-black border-t border-gray-800 flex gap-4\">\n                    <input value={input} onChange={e => setInput(e.target.value)} onKeyDown={e => e.key === 'Enter' && handleSend()} placeholder=\"Directive...\" className=\"flex-1 bg-gray-900 border border-gray-800 rounded-2xl px-8 py-5 text-white font-bold italic outline-none focus:ring-2 focus:ring-cyan-500 transition-all\" />\n                    <button onClick={handleSend} className=\"bg-cyan-600 px-12 rounded-2xl font-black text-white uppercase tracking-widest italic hover:bg-cyan-500 transition-all shadow-lg shadow-cyan-900/20\">Send</button>\n                </div>\n            </Card>\n        </div>\n    );\n};\n\nexport default AIAdvisorView;\n"
