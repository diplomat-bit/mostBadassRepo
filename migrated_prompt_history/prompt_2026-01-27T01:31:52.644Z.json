                   {modal === 'stripe' && <input type=\"password\" value={sKey} onChange={e => setSKey(e.target.value)} placeholder=\"Secret Key\" className=\"w-full bg-black border border-gray-800 rounded-2xl px-6 py-4 text-white outline-none\" />}\n                            {modal === 'gemini' && <input type=\"password\" value={gKey} onChange={e => setGKey(e.target.value)} placeholder=\"API Key\" className=\"w-full bg-black border border-gray-800 rounded-2xl px-6 py-4 text-white outline-none\" />}\n                            <button onClick={handleSave} className=\"w-full py-5 bg-cyan-600 hover:bg-cyan-500 text-white font-black rounded-2xl transition-all shadow-xl uppercase tracking-widest active:scale-95\">Synchronize Rails</button>\n                        </div>\n                    </div>\n                </div>\n            )}\n        </div>\n    );\n};\n\nexport default APIIntegrationView;\n"
