              "replacement": "\nimport React, { useState, useContext, useEffect } from 'react';\nimport { DataContext } from '../context/DataContext';\nimport { APIStatus } from '../types';\nimport Card from './Card';\n\nfunction SettingsIcon(props: React.SVGProps<SVGSVGElement>) {\n    return (\n        <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" {...props}>\n            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924-1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065zM15 12a3 3 0 11-6 0 3 3 0 016 0z\" />\n        </svg>\n    );\n}\n\nconst APIIntegrationView: React.FC = () => {\n    const context = useContext(DataContext);\n    if (!context) throw new Error(\"Infrastructure Violation: DataProvider missing.\");\n    \n    const { \n        apiStatus, \n        modernTreasuryApiKey, setModernTreasuryApiKey,\n        modernTreasuryOrganizationId, setModernTreasuryOrganizationId,\n        plaidClientId, setPlaidClientId,\n        plaidSecret, setPlaidSecret,\n        stripeSecretKey, setStripeSecretKey,\n        geminiApiKey, setGeminiApiKey,\n        reownProjectId\n    } = context;\n\n    const [modal, setModal] = useState<'mt' | 'plaid' | 'stripe' | 'gemini' | null>(null);\n    \n    // Internal input states\n    const [mtKey, setMtKey] = useState('');\n    const [mtOrg, setMtOrg] = useState('');\n    const [pId, setPId] = useState('');\n    const [pSec, setPSec] = useState('');\n    const [sKey, setSKey] = useState('');\n    const [gKey, setGKey] = useState('');\n\n    useEffect(() => {\n        if (modal === 'mt') { setMtKey(modernTreasuryApiKey || ''); setMtOrg(modernTreasuryOrganizationId || ''); }\n        if (modal === 'plaid') { setPId(plaidClientId || ''); setPSec(plaidSecret || ''); }\n        if (modal === 'stripe') { setSKey(stripeSecretKey || ''); }\n        if (modal === 'gemini') { setGKey(geminiApiKey || ''); }\n    }, [modal, modernTreasuryApiKey, modernTreasuryOrganizationId, plaidClientId, plaidSecret, stripeSecretKey, geminiApiKey]);\n\n    const handleSave = () => {\n        if (modal === 'mt') { setModernTreasuryApiKey(mtKey); setModernTreasuryOrganizationId(mtOrg); }\n        if (modal === 'plaid') { setPlaidClientId(pId); setPlaidSecret(pSec); }\n        if (modal === 'stripe') { setStripeSecretKey(sKey); }\n        if (modal === 'gemini') { setGeminiApiKey(gKey); }\n        setModal(null);\n    };\n\n    const StatusIndicator: React.FC<{ status: APIStatus['status'] }> = ({ status }) => {\n        const statusMap = {\n            'Operational': 'bg-green-500/20 text-green-300 dot:bg-green-400',\n            'Degraded Performance': 'bg-yellow-500/20 text-yellow-300 dot:bg-yellow-400',\n            'Partial Outage': 'bg-orange-500/20 text-orange-300 dot:bg-orange-400',\n            'Major Outage': 'bg-red-500/20 text-red-300 dot:bg-red-400'\n        };\n        const style = statusMap[status] || statusMap['Operational'];\n        const dotColor = style.split('dot:')[1];\n        \n        return (\n            <div className={`flex items-center gap-2 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest ${style.split(' dot:')[0]}`}>\n                <div className={`w-1.5 h-1.5 rounded-full ${dotColor}`}></div>\n                {status}\n            </div>\n        );\n    };\n\n    return (\n        <div className=\"space-y-8 pb-20\">\n            <header>\n                <h2 className=\"text-5xl font-black text-white tracking-tighter uppercase italic\">Developer Portal</h2>\n                <p className=\"text-gray-500 font-bold tracking-widest mt-2 uppercase text-xs\">Infrastructure Registry</p>\n            </header>\n\n            <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-8\">\n                <Card title=\"Infrastructure Registry\">\n                    <div className=\"space-y-4\">\n                        {apiStatus.map(api => (\n                            <div key={api.provider} className=\"flex flex-col sm:flex-row justify-between items-center p-5 bg-gray-900 border border-gray-800 rounded-3xl group hover:border-cyan-500/50 transition-all shadow-xl\">\n                                <div className=\"flex flex-col gap-1\">\n                                    <div className=\"flex items-center gap-5\">\n                                        <h4 className=\"font-black text-white text-lg italic tracking-tight uppercase\">{api.provider}</h4>\n                                        <StatusIndicator status={api.status} />\n                                    </div>\n                                    <p className=\"text-[9px] text-gray-600 font-mono tracking-widest uppercase\">\n                                        {api.provider === 'Plaid' && (plaidClientId ? 'Authorized' : 'Requires Config')}\n                                        {api.provider === 'Modern Treasury' && (modernTreasuryApiKey ? 'Authorized' : 'Requires Config')}\n                                        {api.provider === 'Stripe' && (stripeSecretKey ? 'Authorized' : 'Requires Config')}\n                                        {api.provider === 'Google Gemini' && (geminiApiKey ? 'Authorized' : 'Requires Config')}\n                                        {api.provider === 'Reown' && 'Locked System Anchor'}\n                                    </p>\n                                </div>\n                                <div className=\"flex items-center gap-8\">\n                                    <p className=\"text-[10px] text