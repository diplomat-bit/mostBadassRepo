00% { stroke-dashoffset: 0; } }\n            @keyframes stroke-check { 100% { stroke-dashoffset: 0; } }\n        `}</style>\n    </>\n);\n\nexport const QuantumLedgerAnimation: React.FC = () => (\n    <div className=\"flex flex-col items-center\">\n        <div className=\"grid grid-cols-4 gap-2 w-32 h-32\">\n            {Array.from({ length: 16 }).map((_, i) => (\n                <div key={i} className=\"bg-cyan-500/20 border border-cyan-500 rounded animate-pulse\" style={{ animationDelay: `${i * 0.1}s` }}></div>\n            ))}\n        </div>\n        <p className=\"mt-4 text-[10px] text-cyan-400 font-black uppercase tracking-[0.3em] animate-pulse\">Quantum Verification</p>\n    </div>\n);\n\nconst SendMoneyView: React.FC<{ setActiveView: (view: View) => void }> = ({ setActiveView }) => {\n    const [amount, setAmount] = useState('5.00');\n    const [recipient, setRecipient] = useState<RemitraxRecipientProfile | null>(null);\n    const [isProcessing, setIsProcessing] = useState(false);\n    const [isSuccess, setIsSuccess] = useState(false);\n    const [statusMsg, setStatusMsg] = useState('');\n\n    const context = useContext(DataContext);\n    if (!context) throw new Error(\"SendMoneyView must be within a DataProvider\");\n    const { addTransaction } = context;\n\n    const handleBasePay = async () => {\n        if (!amount || !recipient) return;\n        setIsProcessing(true);\n        setStatusMsg(\"Initializing Base Pay Protocol...\");\n        \n        try {\n            const baseSDK = (window as any).base;\n            if (!baseSDK) throw new Error(\"Base SDK Unavailable\");\n\n            const result = await baseSDK.pay({\n                amount: amount,\n                to: recipient.address || \"0x2211d1D0020DAEA8039E46Cf1367962070d77DA9\",\n                testnet: false,\n            });\n\n            setStatusMsg(\"Payment Broadcast. Monitoring Ledger...\");\n            \n            const status = await baseSDK.getPaymentStatus({\n                id: result.id,\n                testnet: false,\n            });\n\n            if (status.status === 'success' || status.status === 'COMPLETED') {\n                const newTx: Transaction = {\n                    id: `base_${Date.now()}`,\n                    type: 'expense',\n                    category: 'Transfer',\n                    description: `Base Pay to ${recipient.name}`,\n                    amount: parseFloat(amount),\n                    date: new Date().toISOString().split('T')[0],\n                };\n                addTransaction(newTx);\n                setIsProcessing(false);\n                setIsSuccess(true);\n                setTimeout(() => {\n                    setIsSuccess(false);\n                    setActiveView(View.Dashboard);\n                }, 3000);\n            } else {\n                throw new Error(`Payment status: ${status.status}`);\n            }\n        } catch (error: any) {\n            console.error(\"Base Pay Error:\", error);\n            alert(`Payment Error: ${error.message}`);\n            setIsProcessing(false);\n        }\n    };\n\n    const mockRecipient: RemitraxRecipientProfile = {\n        id: 'rec_1',\n        name: 'Alex Ray',\n        quantumTag: '@alexray',\n        address: '0x2211d1D0020DAEA8039E46Cf1367962070d77DA9',\n        avatarUrl: 'https://i.pravatar.cc/80?u=alexray'\n    };\n\n    if(isProcessing) {\n        return (\n            <Card>\n                <div className=\"flex flex-col items-center justify-center h-96\">\n                    <QuantumLedgerAnimation />\n                    <p className=\"mt-8 text-xl font-black text-white uppercase italic tracking-tighter\">{statusMsg}</p>\n                </div>\n            </Card>\n        );\n    }\n    \n    if(isSuccess) {\n         return (\n            <Card>\n                <div className=\"flex flex-col items-center justify-center h-96\">\n                    <AnimatedCheckmarkIcon />\n                    <p className=\"mt-8 text-3xl font-black text-white uppercase italic tracking-tighter\">PROTOCOL SUCCESS</p>\n                    <p className=\"text-gray-400 font-bold uppercase tracking-widest text-xs mt-2\">${amount} Transferred to {recipient?.name}</p>\n                </div>\n            </Card>\n        );\n    }\n\n    return (\n        <div className=\"space-y-10\">\n            <header>\n                <h2 className=\"text-6xl font-black text-white tracking-tighter uppercase italic\">Remitrax</h2>\n                <p className=\"text-gray-500 font-bold uppercase tracking-widest text-xs mt-2\">Global Liquidity Router</p>\n            </header>\n            \n            <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-12\">\n                <Card title=\"Counterparty\">\n                    <div \n                        className={`p-8 bg-black border-2 rounded-[2.5rem] flex items-center gap-6 cursor-pointer transition-all ${recipient ? 'border-cyan-500 shadow-2xl shadow-cyan-900/20' : 'border-gray-800'}`}\n                        onClick={() => setRecipient(mockRecipient)}\n                    >\n                         <img src={mockRecipient.avatarUrl} alt={mockRecipient.name} className=\"w-20 h-20 rounded-3xl\" />\n                         <div>\n                            <p className=\"font-black text-white text-2xl uppercase italic tracking-tighter\">{mockRecipient.name}</p>\n                            <p className=\"text-sm text-cyan-400 font-mono\">{mockRecipient.quantumTag}</p>\n                            <p className=\"text-[9px] text-gray-600 font-mono mt-1\">{mockRecipient.address}</p>\n                         </div>\n                    </div>\n                </Card>\n\n                <Card title=\"Value Parameters\">\n                    <div className=\"space-y-8\">\n                        <div>\n                            <label className=\"text-[10px] font-black uppercase tracking-widest text-gray-500 ml-2\">Amount (USDC Quoted)</label>\n                            <input \n                                type=\"number\"\n                                value={amount}\n                                onChange={(e) => setAmount(e.target.value)}\n                                className=\"w-full text-7xl bg-transparent border-b-4 border-gray-800 focus:border-cyan-500 text-white outline-none font-black italic pb-4 mt-2\"\n                            />\n                        </div>\n                        \n                        <div className=\"space-y-4\">\n                            <button\n                                onClick={handleBasePay}\n                                disabled={!amount || !recipient}\n                                className=\"w-full py-6 bg-blue-600 hover:bg-blue-500 text-white font-black uppercase tracking-[0.3em] italic rounded-2xl shadow-xl transition-all flex items-center justify-center gap-4 disabled:opacity-20\"\n                            >\n                                <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M12 24C18.6274 24 24 18.6274 24 12C24 5.37258 18.6274 0 12 0C5.37258 0 0 5.37258 0 12C0 18.6274 5.37258 24 12 24Z\" fill=\"white\"/></svg>\n                                Pay with Base\n                            </button>\n                            <p className=\"text-center text-[10px] text-gray-700 uppercase font-bold tracking-[0.2em]\">Gasless One-Tap USDC Protocol</p>\n                        </div>\n                    </div>\n                </Card>\n            </div>\n        </div>\n    );\n};\n\nexport default SendMoneyView;"
