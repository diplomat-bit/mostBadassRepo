rder-dashed border-gray-800 rounded-3xl bg-black/20 animate-pulse\">\n                                    <h3 className=\"text-gray-500 font-black uppercase italic tracking-tighter\">Chain Status: OFFLINE</h3>\n                                    <div className=\"mt-8 flex justify-center\"><AppKitButton /></div>\n                                </div>\n                            ) : (\n                                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                                    {cryptoAssets.map(asset => (\n                                        <div key={asset.ticker} className=\"flex justify-between items-center p-6 bg-gray-900 border border-gray-800 rounded-3xl group hover:border-cyan-500/50 transition-all shadow-xl\">\n                                            <div className=\"flex items-center gap-4\">\n                                                <div className=\"w-14 h-14 rounded-2xl flex items-center justify-center font-black text-white shadow-lg\" style={{backgroundColor: asset.color}}>{asset.ticker[0]}</div>\n                                                <div>\n                                                    <p className=\"font-black text-white uppercase tracking-tight italic\">{asset.name}</p>\n                                                    <p className=\"text-xs text-gray-500 font-mono\">{asset.amount.toFixed(6)} {asset.ticker}</p>\n                                                </div>\n                                            </div>\n                                            <div className=\"text-right\"><p className=\"font-black text-white text-xl\">${asset.value.toLocaleString()}</p></div>\n                                        </div>\n                                    ))}\n                                </div>\n                            )}\n                        </Card>\n                        <Card title=\"Sigil Gallery (NFTs)\">\n                             <div className=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4\">\n                                {nftAssets.map(nft => (\n                                    <div key={nft.id} className=\"bg-black rounded-2xl overflow-hidden border border-gray-800 group hover:border-cyan-500 transition-all\">\n                                        <img src={nft.imageUrl} className=\"aspect-square object-cover w-full group-hover:scale-110 transition-transform\" />\n                                        <div className=\"p-3\">\n                                            <p className=\"text-[10px] font-black text-white uppercase truncate\">{nft.name}</p>\n                                            <p className=\"text-[8px] text-gray-600 font-mono truncate\">{nft.contractAddress}</p>\n                                        </div>\n                                    </div>\n                                ))}\n                             </div>\n                        </Card>\n                    </div>\n                );\n            case 'NFT Forge':\n                return (\n                    <Card title=\"Forge Sovereign Sigil\">\n                        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n                            <div className=\"space-y-4\">\n                                <p className=\"text-sm text-gray-400\">Convert physical visual data into immutable on-chain sigils.</p>\n                                <input type=\"text\" value={nftName} onChange={e => setNftName(e.target.value)} placeholder=\"Sigil Name...\" className=\"w-full bg-black border border-gray-800 rounded-2xl p-4 text-white font-mono outline-none\" />\n                                <input type=\"file\" onChange={handleFile} className=\"block w-full text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-cyan-600/10 file:text-cyan-400 hover:file:bg-cyan-600/20\" />\n                                <button onClick={handle