e.ARRAY, \n                        items: { \n                            type: Type.OBJECT,\n                            properties: {\n                                id: { type: Type.STRING },\n                                question: { type: Type.STRING },\n                                category: { type: Type.STRING }\n                            }\n                        }\n                    }\n                }\n            }\n        }\n      });\n      const data = JSON.parse(response.text || '{}');\n      setWeaverState(prev => ({ \n        ...prev, \n        stage: WeaverStage.Test, \n        feedback: data.feedback, \n        questions: data.questions \n      }));\n    } catch (e) {\n      setWeaverState(prev => ({ ...prev, stage: WeaverStage.Error, error: \"Synapse Failure: The VC node is unreachable.\" }));\n    }\n  };\n\n  const simulateTestPass = async () => {\n    setWeaverState(prev => ({ ...prev, stage: WeaverStage.FinalReview }));\n    try {\n      const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });\n      const response = await ai.models.generateContent({\n        model: 'gemini-3-pro-preview',\n        contents: `Founder passed evaluation for: \"${weaverState.businessPlan}\". Generate 6-month hyper-growth roadmap JSON: { title: string, summary: string, steps: [{ title: string, description: string, timeline: string }] }`,\n        config: { responseMimeType: 'application/json' }\n      });\n      const plan = JSON.parse(response.text || '{}');\n      setWeaverState(prev => ({ \n        ...prev, \n        stage: WeaverStage.Approved, \n        loanAmount: Math.floor(Math.random() * 250000) + 50000,\n        coachingPlan: plan \n      }));\n    } catch (e) {\n      setWeaverState(prev => ({ ...prev, stage: WeaverStage.Error, error: \"Capital Allocation Failure.\" }));\n    }\n  };\n\n  const mintNFT = async (name: string, imageUrl: string) => {\n    if (!isConnected) throw new Error(\"Verification Required: Connect your wallet to bridge visuals to the chain.\");\n    \n    // Real cryptographic signing request to the wallet\n    const timestamp = Date.now();\n    await signMessageAsync({ \n      message: `AUTHORIZE_DEMAI_SOVEREIGN_MINT\\nAsset: ${name}\\nAnchor: ${imageUrl.substring(0, 50)}...\\nEpoch: ${timestamp}` \n    });\n\n    const newNFT: NFTAsset = {\n        id: `sigil-${timestamp}`,\n        name,\n        imageUrl,\n        contractAddress: `0xBase_Sovereign_Forge_v1`\n    };\n    \n    setNftAssets(prev => {\n        const updated = [newNFT, ...prev];\n        localStorage.setItem('demai_sigil_vault', JSON.stringify(updated));\n        return updated;\n    });\n  };\n\n  const cryptoAssets = useMemo(() => {\n    const assets: CryptoAsset[] = [];\n    if (isConnected && ethBalance) {\n      assets.push({ ticker: 'ETH', name: 'Ethereum', amount: parseFloat(ethBalance.formatted), value: parseFloat(ethBalance.formatted) * 3250, color: '#627eea' });\n    }\n    return assets;\n  }, [isConnected, ethBalance]);\n\n  const addTransaction = (tx: Transaction) => setTransactions(prev => [tx, ...prev]);\n\n  const addCounterparty = async (data: any) => {\n    const newCp: Counterparty = {\n        id: `cp-${Date.now()}`,\n        name: data.name,\n        email: data.email,\n        send_remittance_advice: true,\n        accounts: [{ id: 'bank-1', party_name: data.name, account_details: [{ account_number_safe: data.accountNumber.slice(-4) }] }],\n        created_at: new Date().toISOString()\n    };\n    setCounterparties(prev => [...prev, newCp]);\n  };\n\n  return (\n    <DataContext.Provider value={{\n      transactions, assets: MOCK_ASSETS, impactInvestments: MOCK_IMPACT_INVESTMENTS, budgets,\n      addBudget: (b) => setBudgets(prev => [...prev, { ...b, id: Date.now().toString(), spent: 0, color: '#06b6d4' }]),\n      gamification: { score: 999, level: 5, levelName: 'System Architect', progress: 100, credits: 5000 },\n      impactData: { treesPlanted: 50, spendingForNextTree: 20, progressT