              "replacement": "\nimport React, { useContext, useState } from 'react';\nimport { DataContext } from '../context/DataContext';\nimport Card from './Card';\nimport { useAppKitAccount } from \"@reown/appkit/react\";\n\nconst AppKitButton = 'appkit-button' as any;\n\nconst CryptoView: React.FC = () => {\n    const context = useContext(DataContext);\n    if (!context) throw new Error(\"Infrastructure Violation: DataProvider missing.\");\n    \n    const { cryptoAssets, nftAssets, mintNFT, virtualCard, issueVirtualCard } = context;\n    const { isConnected, address } = useAppKitAccount();\n    const [activeTab, setActiveTab] = useState<'Portfolio' | 'NFT Forge' | 'Marqeta Bridge'>('Portfolio');\n    \n    // Forge State\n    const [nftName, setNftName] = useState('');\n    const [nftFile, setNftFile] = useState<string | null>(null);\n    const [isMinting, setIsMinting] = useState(false);\n    const [lastTxHash, setLastTxHash] = useState<string | null>(null);\n\n    const handleFile = (e: React.ChangeEvent<HTMLInputElement>) => {\n        if (e.target.files?.[0]) {\n            const reader = new FileReader();\n            reader.onload = (ev) => setNftFile(ev.target?.result as string);\n            reader.readAsDataURL(e.target.files[0]);\n        }\n    };\n\n    const handleMint = async () => {\n        if (!nftName || !nftFile || !isConnected) return;\n        setIsMinting(true);\n        setLastTxHash(null);\n        try {\n            const hash = await mintNFT(nftName, nftFile);\n            setLastTxHash(hash);\n            setNftName('');\n            setNftFile(null);\n            // In a commercial app, we'd wait for block confirmation here.\n        } catch (e: any) {\n            console.error(\"FORGE_FAILURE:\", e);\n            alert(`REJECTED: ${e.message || \"User denied cryptographic anchor.\"}`);\n        } finally {\n            setIsMinting(false);\n        }\n    };\n\n    const renderContent = () => {\n        switch (activeTab) {\n            case 'Portfolio':\n                return (\n                    <div className=\"space-y-6\">\n                        <Card title=\"Sovereign Inventory\">\n                            {!isConnected ? (\n                                <div className=\"text-center py-20 border-2 border-dashed border-gray-800 rounded-[2.5rem] bg-black/40 animate-pulse\">\n                                    <h3 className=\"text-gray-600 font-black uppercase italic tracking-tighter text-xl\">Authorization Required</h3>\n                                    <div className=\"mt-8 flex justify-center\"><AppKitButton /></div>\n                                </div>\n                            ) : (\n                                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                                    {cryptoAssets.map(asset => (\n                                        <div key={asset.ticker} className=\"flex justify-between items-center p-8 bg-black border border-gray-800 rounded-[2rem] group hover:border-cyan-500/50 transition-all shadow-2xl\">\n                                            <div className=\"flex items-center gap-6\">\n                                                <div className=\"w-16 h-16 rounded-2xl flex items-center justify-center font-black text-white text-2xl shadow-inner\" style={{backgroundColor: asset.color}}>{asset.ticker[0]}</div>\n                                                <div>\n                                                    <p className=\"font-black text-white uppercase tracking-tighter italic text-xl\">{asset.name}</p>\n                                                    <p className=\"text-[10px] text-gray-500 font-mono tracking-widest\">{asset.amount.toFixed(6)} {asset.ticker}</p>\n                                                </div>\n                                            </div>\n                                            <div className=\"text-right\">\n                                                <p className=\"font-black text-white text-2xl\">${asset.value.toLocaleString()}</p>\n                                            </div>\n                                        </div>\n                                    ))}\n                                    {cryptoAssets.length === 0 && <p className=\"text-gray-500 italic p-4 text-center w-full\">Synchronizing with blockchain index...</p>}\n                                </div>\n                            )}\n                        </Card>\n                        \n                        {isConnected && (\n                            <Card title=\"Sigil Gallery (NFTs)\">\n                                <div className=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6\">\n                                    {nftAssets.map(nft => (\n                                        <div key={nft.id} className=\"bg-black rounded-3xl overflow-hidden border border-gray-800 group hover:border-cyan-500 transition-all shadow-xl\">\n                                            <div className=\"aspect-square relative overflow-hidden\">\n                                                <img src={nft.imageUrl} className=\"object-cover w-full h-full group-hover:scale-110 transition-transform duration-500\" />\n                                                <div className=\"absolute inset-0 bg-gradient-to-t from-black/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4\">\n                                                    <p className=\"text-[8px] text-cyan-400 font-mono truncate\">{nft.contractAddress}</p>\n                                                </div>\n                                            </div>\n                                            <div className=\"p-4\">\n                                                <p className=\"text-[10px] font-black text-white uppercase truncate italic\">{nft.name}</p>\n                                            </div>\n                                        </div>\n                                    ))}\n                                    {nftAssets.length === 0 && (\n                                        <div className=\"col-span-full py-12 text-center border border-dashed border-gray-800 rounded-3xl text-gray-600 font-bold uppercase text-xs tracking-widest\">Vault Empty</div>\n                                    )}\n                                </div>\n                            </Card>\n                        )}\n                    </div>\n                );\n            case 'NFT Forge':\n                return (\n                    <Card title=\"Forge Sovereign Sigil\">\n                        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-12\">\n                            <div className=\"space-y-6\">\n                                <p className=\"text-sm text-gray-400 leading-relaxed italic\">Convert physical visual data into immutable ledger entries. Requires cryptographic authorization.</p>\n                                \n                                <div className=\"space-y-2\">\n                                    <label className=\"text-[10px] font-black uppercase tracking-widest text-gray-500 ml-2\">Artifact Designation</label>\n                                    <input type=\"text\" value={nftName} onChange={e => setNftName(e.target.value)} placeholder=\"Sigil Name...\" className=\"w-full bg-black border border-gray-800 rounded-2xl p-5 text-white font-black italic outline-none focus:ring-2 focus:ring-cyan-500\" />\n                                </div>\n\n                                <div className=\"space-y-2\">\n                                    <label className=\"text-[10px] font-black uppercase tracking-widest text-gray-500 ml-2\">Visual Feed</label>\n                                    <input type=\"file\" onChange={handleFile} className=\"block w-full text-xs text-gray-500 file:mr-4 file:py-3 file:px-6 file:rounded-2xl file:border-0 file:text-[10px] file:font-black file:uppercase file:bg-cyan-600/10 file:text-cyan-400 hover:file:bg-cyan-600/20\" />\n                                </div>\n\n                                <button \n                                    onClick={handleMint} \n                                    disabled={isMinting || !nftFile || !nftName || !isConnected} \n                                    className=\"w-full bg-cyan-600 py-5 rounded-2xl font-black text-white uppercase tracking-[0.2em] italic hover:bg-cyan-500 transition-all disabled:opacity-20 shadow-lg shadow-cyan-900/20\"\n                                >\n                                    {isMinting ? \"Broadcasting to Ledger...\" : \"Authorize Forge\"}\n                                </button>\n\n                                {lastTxHash && (\n                                    <div className=\"p-4 bg-green-900/10 border border-green-500/30 rounded-2xl animate-fade-in\">\n                                        <p className=\"text-[10px] text-green-400 font-black uppercase tracking-widest\">Protocol Success</p>\n                                        <p className=\"text-[9px] text-gray-500 font-mono break-all mt-1\">{lastTxHash}</p>\n                                    </div>\n                                )}\n                            </div>\n                            <div className=\"flex items-center justify-center border-4 border-dashed border-gray-900 rounded-[3rem] bg-black/60 aspect-square relative group\">\n                                {nftFile ? (\n                                    <img src={nftFile} className=\"w-full h-full object-cover rounded-[2.8rem] group-hover:opacity-80 transition-opacity shadow-2xl\" />\n                                ) : (\n                                    <p className=\"text-gray-800 font-black uppercase italic tracking-widest text-xl opacity-20\">Awaiting Signal</p>\n                                )}\n                            </div>\n                        </div>\n                    </Card>\n                );\n            case 'Marqeta Bridge':\n                return (\n                    <Card title=\"Marqeta Physical Proxy\">\n                        <div className=\"max-w-2xl mx-auto space-y-12 text-center py-10\">\n                            <p className=\"text-sm text-gray-400 leading-relaxed italic\">Anchor your on-chain liquidity to a physical-ready virtual card.</p>\n                            \n                            {virtualCard ? (\n                                <div className=\"relative aspect-[85.6/54] w-full max-w-md mx-auto bg-gradient-to-br from-gray-900 to-black rounded-[2.5rem] border border-gray-700 p-12 shadow-2xl ring-1 ring-white/5\">\n                                    <div className=\"text-cyan-400 font-black italic text-3xl\">DEMAI</div>\n                                    <div className=\"mt-20 text-3xl font-mono text-white tracking-[0.25em]\">{virtualCard.cardNumber}</div>\n                                    <div className=\"mt-8 flex justify-between items-end\">\n                                        <div>\n                                            <p className=\"text-[8px] text-gray-600 font-black uppercase tracking-widest\">Validator Thru</p>\n                                            <p className=\"text-xs text-gray-500 font-mono tracking-widest\">{virtualCard.expiry}</p>\n                                        </div>\n                                        <div className=\"w-12 h-8 bg-gray-800 rounded border border-gray-700 flex items-center justify-center\">\n                                            <div className=\"w-6 h-6 rounded-full bg-cyan-500/20 animate-pulse\"></div>\n                                        </div>\n                                    </div>\n                                </div>\n                            ) : (\n                                <button onClick={issueVirtualCard} className=\"w-full py-24 border-4 border-dashed border-gray-900 rounded-[4rem] text-gray-800 font-black uppercase tracking-[0.3em] hover:text-cyan-600 hover:border-cyan-900/30 transition-all text-xl\">\n                                    Authorize Physical Proxy\n                                </button>\n                            )}\n                        </div>\n                    </Card>\n                );\n            default: return null;\n        }\n    };\n\n    return (\n        <div className=\"space-y-8 pb-20\">\n            <div className=\"flex flex-col sm:flex-row justify-between items-end gap-6 border-b border-gray-800 pb-10\">\n                <div>\n                    <h2 className=\"text-6xl font-black text-white tracking-tighter uppercase italic\">Web3 Nexus</h2>\n                    <p className=\"text-gray-500 font-bold uppercase tracking-widest text-[9px] mt-2 italic\">Active Anchor: {address || 'Awaiting Identity'}</p>\n                </div>\n                <div className=\"scale-110\"><AppKitButton /></div>\n            </div>\n            \n            <nav className=\"flex space-x-12 px-2 border-b border-gray-900\">\n                {(['Portfolio', 'NFT Forge', 'Marqeta Bridge'] as const).map(tab => (\n                    <button key={tab} onClick={() => setActiveTab(tab)} className={`${activeTab === tab ? 'text-cyan-400 border-cyan-500' : 'text-gray-600 border-transparent hover:text-gray-400'} whitespace-nowrap pb-4 border-b-4 font-black text-[10px] uppercase tracking-[0.3em] transition-all`}>{tab}</button>\n                ))}\n            </nav>\n\n            <div className=\"mt-8 animate-fade-in\">{renderContent()}</div>\n        </div>\n    );\n};\n\nexport default CryptoView;\n"
            }
