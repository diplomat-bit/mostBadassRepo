              "replacement": "import React, { useMemo } from 'react';\nimport { WagmiProvider } from 'wagmi';\n// FIX: Imported mainnet and base from viem/chains\nimport { mainnet, base } from 'viem/chains';\nimport type { AppKitNetwork } from '@reown/appkit/networks';\nimport { WagmiAdapter } from '@reown/appkit-adapter-wagmi';\nimport { createAppKit } from '@reown/appkit';\nimport { QueryClient, QueryClientProvider } from '@tanstack/react-query';\n\n// 0. Setup queryClient\nconst queryClient = new QueryClient();\n\n// 1. Get projectId from localStorage or default\nconst DEFAULT_PROJECT_ID = '04a6c1309e33a508aa9cffdcf6bd5cc6';\n\nlet appKitInstance: any = null;\n\n// FIX: Made children prop optional to resolve \"children missing\" errors in index.tsx.\nexport function Web3Provider({ children }: { children?: React.ReactNode }) {\n  const projectId = localStorage.getItem('reownProjectId') || DEFAULT_PROJECT_ID;\n\n  const config = useMemo(() => {\n    // 2. Create a metadata object\n    const metadata = {\n      name: 'Demai',\n      description: 'Next-Gen Financial Hub',\n      url: typeof window !== 'undefined' ? window.location.origin : 'https://citibankdemobusiness.dev',\n      icons: ['https://avatars.githubusercontent.com/u/221693154?s=48&v=4']\n    };\n\n    // 3. Set the networks (Using mainnet and base for Wagmi compatibility)\n    // FIX: Included base chain to support Base Account / Smart Wallet features.\n    const networks: [AppKitNetwork, ...AppKitNetwork[]] = [mainnet as AppKitNetwork, base as AppKitNetwork];\n\n    // 4. Create Wagmi Adapter\n    const wagmiAdapter = new WagmiAdapter({\n      networks,\n      projectId,\n      ssr: true\n    });\n\n    // 5. Create AppKit modal (Single Instance Guard)\n    if (!appKitInstance) {\n      appKitInstance = createAppKit({\n        adapters: [wagmiAdapter],\n        networks,\n        projectId,\n        metadata,\n        features: {\n          analytics: true,\n          // Enabling social and email login for true financial democratization\n          socials: ['google', 'x', 'github', 'discord', 'apple'],\n          email: true,\n        },\n        allWallets: 'SHOW',\n        connectorImages: {\n          coinbaseWallet: 'https://avatars.githubusercontent.com/u/18060234?s=200&v=4'\n        }\n      });\n    }\n\n    return wagmiAdapter.wagmiConfig;\n  }, [projectId]);\n\n  return (\n    <WagmiProvider config={config}>\n      <QueryClientProvider client={queryClient}>\n        {children}\n      </QueryClientProvider>\n    </WagmiProvider>\n  );\n}"
