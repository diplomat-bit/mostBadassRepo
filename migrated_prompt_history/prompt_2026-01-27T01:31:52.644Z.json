ponse = await chatRef.current.sendMessage({ message: input });\n            \n            // Handle Tool Calls\n            while (response.functionCalls && response.functionCalls.length > 0) {\n                const results = [];\n                for (const call of response.functionCalls) {\n                    const result = await executeTool(call);\n                    results.push({\n                        functionResponse: { name: call.name, response: result, id: call.id }\n                    });\n                }\n                // Send results back to model\n                response = await chatRef.current.sendMessage({ message: results });\n            }\n\n            setMessages(prev => [...prev, { role: 'model', parts: [{ text: response.text || \"Synchronizing data stream...\" }] }]);\n        } catch (e) {\n            console.error(e);\n            setMessages(prev => [...prev, { role: 'model', parts: [{ text: \"Quantum logic bottleneck detected. Handshake re-initializing...\" }] }]);\n        } finally {\n            setIsThinking(false);\n        }\n    };\n\n    return (\n        <div className=\"h-full flex flex-col\">\n            <header className=\"mb-8\">\n                <h2 className=\"text-4xl font-black text-white tracking-tighter uppercase italic\">Quantum <span className=\"text-cyan-500\">Intelligence</span></h2>\n                <p className=\"text-[10px] font-bold text-gray-600 uppercase tracking-[0.4em] mt-2\">Active Node: Gemini-3-Pro-Preview</p>\n            </header>\n\n            <Card className=\"flex-1 flex flex-col bg-black/40 border-gray-800\" padding=\"none\">\n                <div ref={scrollRef} className=\"flex-1 p-8 space-y-8 overflow-y-auto\">\n                    {messages.map((msg, i) => (\n                        <div key={i} className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}>\n                            <div className={`max-w-2xl p-6 rounded-[2.5rem] text-sm font-bold tracking-tight leadi