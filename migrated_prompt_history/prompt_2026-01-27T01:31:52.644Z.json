              "replacement": "import React, { createContext, useState, ReactNode, useEffect, useCallback, useMemo } from 'react';\nimport { GoogleGenAI, Type } from \"@google/genai\";\nimport { useBalance, useAccount, useSignMessage } from \"wagmi\";\nimport type { \n  Transaction, Asset, BudgetCategory, GamificationState, IllusionType, \n  LinkedAccount, QuantumWeaverState, AIPlan, Subscription, \n  CreditScore, UpcomingBill, SavingsGoal, MarketMover, \n  FinancialGoal, CryptoAsset, VirtualCard, \n  PaymentOperation, AIInsight, CorporateCard, CorporateTransaction, \n  RewardPoints, Notification, NFTAsset, RewardItem, APIStatus, \n  CreditFactor, CorporateCardControls, Counterparty \n} from '../types';\nimport { WeaverStage, View } from '../types';\nimport { \n  MOCK_TRANSACTIONS, MOCK_ASSETS, MOCK_IMPACT_INVESTMENTS, MOCK_BUDGETS, \n  MOCK_SUBSCRIPTIONS, MOCK_CREDIT_SCORE, MOCK_UPCOMING_BILLS, MOCK_SAVINGS_GOALS, \n  MOCK_MARKET_MOVERS, MOCK_FINANCIAL_GOALS, MOCK_PAYMENT_OPERATIONS, \n  MOCK_CORPORATE_CARDS, MOCK_CORPORATE_TRANSACTIONS, MOCK_REWARD_POINTS, \n  MOCK_NOTIFICATIONS, MOCK_REWARD_ITEMS, MOCK_API_STATUS, MOCK_CREDIT_FACTORS,\n  MOCK_COUNTERPARTIES\n} from '../data/mockData';\n\nconst DEFAULT_PROJECT_ID = '04a6c1309e33a508aa9cffdcf6bd5cc6';\n\ninterface IDataContext {\n  transactions: Transaction[];\n  assets: Asset[];\n  impactInvestments: Asset[];\n  budgets: BudgetCategory[];\n  addBudget: (budget: Omit<BudgetCategory, 'id' | 'spent' | 'color'>) => void;\n  gamification: GamificationState;\n  impactData: { treesPlanted: number; spendingForNextTree: number; progressToNextTree: number; };\n  customBackgroundUrl: string | null;\n  setCustomBackgroundUrl: (url: string) => void;\n  addTransaction: (tx: Transaction) => void;\n  activeIllusion: IllusionType;\n  setActiveIllusion: (illusion: IllusionType) => void;\n  linkedAccounts: LinkedAccount[];\n  unlinkAccount: (id: string) => void;\n  handlePlaidSuccess: (publicToken: string, metadata: any) => Promise<void>;\n  getPlaidLinkToken: () => Promise<string | null>;\n  weaverState: QuantumWeaverState;\n  pitchBusinessPlan: (plan: string) => Promise<void>;\n  simulateTestPass: () => Promise<void>;\n  subscriptions: Subscription[];\n  creditScore: CreditScore;\n  upcomingBills: UpcomingBill[];\n  savingsGoals: SavingsGoal[];\n  marketMovers: MarketMover[];\n  financialGoals: FinancialGoal[];\n  addFinancialGoal: (goalData: Omit<FinancialGoal, 'id' | 'plan' | 'currentAmount'>) => void;\n  contributeToGoal: (goalId: string, amount: number) => void;\n  generateGoalPlan: (goalId: string) => Promise<void>;\n  cryptoAssets: CryptoAsset[];\n  importToken: (address: string) => Promise<void>;\n  paymentOperations: PaymentOperation[];\n  virtualCard: VirtualCard | null;\n  issueVirtualCard: () => Promise<void>;\n  buyCrypto: (usdAmount: number, cryptoTicker: string) => void;\n  aiInsights: AIInsight[];\n  isInsightsLoading: boolean;\n  corporateCards: CorporateCard[];\n  corporateTransactions: CorporateTransaction[];\n  toggleCorporateCardFreeze: (cardId: string) => void;\n  updateCorporateCard: (cardId: string, newControls: CorporateCardControls, newFrozenState: boolean) => void;\n  rewardPoints: RewardPoints;\n  notifications: Notification[];\n  markNotificationRead: (id: string) => void;\n  isImportingData: boolean;\n  nftAssets: NFTAsset[];\n  mintNFT: (name: string, imageUrl: string) => Promise<void>;\n  initiatePayment: (details: Omit<PaymentOperation, 'id' | 'status' | 'date'>) => void;\n  rewardItems: RewardItem[];\n  redeemReward: (item: RewardItem) => boolean;\n  apiStatus: APIStatus[];\n  creditFactors: CreditFactor[];\n  reownProjectId: string;\n  setReownProjectId: (id: string) => void;\n  counterparties: Counterparty[];\n  addCounterparty: (data: { name: string; email?: string; accountNumber: string; routingNumber: string }) => Promise<void>;\n  plaidClientId: string | null;\n  setPlaidClientId: (id: string) => void;\n  plaidSecret: string | null;\n  setPlaidSecret: (secret: string) => void;\n  modernTreasuryApiKey: string | null;\n  setModernTreasuryApiKey: (key: string) => void;\n  modernTreasuryOrganizationId: string | null;\n  setModernTreasuryOrganizationId: (id: string) => void;\n  stripeSecretKey: string | null;\n  setStripeSecretKey: (key: string) => void;\n  geminiApiKey: string | null;\n  setGeminiApiKey: (key: string) => void;\n}\n\nexport const DataContext = createContext<IDataContext | undefined>(undefined);\n\nexport const DataProvider = ({ children }: { children: ReactNode }) => {\n  const { address, isConnected } = useAccount();\n  const { signMessageAsync } = useSignMessage();\n  const { data: ethBalance } = useBalance({ address });\n\n  const [transactions, setTransactions] = useState<Transaction[]>(MOCK_TRANSACTIONS);\n  const [budgets, setBudgets] = useState<BudgetCategory[]>(MOCK_BUDGETS);\n  const [linkedAccounts, setLinkedAccounts] = useState<LinkedAccount[]>([]);\n  const [isImportingData, setIsImportingData] = useState(false);\n  const [virtualCard, setVirtualCard] = useState<VirtualCard | null>(null);\n  const [nftAssets, setNftAssets] = useState<NFTAsset[]>(() => {\n    const saved = localStorage.getItem('demai_sigil_vault');\n    return saved ? JSON.parse(saved) : [];\n  });\n  const [activeIllusion, setActiveIllusion] = useState<IllusionType>('none');\n  const [customBackgroundUrl, setCustomBackgroundUrl] = useState<string | null>(null);\n  const [counterparties, setCounterparties] = useState<Counterparty[]>(MOCK_COUNTERPARTIES);\n\n  const [plaidClientId, setPlaidClientId] = useState<string | null>(localStorage.getItem('demai_plaid_id'));\n  const [plaidSecret, setPlaidSecret] = useState<string | null>(localStorage.getItem('demai_plaid_secret'));\n  const [modernTreasuryApiKey, setModernTreasuryApiKey] = useState<string | null>(localStorage.getItem('demai_mt_key'));\n  const [modernTreasuryOrganizationId, setModernTreasuryOrganizationId] = useState<string | null>(localStorage.getItem('demai_mt_org'))