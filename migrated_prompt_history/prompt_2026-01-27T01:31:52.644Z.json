              "target": "",
              "replacement": "import React, { useState, useContext, useEffect } from 'react';\nimport { DataContext } from '../context/DataContext';\nimport { View } from '../types';\nimport { useAccount, useDisconnect } from 'wagmi';\n\nconst HeuristicAPIStatus: React.FC = () => {\n    const messages = [\n        \"Heuristic API: Actively analyzing portfolio...\",\n        \"Heuristic API: Monitoring market data...\",\n        \"Heuristic API: Identified 2 potential savings...\",\n        \"Heuristic API: All systems nominal.\",\n        \"Heuristic API: Cross-referencing spending patterns...\",\n        \"Heuristic API: Compiling weekly insights...\"\n    ];\n\n    const [currentMessageIndex, setCurrentMessageIndex] = useState(0);\n\n    useEffect(() => {\n        const interval = setInterval(() => {\n            setCurrentMessageIndex(prevIndex => (prevIndex + 1) % messages.length);\n        }, 4000);\n\n        return () => clearInterval(interval);\n    }, []);\n\n    return (\n        <div className=\"hidden lg:flex items-center space-x-2 text-xs text-cyan-300/80 bg-gray-900/40 px-3 py-1.5 rounded-full border border-cyan-500/10 transition-all duration-500\">\n            <div className=\"flex space-x-0.5 items-end h-4\">\n                <span className=\"w-1 h-1 bg-cyan-400 rounded-full animate-pulse [animation-delay:-0.3s]\"></span>\n                <span className=\"w-1 h-2 bg-cyan-400 rounded-full animate-pulse [animation-delay:-0.15s]\"></span>\n                <span className=\"w-1 h-3 bg-cyan-400 rounded-full animate-pulse\"></span>\n                <span className=\"w-1 h-2 bg-cyan-400 rounded-full animate-pulse [animation-delay:-0.15s]\"></span>\n                <span className=\"w-1 h-1 bg-cyan-400 rounded-full animate-pulse [animation-delay:-0.3s]\"></span>\n            </div>\n            <span className=\"font-mono\">{messages[currentMessageIndex]}</span>\n        </div>\n    );\n};\n\ninterface HeaderProps {\n    onMenuClick: () => void;\n    setActiveView: (view: View) => void;\n}\n\nconst Header: React.FC<HeaderProps> = ({ onMenuClick, setActiveView }) => {\n  const context = useContext(DataContext);\n  const [isNotificationsOpen, setIsNotificationsOpen] = useState(false);\n  const [isProfileOpen, setIsProfileOpen] = useState(false);\n  const { isConnected, address } = useAccount();\n  const { disconnect } = useDisconnect();\n\n  if (!context) {\n    throw new Error(\"Header must be used within a DataProvider\");\n  }\n\n  const { notifications, markNotificationRead } = context;\n  const unreadCount = notifications.filter(n => !n.read).length;\n  \n  const handleNotificationClick = (notification: typeof notifications[0]) => {\n      if (notification.view) {\n          setActiveView(notification.view);\n      }\n      markNotificationRead(notification.id);\n      setIsNotificationsOpen(false);\n  }\n\n  const handleSignInWithBase = async () => {\n    try {\n        if (!(window as any).demaiBaseSDK) return;\n        const provider = (window as any).demaiBaseSDK.getProvider();\n        const nonce = window.crypto.randomUUID().replace(/-/g, \"\");\n        \n        await provider.request({\n            method: \"wallet_connect\",\n            params: [\n                {\n                    version: \"1\",\n                    capabilities: {\n                        signInWithEthereum: {\n                            nonce,\n                            chainId: \"0x2105\", // Base Mainnet\n                        },\n                    },\n                },\n            ],\n        });\n        // Logic continues via wagmi/appkit state updates\n    } catch (error) {\n        console.error(\"Base Sign-in Error:\", error);\n    }\n  };\n\n  return (\n    <header className=\"py-4 px-6 bg-gray-900/30 backdrop-blur-md border-b border-gray-700/50 flex justify-between items-center z-20\">\n      <div className=\"flex items-center\">\n        <button onClick={onMenuClick} className=\"text-gray-400 focus:outline-none lg:hidden mr-4\">\n            <svg className=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M4 6h16M4 12h16M4 18h16\" />\n            </svg>\n        </button>\n        <h1 className=\"text-lg sm:text-xl font-black text-white tracking-tighter uppercase italic\">DEMAI <span className=\"text-cyan-400\">HUB</span></h1>\n      </div>\n      <div className=\"flex items-center space-x-5\">\n        <HeuristicAPIStatus />\n        <button \n            onClick={() => setActiveView(View.APIIntegration)}\n            className=\"text-gray-400 hover:text-cyan-400 transition-colors hidden sm:block\"\n            title=\"Infrastructure Registry\"\n        >\n            <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924-1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065zM15 12a3 3 0 11-6 0 3 3 0 016 0z\" />\n            </svg>\n        </button>\n        <div className=\"relative\">\n            <button onClick={() => setIsNotificationsOpen(prev => !prev)} className=\"text-gray-400 hover:text-white focus:outline-none\">\n              <svg className=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9\" />\n              </svg>\n              {unreadCount > 0 && (\n                  <span className=\"absolute top-0 right-0 block h-2 w-2 rounded-full bg-cyan-400 ring-2 ring-gray-900\"></span>\n              )}\n            </button>\n            {isNotificationsOpen && (\n                <div className=\"absolute right-0 mt-2 w-80 bg-gray-800 border border-gray-700 rounded-lg shadow-lg z-50\">\n                    <div className=\"p-3 font-semibold text-white border-b border-gray-700\">Notifications</div>\n                    <div className=\"max-h-96 overflow-y-auto\">\n                        {notifications.map(notification => (\n                            <div key={notification.id} onClick={() => handleNotificationClick(notification)} className={`p-3 text-sm flex items-start border-b border-gray-700/50 cursor-pointer ${notification.read ? 'opacity-60' : 'bg-cyan-500/10'}`}>\n                                {!notification.read && <div className=\"w-2 h-2 rounded-full bg-cyan-400 mt-1.5 flex-shrink-0\"></div>}\n                                <div className=\"ml-2\">\n                                    <p className=\"text-gray-200\">{notification.message}</p>\n                                    <p className=\"text-xs text-gray-400 mt-1\">{notification.timestamp}</p>\n                                </div>\n                            </div>\n                        ))}\n                    </div>\n                </div>\n            )}\n        </div>\n        <div className=\"relative\">\n            {isConnected ? (\n                <button onClick={() => setIsProfileOpen(prev => !prev)} className=\"flex items-center space-x-3\">\n                    <div className=\"w-10 h-10 rounded-full bg-gradient-to-br from-cyan-500 to-indigo-600 flex items-center justify-center border-2 border-cyan-400 shadow-lg shadow-cyan-900/30\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-6 w-6 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z\" />\n                        </svg>\n                    </div>\n                    <span className=\"hidden sm:block font-black text-white uppercase tracking-tighter italic\">\n                        {address?.slice(0,6)}...{address?.slice(-4)}\n                    </span>\n                </button>\n            ) : (\n                <button \n                    onClick={handleSignInWithBase}\n                    className=\"flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-xl font-black uppercase tracking-widest text-[10px] shadow-lg transition-all\"\n                >\n                    <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M12 24C18.6274 24 24 18.6274 24 12C24 5.37258 18.6274 0 12 0C5.37258 0 0 5.37258 0 12C0 18.6274 5.37258 24 12 24Z\" fill=\"white\"/></svg>\n                    Sign in with Base\n                </button>\n            )}\n            \n            {isProfileOpen && (\n                 <div className=\"absolute right-0 mt-2 w-48 bg-gray-800 border border-gray-700 rounded-lg shadow-lg z-50\">\n                     <a href=\"#\" onClick={(e)=>{e.preventDefault(); setActiveView(View.Settings); setIsProfileOpen(false);}} className=\"block px-4 py-2 text-sm text-gray-300 hover:bg-gray-700 font-bold uppercase tracking-widest italic\">Settings</a>\n                     <a href=\"#\" onClick={(e)=>{e.preventDefault(); disconnect(); setIsProfileOpen(false);}} className=\"block px-4 py-2 text-sm text-red-400 hover:bg-gray-700 font-bold uppercase tracking-widest italic\">Sign Out</a>\n                 </div>\n            )}\n        </div>\n      </div>\n    </header>\n  );\n};\n\nexport default Header;"
