case text-gray-500 tracking-[0.2em] ml-2\">Secret (Sandbox)</label>\n                                        <input type=\"password\" value={pSec} onChange={e => setPSec(e.target.value)} placeholder=\"Secret Key\" className=\"w-full bg-black border border-gray-800 rounded-2xl px-6 py-4 text-white focus:ring-2 focus:ring-cyan-500 outline-none\" />\n                                    </div>\n                                </div>\n                            )}\n                            {modal === 'stripe' && (\n                                <div className=\"space-y-2\">\n                                    <label className=\"text-[9px] font-black uppercase text-gray-500 tracking-[0.2em] ml-2\">Stripe Secret Key</label>\n                                    <input type=\"password\" value={sKey} onChange={e => setSKey(e.target.value)} placeholder=\"sk_test_...\" className=\"w-full bg-black border border-gray-800 rounded-2xl px-6 py-4 text-white focus:ring-2 focus:ring-cyan-500 outline-none\" />\n                                </div>\n                            )}\n                            {modal === 'reown' && (\n                                <div className=\"space-y-2\">\n                                    <label className=\"text-[9px] font-black uppercase text-gray-500 tracking-[0.2em] ml-2\">Project ID</label>\n                                    <input type=\"text\" value={reownId} onChange={e => setReownId(e.target.value)} placeholder=\"Project ID\" className=\"w-full bg-black border border-gray-800 rounded-2xl px-6 py-4 text-white focus:ring-2 focus:ring-cyan-500 outline-none\" />\n                                </div>\n                            )}\n                            <button onClick={handleSave} className=\"w-full py-5 bg-cyan-600 hover:bg-cyan-500 text-white font-black rounded-2xl transition-all shadow-xl shadow-cyan-900/40 uppercase tracking-[0.3em] mt-6 active:scale-95\">Synchronize Railset</button>\n                        </div>\n  