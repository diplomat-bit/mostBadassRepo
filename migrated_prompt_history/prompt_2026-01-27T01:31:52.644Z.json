              "target": "",
              "replacement": "\nimport React, { createContext, useState, ReactNode, useEffect, useCallback, useMemo } from 'react';\n// FIX: Added 'Type' to the import from @google/genai to resolve the missing export error from '../types'.\nimport { GoogleGenAI, Type } from \"@google/genai\";\nimport { useBalance, useAccount, useSignMessage } from \"wagmi\";\nimport type { \n  Transaction, Asset, BudgetCategory, GamificationState, IllusionType, \n  LinkedAccount, QuantumWeaverState, AIPlan, Subscription, \n  CreditScore, UpcomingBill, SavingsGoal, MarketMover, \n  FinancialGoal, CryptoAsset, VirtualCard, \n  PaymentOperation, AIInsight, CorporateCard, CorporateTransaction, \n  RewardPoints, Notification, NFTAsset, RewardItem, APIStatus, \n  CreditFactor, CorporateCardControls, Counterparty \n} from '../types';\n// FIX: Removed 'Type' from '../types' import as it is now imported from @google/genai.\nimport { WeaverStage } from '../types';\nimport { \n  MOCK_TRANSACTIONS, MOCK_ASSETS, MOCK_IMPACT_INVESTMENTS, MOCK_BUDGETS, \n  MOCK_SUBSCRIPTIONS, MOCK_CREDIT_SCORE, MOCK_UPCOMING_BILLS, MOCK_SAVINGS_GOALS, \n  MOCK_MARKET_MOVERS, MOCK_FINANCIAL_GOALS, MOCK_PAYMENT_OPERATIONS, \n  MOCK_CORPORATE_CARDS, MOCK_CORPORATE_TRANSACTIONS, MOCK_REWARD_POINTS, \n  MOCK_NOTIFICATIONS, MOCK_REWARD_ITEMS, MOCK_API_STATUS, MOCK_CREDIT_FACTORS \n} from '../data/mockData';\n\ninterface IDataContext {\n  transactions: Transaction[];\n  assets: Asset[];\n  impactInvestments: Asset[];\n  budgets: BudgetCategory[];\n  addBudget: (budget: Omit<BudgetCategory, 'id' | 'spent' | 'color'>) => void;\n  gamification: GamificationState;\n  impactData: { treesPlanted: number; spendingForNextTree: number; progressToNextTree: number; };\n  customBackgroundUrl: string | null;\n  setCustomBackgroundUrl: (url: string) => void;\n  addTransaction: (tx: Transaction) => void;\n  activeIllusion: IllusionType;\n  setActiveIllusion: (illusion: IllusionType) => void;\n  linkedAccounts: LinkedAccount[];\n  unlinkAccount: (id: string) => void;\n  handlePlaidSuccess: (publicToken: string, metadata: any) => Promise<void>;\n  getPlaidLinkToken: () => Promise<string | null>;\n  weaverState: QuantumWeaverState;\n  pitchBusinessPlan: (plan: string) => Promise<void>;\n  simulateTestPass: () => Promise<void>;\n  subscriptions: Subscription[];\n  creditScore: CreditScore;\n  upcomingBills: UpcomingBill[];\n  savingsGoals: SavingsGoal[];\n  marketMovers: MarketMover[];\n  financialGoals: FinancialGoal[];\n  addFinancialGoal: (goalData: Omit<FinancialGoal, 'id' | 'plan' | 'currentAmount'>) => void;\n  contributeToGoal: (goalId: string, amount: number) => void;\n  generateGoalPlan: (goalId: string) => Promise<void>;\n  cryptoAssets: CryptoAsset[];\n  importToken: (address: string) => Promise<void>;\n  paymentOperations: PaymentOperation[];\n  virtualCard: VirtualCard | null;\n  issueVirtualCard: () => Promise<void>;\n  buyCrypto: (usdAmount: number, cryptoTicker: string) => void;\n  aiInsights: AIInsight[];\n  isInsightsLoading: boolean;\n  corporateCards: CorporateCard[];\n  corporateTransactions: CorporateTransaction[];\n  toggleCorporateCardFreeze: (cardId: string) => void;\n  updateCorporateCard: (cardId: string, newControls: CorporateCardControls, newFrozenState: boolean) => void;\n  rewardPoints: RewardPoints;\n  notifications: Notification[];\n  markNotificationRead: (id: string) => void;\n  isImportingData: boolean;\n  nftAssets: NFTAsset[];\n  mintNFT: (name: string, imageUrl: string) => Promise<void>;\n  initiatePayment: (details: Omit<PaymentOperation, 'id' | 'status' | 'date'>) => void;\n  rewardItems: RewardItem[];\n  redeemReward: (item: RewardItem) => boolean;\n  apiStatus: APIStatus[];\n  creditFactors: CreditFactor[];\n  reownProjectId: string;\n  counterparties: Counterparty[];\n  addCounterparty: (data: { name: string; email?: string; accountNumber: string; routingNumber: string }) => Promise<void>;\n}\n\nexport const DataContext = createContext<IDataContext | undefined>(undefined);\n\nexport const DataProvider = ({ children }: { children?: ReactNode }) => {\n  const { address, isConnected } = useAccount();\n  const { signMessageAsync } = useSignMessage();\n  const { data: ethBalance } = useBalance({ address });\n\n  const [transactions, setTransactions] = useState<Transaction[]>(MOCK_TRANSACTIONS);\n  const [budgets, setBudgets] = useState<BudgetCategory[]>(MOCK_BUDGETS);\n  const [linkedAccounts, setLinkedAccounts] = useState<LinkedAccount[]>([]);\n  const [isImportingData, setIsImportingData] = useState(false);\n  const [virtualCard, setVirtualCard] = useState<VirtualCard | null>(null);\n  const [nftAssets, setNftAssets] = useState<NFTAsset[]>([]);\n  const [weaverState, setWeaverState] = useState<QuantumWeaverState>({\n    stage: WeaverStage.Pitch,\n    businessPlan: '',\n    feedback: '',\n    questions: [],\n    loanAmount: 0,\n    coachingPlan: null,\n    error: null\n  });\n\n  const ai = useMemo(() => new GoogleGenAI({ apiKey: process.env.API_KEY }), []);\n\n  const pitchBusinessPlan = async (plan: string) => {\n    setWeaverState(prev => ({ ...prev, stage: WeaverStage.Analysis, businessPlan: plan }));\n    try {\n      const response = await ai.models.generateContent({\n        model: 'gemini-3-pro-preview',\n        contents: `You are a Tier-1 Venture Capital Analyst. Critically evaluate this business plan: \"${plan}\". \n        Provide constructive feedback and 3 high-stakes evaluation questions. \n        Format your response EXCLUSIVELY as JSON.`,\n        config: { \n            responseMimeType: 'application/json',\n            // FIX: Updated responseSchema to use Type enum for better compliance and readability.\n            responseSchema: {\n                type: Type.OBJECT,\n                properties: {\n                    feedback: { type: Type.STRING },\n                    questions: { \n                        type: Type.ARRAY, \n                        items: { \n                            type: Type.OBJECT,\n                            properties: {\n                                id: { type: Type.STRING },\n                                question: { type: Type.STRING },\n                                category: { type: Type.STRING }\n                            }\n                        }\n                    }\n                }\n            }\n        }\n      });\n      const data = JSON.parse(response.text || '{}');\n      setWeaverState(prev => ({ \n        ...prev, \n        stage: WeaverStage.Test, \n        feedback: data.feedback, \n        questions: data.questions \n      }));\n    } catch (e) {\n      setWeaverState(prev => ({ ...prev, stage: WeaverStage.Error, error: \"Synapse Failure: The VC node is unreachable.\" }));\n    }\n  };\n\n  const simulateTestPass = async () => {\n    setWeaverState(prev => ({ ...prev, stage: WeaverStage.FinalReview }));\n    try {\n      const response = await ai.models.generateContent({\n        model: 'gemini-3-pro-preview',\n        contents: `The founder has passed the evaluation for: \"${weaverState.businessPlan}\". \n        Generate a 6-month hyper-growth roadmap and a summary of why they were funded. \n        Format as JSON.`,\n        config: { \n            responseMimeType: 'application/json',\n            // FIX: Updated responseSchema to use Type enum for consistency and SDK compliance.\n            responseSchema: {\n                type: Type.OBJECT,\n                properties: {\n                    title: { type: Type.STRING },\n                    summary: { type: Type.STRING },\n                    steps: { \n                        type: Type.ARRAY, \n                        items: { \n                            type: Type.OBJECT,\n                            properties: {\n                                title: { type: Type.STRING },\n                                description: { type: Type.STRING },\n                                timeline: { type: Type.STRING }\n                            }\n                        }\n                    }\n                }\n            }\n        }\n      });\n      const plan = JSON.parse(response.text || '{}');\n      setWeaverState(prev => ({ \n        ...prev, \n        stage: WeaverStage.Approved, \n        loanAmount: Math.floor(Math.random() * 250000) + 50000,\n        coachingPlan: plan \n      }));\n    } catch (e) {\n      setWeaverState(prev => ({ ...prev, stage: WeaverStage.Error, error: \"Capital Allocation Failure: Treasury rejected the transaction.\" }));\n    }\n  };\n\n  const mintNFT = async (name: string, imageUrl: string) => {\n    if (!isConnected) throw new Error(\"Cryptographic Identity Missing: Connect your wallet to bridge visuals to the chain.\");\n    \n    // Simulating the on-chain signature/broadcast phase with a real request to the wallet\n    await signMessageAsync({ \n      message: `AUTHORIZE_MINT_PROTOCOL\\nAsset: ${name}\\nAnchor: ${imageUrl.substring(0, 30)}...\\nTimestamp: ${Date.now()}` \n    });\n\n    const newNFT: NFTAsset = {\n        id: `nft-${Date.now()}`,\n        name,\n        imageUrl,\n        contractAddress: '0xDemai_Forge_Sovereign_v1'\n    };\n    setNftAssets(prev => [newNFT, ...prev]);\n  };\n\n  const cryptoAssets = useMemo(() => {\n    const assets: CryptoAsset[] = [];\n    if (isConnected && ethBalance) {\n      assets.push({ ticker: 'ETH', name: 'Ethereum', amount: parseFloat(ethBalance.formatted), value: parseFloat(ethBalance.formatted) * 3250, color: '#627eea' });\n    }\n    return assets;\n  }, [isConnected, ethBalance]);\n\n  return (\n    <DataContext.Provider value={{\n      transactions, assets: MOCK_ASSETS, impactInvestments: MOCK_IMPACT_INVESTMENTS, budgets,\n      addBudget: (b) => setBudgets(prev => [...prev, { ...b, id: Date.now().toString(), spent: 0, color: '#06b6d4' }]),\n      gamification: { score: 999, level: 5, levelName: 'System Architect', progress: 100, credits: 5000 },\n      impactData: { treesPlanted: 50, spendingForNextT