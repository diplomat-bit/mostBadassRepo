t = useContext(DataContext);\n    if (!context) throw new Error(\"Synapse Violation: DataContext unreachable.\");\n\n    const [messages, setMessages] = useState<any[]>(() => {\n        const saved = localStorage.getItem('quantum_intelligence_log');\n        return saved ? JSON.parse(saved) : [{ role: 'model', parts: [{ text: \"Quantum Core Synchronized. Identity verified via Sovereign Anchor. Command established.\" }] }];\n    });\n    const [input, setInput] = useState('');\n    const [isThinking, setIsThinking] = useState(false);\n    const chatRef = useRef<Chat | null>(null);\n    const scrollRef = useRef<HTMLDivElement>(null);\n\n    useEffect(() => {\n        if (scrollRef.current) scrollRef.current.scrollTop = scrollRef.current.scrollHeight;\n        localStorage.setItem('quantum_intelligence_log', JSON.stringify(messages));\n    }, [messages]);\n\n    useEffect(() => {\n        if (!chatRef.current && context?.reownProjectId) {\n            const ai = new GoogleGenAI({ apiKey: process.env.API_KEY || '' });\n            chatRef.current = ai.chats.create({\n                model: 'gemini-3-pro-preview',\n                config: { \n                    systemInstruction: DETAILED_SYSTEM_INSTRUCTION, \n                    tools: toolDefinitions \n                }\n            });\n        }\n    }, [context]);\n\n    const executeTool = async (call: any) => {\n        if (call.name === 'getFinancialSummary') {\n            const fiat = context.assets.reduce((s, a) => s + a.value, 0);\n            const crypto = context.cryptoAssets.reduce((s, a) => s + a.value, 0);\n            return { totalNetWorth: fiat + crypto, fiatHoldings: fiat, cryptoHoldings: crypto, status: 'NOMINAL', activeLedgers: context.linkedAccounts.length };\n        }\n        if (call.name === 'mintCreativeNFT') {\n            return { status: 'FORGE_READY', message: `Quantum has initialized forge parameters for '${call.args.assetName}'. Final identity signature required in Web3 Nexus.` };\n        }\n        return { error: \"Access Denied: Tool node unreachable.\" };\n    };\n\n    const handleSend = async () => {\n        if (!input.trim() || !chatRef.current) return;\n        const userMsg = { role: 'user', parts: [{ text: input }] };\n        setMessages(prev => [...prev, userMsg]);\n        setInput('');\n        setIsThinking(true);\n\n        try {\n            let response = await chatRef.current.sendMessage({ message: input });\n            \n            while (response.functionCalls && response.functionCalls.length > 0) {\n                const results = [];\n                for (const call of response.functionCalls) {\n                    const result = await executeTool(call);\n                    results.push({\n                        functionResponse: { name: call.name, response: result, id: call.id }\n                    });\n                }\n                response = await chatRef.current.sendMessage({ message: results });\n            }\n\n            setMessages(prev => [...prev, { role: 'model', parts: [{ text: response.text || \"Protocol executed. Data synchronized.\" }] }]);\n        } catch (e) {\n            console.error(e);\n            setMessages(prev => [...prev, { role: 'model', parts: [{ text: \"Quantum detected a logic bottleneck. Handshake refreshed.\" }] }]);\n        } finally {\n            setIsThinking(false);\n        }\n    };\n\n    return (\n        <div className=\"h-full flex flex-col\">\n            <header className=\"mb-8\">\n                <h2 className=\"text-4xl font-black text-white tracking-tighter uppercase italic\">Quantum <span className=\"text-cyan-500\">Intelligence</span></h2>\n                <p className=\"text-[9px] font-black text-gray-600 uppercase tracking-[0.5em] mt-2\">Master Directive Node: Gemini-3-Pro</p>\n            </header>\n\n            <Card className=\"flex-1 flex flex-col bg-black/40 border-gray-800\" padding=\"none\">\n                <div ref={scrollRef} className=\"flex-1 p-8 space-y-8 overflow-y-auto custom-scrollbar\">\n                    {messages.map((msg, i) => (\n                        <div key={i} className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}>\n                            <div className={`max-w-2xl p-6 rounded-[2.5rem] text-sm font-bold tracking-tight leading-relaxed shadow-2xl\n                                ${msg.role === 'user' \n                                    ? 'bg-cyan-600 text-white rounded-br-none' \n                                    : 'bg-gray-900 text-gray-200 border border-gray-800 rounded-bl-none'\n                                }`}\n                            >\n                                {msg.parts[0].text}\n                            </div>\n                        </div>\n                    ))}\n                    {isThinking && (\n                        <div className=\"flex items-center gap-3 p-4 text-cyan-400 font-black uppercase italic text-xs tracking-widest animate-pulse\">\n                            <span className=\"w-2 h-2 bg-cyan-500 rounded-full\"></span>\n                            Quantum Thinking...\n                        </div>\n                    )}\n                </div>\n\n                <div className=\"p-6 bg-black border-t border-gray-800 flex gap-4\">\n                    <input \n                        value={input} \n                        onChange={e => setInput(e.target.value)} \n                        onKeyDown={e => e.key === 'Enter' && handleSend()} \n                        placeholder=\"Direct directive to core intelligence...\" \n                        className=\"flex-1 bg-gray-900 border border-gray-800 rounded-2xl px-8 py-5 text-white font-bold italic focus:ring-2 focus:ring-cyan-500 outline-none transition-all\" \n                    />\n                    <button \n                        onClick={handleSend} \n                        className=\"bg-cyan-600 px-12 rounded-2xl font-black text-white uppercase tracking-widest italic hover:bg-cyan-500 transition-all active:scale-95 shadow-lg shadow-cyan-900/20\"\n                    >\n                        Issue\n                    </button>\n                </div>\n            </Card>\n        </div>\n    );\n};\n\nexport default AIAdvisorView;"
