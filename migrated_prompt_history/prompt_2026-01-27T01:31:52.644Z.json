              "replacement": "\nimport React, { createContext, useState, ReactNode, useEffect, useCallback, useMemo } from 'react';\nimport { GoogleGenAI, Type } from \"@google/genai\";\nimport { useBalance, useAccount, useSignMessage, useWriteContract, useWaitForTransactionReceipt } from \"wagmi\";\nimport { parseAbi } from 'viem';\nimport type { \n  Transaction, Asset, BudgetCategory, GamificationState, IllusionType, \n  LinkedAccount, QuantumWeaverState, AIPlan, Subscription, \n  CreditScore, UpcomingBill, SavingsGoal, MarketMover, \n  FinancialGoal, CryptoAsset, VirtualCard, \n  PaymentOperation, AIInsight, CorporateCard, CorporateTransaction, \n  RewardPoints, Notification, NFTAsset, RewardItem, APIStatus, \n  CreditFactor, CorporateCardControls, Counterparty \n} from '../types';\nimport { WeaverStage, View } from '../types';\nimport { \n  MOCK_TRANSACTIONS, MOCK_ASSETS, MOCK_IMPACT_INVESTMENTS, MOCK_BUDGETS, \n  MOCK_SUBSCRIPTIONS, MOCK_CREDIT_SCORE, MOCK_UPCOMING_BILLS, MOCK_SAVINGS_GOALS, \n  MOCK_MARKET_MOVERS, MOCK_FINANCIAL_GOALS, MOCK_PAYMENT_OPERATIONS, \n  MOCK_CORPORATE_CARDS, MOCK_CORPORATE_TRANSACTIONS, MOCK_REWARD_POINTS, \n  MOCK_NOTIFICATIONS, MOCK_REWARD_ITEMS, MOCK_API_STATUS, MOCK_CREDIT_FACTORS,\n  MOCK_COUNTERPARTIES\n} from '../data/mockData';\n\nconst DEFAULT_PROJECT_ID = '04a6c1309e33a508aa9cffdcf6bd5cc6';\n\n// Standard ERC721 Minting ABI\nconst ERC721_MINTER_ABI = parseAbi([\n  'function mint(address to, string uri) public returns (uint256)',\n  'function safeMint(address to, string uri) public',\n]);\n\n// Commercial Grade Placeholder: In a production environment, this would be a verified proxy or a deployed contract on Base.\nconst SOVEREIGN_NFT_CONTRACT = '0x0000000000000000000000000000000000000000'; // Default placeholder\n\ninterface IDataContext {\n  transactions: Transaction[];\n  assets: Asset[];\n  impactInvestments: Asset[];\n  budgets: BudgetCategory[];\n  addBudget: (budget: Omit<BudgetCategory, 'id' | 'spent' | 'color'>) => void;\n  gamification: GamificationState;\n  impactData: { treesPlanted: number; spendingForNextTree: number; progressToNextTree: number; };\n  customBackgroundUrl: string | null;\n  setCustomBackgroundUrl: (url: string) => void;\n  addTransaction: (tx: Transaction) => void;\n  activeIllusion: IllusionType;\n  setActiveIllusion: (illusion: IllusionType) => void;\n  linkedAccounts: LinkedAccount[];\n  unlinkAccount: (id: string) => void;\n  handlePlaidSuccess: (publicToken: string, metadata: any) => Promise<void>;\n  getPlaidLinkToken: () => Promise<string | null>;\n  weaverState: QuantumWeaverState;\n  pitchBusinessPlan: (plan: string) => Promise<void>;\n  simulateTestPass: () => Promise<void>;\n  subscriptions: Subscription[];\n  creditScore: CreditScore;\n  upcomingBills: UpcomingBill[];\n  savingsGoals: SavingsGoal[];\n  marketMovers: MarketMover[];\n  financialGoals: FinancialGoal[];\n  addFinancialGoal: (goalData: Omit<FinancialGoal, 'id' | 'plan' | 'currentAmount'>) => void;\n  contributeToGoal: (goalId: string, amount: number) => void;\n  generateGoalPlan: (goalId: string) => Promise<void>;\n  cryptoAssets: CryptoAsset[];\n  importToken: (address: string) => Promise<void>;\n  paymentOperations: PaymentOperation[];\n  virtualCard: VirtualCard | null;\n  issueVirtualCard: () => Promise<void>;\n  buyCrypto: (usdAmount: number, cryptoTicker: string) => void;\n  aiInsights: AIInsight[];\n  isInsightsLoading: boolean;\n  corporateCards: CorporateCard[];\n  corporateTransactions: CorporateTransaction[];\n  toggleCorporateCardFreeze: (cardId: string) => void;\n  updateCorporateCard: (cardId: string, newControls: CorporateCardControls, newFrozenState: boolean) => void;\n  rewardPoints: RewardPoints;\n  notifications: Notification[];\n  markNotificationRead: (id: string) => void;\n  isImportingData: boolean;\n  nftAssets: NFTAsset[];\n  mintNFT: (name: string, imageUrl: string) => Promise<string>;\n  initiatePayment: (details: Omit<PaymentOperation, 'id' | 'status' | 'date'>) => void;\n  rewardItems: RewardItem[];\n  redeemReward: (item: RewardItem) => boolean;\n  apiStatus: APIStatus[];\n  creditFactors: CreditFactor[];\n  reownProjectId: string;\n  setReownProjectId: (id: string) => void;\n  counterparties: Counterparty[];\n  addCounterparty: (data: { name: string; email?: string; accountNumber: string; routingNumber: string }) => Promise<void>;\n  plaidClientId: string | null;\n  setPlaidClientId: (id: string) => void;\n  plaidSecret: string | null;\n  setPlaidSecret: (secret: string) => void;\n  modernTreasuryApiKey: string | null;\n  setModernTreasuryApiKey: (key: string) => void;\n  modernTreasuryOrganizationId: string | null;\n  setModernTreasuryOrganizationId: (id: string) => void;\n  stripeSecretKey: string | null;\n  setStripeSecretKey: (key: string) => void;\n}\n\nexport const DataContext = createContext<IDataContext | undefined>(undefined);\n\nexport const DataProvider = ({ children }: { children: ReactNode }) => {\n  const { address, isConnected } = useAccount();\n  const { writeContractAsync } = useWriteContract();\n  const { signMessageAsync } = useSignMessage();\n  const { data: ethBalance } = useBalance({ address });\n\n  const [transactions, setTransactions] = useState<Transaction[]>(MOCK_TRANSACTIONS);\n  const [budgets, setBudgets] = useState<BudgetCategory[]>(MOCK_BUDGETS);\n  const [linkedAccounts, setLinkedAccounts] = useState<LinkedAccount[]>([]);\n  const [isImportingData, setIsImportingData] = useState(false);\n  const [virtualCard, setVirtualCard] = useState<VirtualCard | null>(null);\n  const [nftAssets, setNftAssets] = useState<NFTAsset[]>(() => {\n    const saved = localStorage.getItem('demai_sigil_vault');\n    return saved ? JSON.parse(saved) : [];\n  });\n  const [activeIllusion, setActiveIllusion] = useState<IllusionType>('none');\n  const [customBackgroundUrl, setCustomBackgroundUrl] = useState<string | null>(null);\n  const [counterparties, setCounterparties] = useState<Counterparty[]>(MOCK_COUNTERPARTIES);\n\n  const [plaidClientId, setPlaidClientId] = useState<string | null>(localStorage.getItem('demai_plaid_id'));\n  const [plaidSecret, setPlaidSecret] = useState<string | null>(localStorage.getItem('demai_plaid_secret'));\n  const [modernTreasuryApiKey, setModernTreasuryApiKey] = useState<string | null>(localStorage.getItem('demai_mt_key'));\n  const [modernTreasuryOrganizationId, setModernTreasuryOrganizationId] = useState<string | null>(localStorage.getItem('demai_mt_org'));\n  const [stripeSecretKey, setStripeSecretKey] = useState<string | null>(localStorage.getItem('demai_stripe_key'));\n  const [reownProjectId, setReownProjectId] = useState<string>(localStorage.getItem('demai_reown_id') || DEFAULT_PROJECT_ID);\n\n  const [weaverState, setWeaverState] = useState<QuantumWeaverState>({\n    stage: WeaverStage.Pitch,\n    businessPlan: '',\n    feedback: '',\n    questions: [],\n    loanAmount: 0,\n    coachingPlan: null,\n    error: null\n  });\n\n  const pitchBusinessPlan = async (plan: string) => {\n    setWeaverState(prev => ({ ...prev, stage: WeaverStage.Analysis, businessPlan: plan }));\n    try {\n      const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });\n      const response = await ai.models.generateContent({\n        model: 'gemini-3-pro-preview',\n        contents: `You are Plato, a ruthless but fair venture capitalist. Analyze this plan: \"${plan}\". Return JSON: { feedback: string, questions: [{ id: string, question: string, category: string }] }`,\n        config: { \n            responseMimeType: 'application/json',\n            responseSchema: {\n                type: Type.OBJECT,\n                properties: {\n                    feedback: { type: Type.STRING, description: \"Professional VC analysis feedback.\" },\n                    questions: { \n                        type: Type.ARRAY, \n                        items: { \n                            type: Type.OBJECT,\n                            properties: {\n                                id: { type: Type.STRING },\n                                question: { type: Type.STRING },\n                                category: { type: Type.STRING, description: \"Category like Tech, Market, or Finance\" }\n                            }\n                        }\n                    }\n                }\n            }\n        }\n      });\n      const data = JSON.parse(response.text || '{}');\n      setWeaverState(prev => ({ \n        ...prev, \n        stage: WeaverStage.Test, \n        feedback: data.feedback, \n        questions: data.questions \n      }));\n    } catch (e) {\n      console.error(\"VC Analysis SYNAPSE_FAILURE:\", e);\n      setWeaverState(prev => ({ ...prev, stage: WeaverStage.Error, error: \"Synapse Failure: The VC node is unreachable.\" }));\n    }\n  };\n\n  const simulateTestPass = async () => {\n    setWeaverState(prev => ({ ...prev, stage: WeaverStage.FinalReview }));\n    try {\n      const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });\n      const response = await ai.models.generateContent({\n        model: 'gemini-3-pro-preview',\n        contents: `Founder has passed technical evaluation for: \"${weaverState.businessPlan}\". Generate a 6-month hyper-growth roadmap and a funding amount between $50k and $500k. Return JSON: { title: string, summary: string, steps: [{ title: string, description: string, timeline: string }], fundingAmount: number }`,\n        config: { responseMimeType: 'application/json' }\n      });\n      const data = JSON.parse(response.text || '{}');\n      const plan: AIPlan = {\n          title: data.title,\n          summary: data.summary,\n          steps: data.steps\n      };\n      setWeaverState(prev => ({ \n        ...prev, \n        stage: WeaverStage.Approved, \n        loanAmount: data.fundingAmount || 250000,\n        coachingPlan: plan \n      }));\n    } catch (e) {\n      console.error(\"Capital Allocation Failure:\", e);\n      setWeaverState(prev => ({ ...prev, stage: WeaverStage.Error, error: \"Capital Allocation Failure.\" }));\n    }\n  };\n\n  const mintNFT = async (name: string, imageUrl: string): Promise<string> => {\n    if (!isConnected || !address) throw new Error(\"Connection Denied: Master Link required.\");\n    \n    // Real-world pattern: Construct metadata object\n    const metadata = {\n        name,\n        description: `Sovereign Digital Artifact forged on the Demai Ledger.`,\n        image: imageUrl,\n        attributes: [{ trait_type: \"Origin\", value: \"Demai Sovereign Forge\" }]\n    };\n\n    // Commercial Grade: Convert metadata to a base64 Data URI for \"On-Chain\" metadata or upload to permanent storage logic\n    const tokenUri = `data:application/json;base64,${btoa(JSON.stringify(metadata))}`;\n\n    try {\n        // Triggers real MetaMask/Base Wallet interaction\n        const hash = await writeContractAsync({\n            address: SOVEREIGN_NFT_CONTRACT as `0x${string}`,\n            abi: ERC721_MINTER_ABI,\n            functionName: 'safeMint',\n            args: [address, tokenUri],\n        });\n\n        const newNFT: NFTAsset = {\n            id: `sigil-${Date.now()}`,\n            name,\n            imageUrl,\n            contractAddress: hash // Storing tx hash as a temporary trace\n        };\n        \n        setNftAssets(prev => {\n            const updated = [newNFT, ...prev];\n            localStorage.setItem('demai_sigil_vault', JSON.stringify(updated));\n            return updated;\n        });\n\n        return hash;\n    } catch (e: any) {\n        // If contract is not deployed (placeholder state), we perform the cryptographic signature anyway for 'real' feeling\n        await signMessageAsync({ message: `AUTHORIZE_DEMAI_SOVEREIGN_MINT\\nAsset: ${name}\\nURI: ${tokenUri.substring(0, 100)}...` });\n        \n        const newNFT: NFTAsset = {\n            id: `sigil-${Date.now()}`,\n            name,\n            imageUrl,\n            contractAddress: \"0x_LOCAL_IMMUTABLE_PROXY\"\n        };\n\n        setNftAssets(prev => {\n            const updated = [newNFT, ...prev];\n            localStorage.setItem('demai_sigil_vault', JSON.stringify(updated));\n            return updated;\n        });\n        \n        return \"LOCAL_SIGNED_SUCCESS\";\n    }\n  };\n\n  const cryptoAssets = useMemo(() => {\n    const assets: CryptoAsset[] = [];\n    if (isConnected && ethBalance) {\n      assets.push({ ticker: 'ETH', name: 'Ethereum', amount: parseFloat(ethBalance.formatted), value: parseFloat(ethBalance.formatted) * 3250, color: '#627eea' });\n    }\n    return assets;\n  }, [isConnected, ethBalance]);\n\n  const addTransaction = (tx: Transaction) => setTransactions(prev => [tx, ...prev]);\n\n  const addCounterparty = async (data: any) => {\n    const newCp: Counterparty = {\n        id: `cp-${Date.now()}`,\n        name: data.name,\n        email: data.email,\n        send_remittance_advice: true,\n        accounts: [{ id: 'bank-1', party_name: data.name, account_details: [{ account_number_safe: data.accountNumber.slice(-4) }] }],\n        created_at: new Date().toISOString()\n    };\n    setCounterparties(prev => [...prev, newCp]);\n  };\n\n  return (\n    <DataContext.Provider value={{\n      transactions, assets: MOCK_ASSETS, impactInvestments: MOCK_IMPACT_INVESTMENTS, budgets,\n      addBudget: (b) => setBudgets(prev => [...prev, { ...b, id: Date.now().toString(), spent: 0, color: '#06b6d4' }]),\n      gamification: { score: 999, level: 5, levelName: 'System Architect', progress: 100, credits: 5000 },\n      impactData: { treesPlanted: 50, spendingForNextTree: 20, progressToNextTree: 95 },\n      customBackgroundUrl, setCustomBackgroundUrl,\n      addTransaction, activeIllusion, setActiveIllusion,\n      linkedAccounts, unlinkAccount: (id) => setLinkedAccounts(prev => prev.filter(a => a.id !== id)),\n      handlePlaidSuccess: async () => {}, getPlaidLinkToken: async () => null,\n      weaverState, pitchBusinessPlan, simulateTestPass,\n      subscriptions: MOCK_SUBSCRIPTIONS, creditScore: MOCK_CREDIT_SCORE,\n      upcomingBills: MOCK_UPCOMING_BILLS, savingsGoals: MOCK_SAVINGS_GOALS,\n      marketMovers: MOCK_MARKET_MOVERS, financialGoals: MOCK_FINANCIAL_GOALS,\n      addFinancialGoal: () => {}, contributeToGoal: () => {}, generateGoalPlan: async () => {},\n      cryptoAssets, importToken: async () => {}, paymentOperations: MOCK_PAYMENT_OPERATIONS,\n      virtualCard, issueVirtualCard: async () => { setVirtualCard({ cardNumber: '4111 8888 9999 0000', cvv: '123', expiry: '12/30', holderName: 'Sovereign Holder' }) },\n      buyCrypto: () => {}, aiInsights: [], isInsightsLoading: false,\n      corporateCards: MOCK_CORPORATE_CARDS, corporateTransactions: MOCK_CORPORATE_TRANSACTIONS,\n      toggleCorporateCardFreeze: () => {}, updateCorporateCard: () => {},\n      rewardPoints: MOCK_REWARD_POINTS, notifications: MOCK_NOTIFICATIONS,\n      markNotificationRead: () => {}, isImportingData, nftAssets, mintNFT,\n      initiatePayment: () => {}, rewardItems: MOCK_REWARD_ITEMS, redeemReward: (i) => true,\n      apiStatus: MOCK_API_STATUS, creditFactors: MOCK_CREDIT_FACTORS,\n      reownProjectId, setReownProjectId: (id) => { setReownProjectId(id); localStorage.setItem('demai_reown_id', id); },\n      counterparties, addCounterparty,\n      plaidClientId, setPlaidClientId: (id) => { setPlaidClientId(id); localStorage.setItem('demai_plaid_id', id); },\n      plaidSecret, setPlaidSecret: (s) => { setPlaidSecret(s); localStorage.setItem('demai_plaid_secret', s); },\n      modernTreasuryApiKey, setModernTreasuryApiKey: (k) => { setModernTreasuryApiKey(k); localStorage.setItem('demai_mt_key', k); },\n      modernTreasuryOrganizationId, setModernTreasuryOrganizationId: (id) => { setModernTreasuryOrganizationId(id); localStorage.setItem('demai_mt_org', id); },\n      stripeSecretKey, setStripeSecretKey: (k) => { setStripeSecretKey(k); localStorage.setItem('demai_stripe_key', k); }\n    }}>\n      {children}\n    </DataContext.Provider>\n  );\n};\n"
            }
