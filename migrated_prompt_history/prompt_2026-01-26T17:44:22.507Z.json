              "target": "",
              "replacement": "import React, { createContext, useState, ReactNode, useEffect, useCallback } from 'react';\nimport { GoogleGenAI } from \"@google/genai\";\nimport { useBalance } from \"wagmi\";\nimport { useAppKitAccount } from \"@reown/appkit/react\";\nimport type { \n  Transaction, Asset, BudgetCategory, GamificationState, IllusionType, \n  LinkedAccount, QuantumWeaverState, AIPlan, AIQuestion, Subscription, \n  CreditScore, UpcomingBill, SavingsGoal, MarketMover, MarketplaceProduct, \n  FinancialGoal, AIGoalPlan, Contribution, CryptoAsset, VirtualCard, \n  PaymentOperation, AIInsight, CorporateCard, CorporateTransaction, \n  RewardPoints, Notification, NFTAsset, RewardItem, APIStatus, \n  CreditFactor, CorporateCardControls, Counterparty \n} from '../types';\nimport { WeaverStage } from '../types';\nimport { \n  MOCK_TRANSACTIONS, MOCK_ASSETS, MOCK_IMPACT_INVESTMENTS, MOCK_BUDGETS, \n  MOCK_SUBSCRIPTIONS, MOCK_CREDIT_SCORE, MOCK_UPCOMING_BILLS, MOCK_SAVINGS_GOALS, \n  MOCK_MARKET_MOVERS, MOCK_FINANCIAL_GOALS, MOCK_PAYMENT_OPERATIONS, \n  MOCK_CORPORATE_CARDS, MOCK_CORPORATE_TRANSACTIONS, MOCK_REWARD_POINTS, \n  MOCK_NOTIFICATIONS, MOCK_REWARD_ITEMS, MOCK_API_STATUS, MOCK_CREDIT_FACTORS \n} from '../data/mockData';\n\n// Centralized AI Service following @google/genai strict guidelines\nexport const AIService = {\n    async generateContent(model: string, contents: any, config?: any) {\n        const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });\n        return await ai.models.generateContent({ model, contents, config });\n    },\n    async generateImages(model: string, prompt: string, config?: any) {\n        const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });\n        return await ai.models.generateImages({ model, prompt, config });\n    },\n    async generateVideos(model: string, prompt: string, config?: any) {\n        const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });\n        return await ai.models.generateVideos({ model, prompt, config });\n    }\n};\n\ninterface IDataContext {\n  transactions: Transaction[];\n  assets: Asset[];\n  impactInvestments: Asset[];\n  budgets: BudgetCategory[];\n  addBudget: (budget: Omit<BudgetCategory, 'id' | 'spent' | 'color'>) => void;\n  gamification: GamificationState;\n  impactData: {\n    treesPlanted: number;\n    spendingForNextTree: number;\n    progressToNextTree: number;\n  };\n  customBackgroundUrl: string | null;\n  setCustomBackgroundUrl: (url: string) => void;\n  addTransaction: (tx: Transaction) => void;\n  activeIllusion: IllusionType;\n  setActiveIllusion: (illusion: IllusionType) => void;\n  linkedAccounts: LinkedAccount[];\n  unlinkAccount: (id: string) => void;\n  handlePlaidSuccess: (publicToken: string, metadata: any) => Promise<void>;\n  getPlaidLinkToken: () => Promise<string | null>;\n  weaverState: QuantumWeaverState;\n  pitchBusinessPlan: (plan: string) => Promise<void>;\n  simulateTestPass: () => Promise<void>;\n  subscriptions: Subscription[];\n  creditScore: CreditScore;\n  upcomingBills: UpcomingBill[];\n  savingsGoals: SavingsGoal[];\n  marketMovers: MarketMover[];\n  financialGoals: FinancialGoal[];\n  addFinancialGoal: (goalData: Omit<FinancialGoal, 'id' | 'plan' | 'currentAmount'>) => void;\n  contributeToGoal: (goalId: string, amount: number) => void;\n  generateGoalPlan: (goalId: string) => Promise<void>;\n  cryptoAssets: CryptoAsset[];\n  setCryptoAssets: React.Dispatch<React.SetStateAction<CryptoAsset[]>>;\n  paymentOperations: PaymentOperation[];\n  virtualCard: VirtualCard | null;\n  issueCard: () => void;\n  buyCrypto: (usdAmount: number, cryptoTicker: string) => void;\n  aiInsights: AIInsight[];\n  isInsightsLoading: boolean;\n  corporateCards: CorporateCard[];\n  corporateTransactions: CorporateTransaction[];\n  toggleCorporateCardFreeze: (cardId: string) => void;\n  updateCorporateCard: (cardId: string, newControls: CorporateCardControls, newFrozenState: boolean) => void;\n  rewardPoints: RewardPoints;\n  notifications: Notification[];\n  markNotificationRead: (id: string) => void;\n  isImportingData: boolean;\n  nftAssets: NFTAsset[];\n  mintNFT: (name: string, imageUrl: string) => void;\n  initiatePayment: (details: Omit<PaymentOperation, 'id' | 'status' | 'date'>) => void;\n  rewardItems: RewardItem[];\n  redeemReward: (item: RewardItem) => boolean;\n  apiStatus: APIStatus[];\n  creditFactors: CreditFactor[];\n  modernTreasuryApiKey: string | null;\n  setModernTreasuryApiKey: (key: string) => void;\n  modernTreasuryOrganizationId: string | null;\n  setModernTreasuryOrganizationId: (id: string) => void;\n  plaidClientId: string | null;\n  setPlaidClientId: (id: string) => void;\n  plaidSecret: string | null;\n  setPlaidSecret: (secret: string) => void;\n  webhookSecret: string | null;\n  setWebhookSecret: (secret: string) => void;\n  webhookBaseUrl: string | null;\n  setWebhookBaseUrl: (url: string) => void;\n  reownProjectId: string | null;\n  setReownProjectId: (id: string) => void;\n  counterparties: Counterparty[];\n  addCounterparty: (data: { name: string; email?: string; accountNumber: string; routingNumber: string }) => Promise<void>;\n}\n\nexport const DataContext = createContext<IDataContext | undefined>(undefined);\n\nexport const DataProvider: React.FC<{ children: ReactNode }> = ({ children }) => {\n  const [transactions, setTransactions] = useState<Transaction[]>(MOCK_TRANSACTIONS);\n  const [assets] = useState<Asset[]>(MOCK_ASSETS);\n  const [budgets, setBudgets] = useState<BudgetCategory[]>(MOCK_BUDGETS);\n  const [linkedAccounts, setLinkedAccounts] = useState<LinkedAccount[]>([]);\n  const [isImportingData, setIsImportingData] = useState(false);\n  const [cryptoAssets, setCryptoAssets] = useState<CryptoAsset[]>([]); // Dynamic crypto state\n  const [financialGoals, setFinancialGoals] = useState<FinancialGoal[]>(MOCK_FINANCIAL_GOALS);\n  const [paymentOperations, setPaymentOperations] = useState<PaymentOperation[]>(MOCK_PAYMENT_OPERATIONS);\n  const [corporateCards, setCorporateCards] = useState<CorporateCard[]>(MOCK_CORPORATE_CARDS);\n  const [corporateTransactions] = useState<CorporateTransaction[]>(MOCK_CORPORATE_TRANSACTIONS);\n  const [rewardPoints, setRewardPoints] = useState<RewardPoints>(MOCK_REWARD_POINTS);\n  const [notifications, setNotifications] = useState<Notification[]>(MOCK_NOTIFICATIONS);\n  const [nftAssets, setNftAssets] = useState<NFTAsset[]>([]);\n  const [counterparties, setCounterparties] = useState<Counterparty[]>([]);\n  const [customBackgroundUrl, setCustomBackgroundUrl] = useState<string | null>(null);\n  const [activeIllusion, setActiveIllusion] = useState<IllusionType>('none');\n  const [apiStatus] = useState<APIStatus[]>(MOCK_API_STATUS);\n  const [creditScore] = useState<CreditScore>(MOCK_CREDIT_SCORE);\n  const [creditFactors] = useState<CreditFactor[]>(MOCK_CREDIT_FACTORS);\n\n  // Production Credentials from Local Storage\n  const [modernTreasuryApiKey, setModernTreasuryApiKey] = useState<string | null>(localStorage.getItem('mt_api_key'));\n  const [modernTreasuryOrganizationId, setModernTreasuryOrganizationId] = useState<string | null>(localStorage.getItem('mt_org_id'));\n  const [plaidClientId, setPlaidClientId] = useState<string | null>(localStorage.getItem('plaid_client_id'));\n  const [plaidSecret, setPlaidSecret] = useState<string | null>(localStorage.getItem('plaid_secret'));\n  const [webhookSecret, setWebhookSecret] = useState<string | null>(localStorage.getItem('webhook_secret'));\n  const [webhookBaseUrl, setWebhookBaseUrl] = useState<string | null>(localStorage.getItem('webhook_base_url'));\n  const [reownProjectId, setReownProjectId] = useState<string | null>(localStorage.getItem('reownProjectId'));\n\n  useEffect(() => {\n    if (modernTreasuryApiKey) localStorage.setItem('mt_api_key', modernTreasuryApiKey);\n    if (modernTreasuryOrganizationId) localStorage.setItem('mt_org_id', modernTreasuryOrganizationId);\n    if (plaidClientId) localStorage.setItem('plaid_client_id', plaidClientId);\n    if (plaidSecret) localStorage.setItem('plaid_secret', plaidSecret);\n    if (webhookSecret) localStorage.setItem('webhook_secret', webhookSecret);\n    if (webhookBaseUrl) localStorage.setItem('webhook_base_url', webhookBaseUrl);\n    if (reownProjectId) localStorage.setItem('reownProjectId', reownProjectId);\n  }, [modernTreasuryApiKey, modernTreasuryOrganizationId, plaidClientId, plaidSecret, webhookSecret, webhookBaseUrl, reownProjectId]);\n\n  const [weaverState, setWeaverState] = useState<QuantumWeaverState>({\n    stage: WeaverStage.Pitch,\n    businessPlan: '',\n    feedback: '',\n    questions: [],\n    loanAmount: 0,\n    coachingPlan: null,\n    error: null,\n  });\n\n  const getPlaidLinkToken = async (): Promise<string | null> => {\n    if (!plaidClientId || !plaidSecret) {\n        console.error(\"Plaid credentials missing.\");\n        return null;\n    }\n    try {\n        const response = await fetch('https://sandbox.plaid.com/link/token/create', {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({\n                client_id: plaidClientId,\n                secret: plaidSecret,\n                user: { client_user_id: 'user_good_123' },\n                client_name: 'Demai Hub',\n                products: ['auth', 'transactions'],\n                country_codes: ['US'],\n                language: 'en'\n            })\n        });\n        const data = await response.json();\n        return data.link_token || null;\n    } catch (err) {\n        console.error(\"Failed to fetch Plaid Link Token:\", err);\n        return null;\n    }\n  };\n\n  const handlePlaidSuccess = async (publicToken: string, metadata: any) => {\n    setIsImportingData(true);\n    try {\n        if (!plaidClientId || !plaidSecret) throw new Error(\"Plaid credentials missing in Settings.\");\n\n        const response = await fetch('https://sandbox.plaid.com/item/public_token/exchange', {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({\n                client_id: plaidClientId,\n                secret: plaidSecret,\n                public_token: publicToken\n            })\n        });\n\n        const data = await response.json();\n        if (data.error_code) throw new Error(data.error_message);\n\n        const newAccount: LinkedAccount = {\n            id: metadata.accounts[0].id,\n            name: metadata.institution.name,\n            mask: metadata.accounts[0].mask,\n        };\n        setLinkedAccounts(prev => [...prev, newAccount]);\n        setNotifications(prev => [{\n            id: Date.now().toString(),\n            message: `Successfully connected ${metadata.institution.name}. Access token: ${data.access_token.substring(0, 8)}...`,\n            timestamp: 'Just now',\n            read: false\n        }, ...prev]);\n\n    } catch (err: any) {\n        console.error(\"Plaid Exchange Error:\", err);\n        alert(`Plaid Exchange failed: ${err.message}`);\n    } finally {\n        setIsImportingData(false);\n    }\n  };\n\n  const addCounterparty = async (data: { name: string; email?: string; accountNumber: string; routingNumber: string }) => {\n    if (!modernTreasuryApiKey || !modernTreasuryOrganizationId) throw new Error(\"Modern Treasury credentials missing.\");\n\n    const authHeader = btoa(`${modernTreasuryOrganizationId}:${modernTreasuryApiKey}`);\n    const response = await fetch('https://try.readme.io/https://app.moderntreasury.com/api/counterparties', {\n        method: 'POST',\n        headers: {\n            'Content-Type': 'application/json',\n            'Authorization': `Basic ${authHeader}`\n        },\n        body: JSON.stringify({\n            name: data.name,\n            email: data.email,\n            accounts: [{\n                account_type: 'checking',\n                account_details: [{ account_number: data.accountNumber, account_number_type: 'account_number' }],\n                routing_details: [{ routing_number: data.routingNumber, routing_number_type: 'aba' }]\n            }]\n        })\n    });\n\n    const result = await response.json();\n    if (result.errors) throw new Error(result.errors[0].message);\n    setCounterparties(prev => [...prev, result]);\n  };\n\n  const addTransaction = (tx: Transaction) => setTransactions(prev => [tx, ...prev]);\n\n  const value = {\n    transactions,\n    assets,\n    impactInvestments: MOCK_IMPACT_INVESTMENTS,\n    budgets,\n    addBudget: (b: any) => setBudgets(prev => [...prev, { ...b, id: b.name.toLowerCase(), spent: 0, color: '#06b6d4' }]),\n    gamification: { score: 750, level: 3, levelName: 'Savings Adept', progress: 65, credits: 120 },\n    impactData: { treesPlanted: 12, spendingForNextTree: 250, progressToNextTree: 45 },\n    customBackgroundUrl,\n    setCustomBackgroundUrl,\n    addTransaction,\n    activeIllusion,\n    setActiveIllusion,\n    linkedAccounts,\n    unlinkAccount: (id: string) => setLinkedAccounts(prev => prev.filter(a => a.id !== id)),\n    handlePlaidSuccess,\n    getPlaidLinkToken,\n    weaverState,\n    pitchBusinessPlan: async (plan: string) => {\n        setWeaverState(prev => ({ ...prev, stage: WeaverStage.Analysis, businessPlan: plan }));\n        try {\n            const res = await AIService.generateContent('gemini-3-flash-preview', `Analyze this business plan: ${plan}. Give a high-level feedback.`);\n            setWeaverState(prev => ({ \n                ...prev, \n                stage: WeaverStage.Test, \n                feedback: res.text || '', \n                questions: [{ id: '1', question: 'How do you plan to scale?', category: 'Ops' }] \n            }));\n        } catch (e) {\n            setWeaverState(prev => ({ ...prev, stage: WeaverStage.Error, error: 'AI analysis failed.' }));\n        }\n    },\n    simulateTestPass: async () => {\n        setWeaverState(prev => ({ ...prev, stage: WeaverStage.FinalReview }));\n        setTimeout(() => {\n            setWeaverState(prev => ({ \n                ...prev, \n                stage: WeaverStage.Approved, \n                loanAmount: 75000, \n                coachingPlan: { title: 'Scale Roadmap', summary: 'Accelerated growth plan.', steps: [] } \n            }));\n        }, 2000);\n    },\n    subscriptions: MOCK_SUBSCRIPTIONS,\n    creditScore,\n    upcomingBills: MOCK_UPCOMING_BILLS,\n    savingsGoals: MOCK_SAVINGS_GOALS,\n    marketMovers: MOCK_MARKET_MOVERS,\n    financialGoals,\n    addFinancialGoal: (g: any) => setFinancialGoals(prev => [...prev, { ...g, id: Date.now().toString(), currentAmount: 0, plan: null }]),\n    contributeToGoal: (id: string, amt: number) => setFinancialGoals(prev => prev.map(g => g.id === id ? { ...g, currentAmount: g.currentAmount + amt } : g)),\n    generateGoalPlan: async (id: string) => {\n        const res = await AIService.generateContent('gemini-3-flash-preview', 'Generate a 3-step financial plan for a goal.');\n        setFinancialGoals(prev => prev.map(g => g.id === id ? { ...g, plan: { feasibilitySummary: res.text || '', monthlyContribution: 200, steps: [] } } : g));\n    },\n    cryptoAssets,\n    setCryptoAssets,\n    paymentOperations,\n    virtualCard: null,\n    issueCard: () => {},\n    buyCrypto: (amt: number, ticker: string) => {\n        setCryptoAssets(prev => {\n            const existing = prev.find(a => a.ticker === ticker);\n            if (existing) return prev.map(a => a.ticker === ticker ? { ...a, amount: a.amount + (amt / 3000), value: a.value + amt } : a);\n            return [...prev, { ticker, name: ticker, amount: amt/3000, value: amt, color: '#627eea' }];\n        });\n    },\n    aiInsights: [],\n    isInsightsLoading: false,\n    corporateCards,\n    corporateTransactions,\n    toggleCorporateCardFreeze: (id: string) => setCorporateCards(prev => prev.map(c => c.id === id ? { ...c, frozen: !c.frozen } : c)),\n    updateCorporateCard: