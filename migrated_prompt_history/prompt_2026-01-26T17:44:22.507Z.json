-cyan-500/10 transition-all duration-700\"></div>\n                                <div className=\"flex justify-between items-start relative z-10\">\n                                    <div className=\"text-cyan-400 font-black italic text-2xl tracking-tighter\">DEMAI</div>\n                                    <div className=\"text-gray-500 text-[10px] font-black uppercase tracking-[0.4em]\">SOVEREIGN V1</div>\n                                </div>\n                                <div className=\"mt-16 text-2xl font-mono text-white tracking-[0.25em] relative z-10 drop-shadow-lg\">{virtualCard.cardNumber}</div>\n                                <div className=\"mt-auto flex justify-between items-end relative z-10\">\n                                    <div>\n                                        <p className=\"text-[9px] text-gray-500 font-black uppercase tracking-widest mb-1\">Validator Period</p>\n                                        <p className=\"text-white font-mono text-lg\">{virtualCard.expiry}</p>\n                                    </div>\n                                    <div className=\"w-16 h-10 bg-gradient-to-br from-white/10 to-white/5 rounded-xl border border-white/10 flex items-center justify-center\">\n                                         <div className=\"w-8 h-8 rounded-full bg-cyan-500/20 animate-pulse\"></div>\n                                    </div>\n                                </div>\n                            </div>\n                        ) : (\n                            <button \n                                onClick={handleForgeCard}\n                                disabled={isIssuing || !isConnected}\n                                className=\"w-full py-16 border-4 border-dashed border-gray-900 rounded-[3rem] flex flex-col items-center justify-center group hover:border-cyan-500/50 hover:bg-cyan-500/5 transition-all disabled:opacity-30 disabled:grayscale\"\n                            >\n                                {isIssuing ? (\n                                    <div className=\"flex flex-col items-center gap-6\">\n                                        <div className=\"w-12 h-12 border-4 border-cyan-500/20 border-t-cyan-500 rounded-full animate-spin\"></div>\n                                        <p className=\"text-cyan-400 font-black uppercase tracking-[0.3em] animate-pulse\">Awaiting Act of Will...</p>\n                                    </div>\n                                ) : (\n                                    <>\n                                        <div className=\"w-20 h-20 rounded-full bg-gray-900 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-500 shadow-2xl\">\n                                            <svg className=\"w-10 h-10 text-gray-700 group-hover:text-cyan-500 transition-colors\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M13 10V3L4 14h7v7l9-11h-7z\" /></svg>\n                                        </div>\n                                        <span className=\"text-gray-600 font-black uppercase tracking-[0.4em] group-hover:text-white transition-colors\">Forge Sovereign Card</span>\n                                    </>\n                                )}\n                            </button>\n                        )}\n                    </Card>\n                );\n            default: return null;\n        }\n    };\n\n    return (\n        <div className=\"space-y-8 pb-20\">\n            <div className=\"flex flex-col sm:flex-row justify-between items-start gap-4\">\n                <div>\n                    <h2 className=\"text-5xl font-black text-white tracking-tighter uppercase italic drop-shadow-2xl\">Web3 Nexus</h2>\n                    <p className=\"text-gray-500 font-bold tracking-widest mt-2\">Status: <span className={isConnected ? \"text-cyan-400\" : \"text-red-500\"}>{isConnected ? \"MASTER HUB SYNCHRONIZED\" : \"WAITING FOR IDENTITY\"}</span></p>\n                </div>\n                <div className=\"scale-110\">\n                    {/* FIX: Using the AppKitButton variable to render the custom web component. */}\n                    <AppKitButton />\n                </div>\n            </div>\n\n            <nav className=\"border-b border-gray-900 flex space-x-12\">\n                {(['Portfolio', 'Registry', 'Marqeta Bridge'] as const).map(tab => (\n                    <button\n                        key={tab}\n                        onClick={() => setActiveTab(tab)}\n                        className={`${activeTab === tab ? 'border-cyan-500 text-cyan-400' : 'border-transparent text-gray-600 hover:text-gray-300'} whitespace-nowrap py-5 px-1 border-b-4 font-black text-xs uppercase tracking-[0.3em] transition-all`}\n                    >\n                        {tab}\n                    </button>\n                ))}\n            </nav>\n\n            <div className=\"mt-10 animate-fade-in\">{renderContent()}</div>\n        </div>\n    );\n};\n\nexport default CryptoView;\n"
