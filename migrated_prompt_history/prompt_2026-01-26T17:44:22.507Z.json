\n        if (modal === 'mt') { setModernTreasuryApiKey(mtKey); setModernTreasuryOrganizationId(mtOrg); }\n        if (modal === 'plaid') { setPlaidClientId(pId); setPlaidSecret(pSec); }\n        if (modal === 'reown') { setReownProjectId(reownId); window.location.reload(); }\n        setModal(null);\n    };\n\n    const StatusIndicator: React.FC<{ status: APIStatus['status'] }> = ({ status }) => {\n        const style = { Operational: 'bg-green-500/20 text-green-300 dot:bg-green-400', 'Degraded Performance': 'bg-yellow-500/20 text-yellow-300 dot:bg-yellow-400', 'Partial Outage': 'bg-orange-500/20 text-orange-300 dot:bg-orange-400', 'Major Outage': 'bg-red-500/20 text-red-300 dot:bg-red-400' }[status];\n        return (\n            <div className={`flex items-center gap-2 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest ${style}`}>\n                <div className={`w-1.5 h-1.5 rounded-full ${style.split('dot:')[1]}`}></div>\n                {status}\n            </div>\n        );\n    };\n\n    return (\n        <div className=\"space-y-8 pb-20\">\n            <header>\n                <h2 className=\"text-5xl font-black text-white tracking-tighter uppercase italic drop-shadow-2xl\">Developer Portal</h2>\n                <p className=\"text-gray-500 font-bold tracking-widest mt-2 uppercase text-xs\">Infrastructure Registry & Secure Anchoring</p>\n            </header>\n\n            <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-8\">\n                <Card title=\"Infrastructure Registry\">\n                    <div className=\"space-y-4\">\n                        {apiStatus.map(api => (\n                            <div key={api.provider} className=\"flex flex-col sm:flex-row justify-between items-center p-5 bg-gray-900 border border-gray-800 rounded-3xl group hover:border-cyan-500/50 transition-all shadow-xl\">\n                                <div className=\"flex flex-col gap-1\">\n                                    <div className=\"flex items-center gap-5\">\n                                        <h4 className=\"font-black text-white text-lg italic tracking-tight uppercase\">{api.provider}</h4>\n                                        <StatusIndicator status={api.status} />\n                                    </div>\n                                    <p className=\"text-[9px] text-gray-600 font-mono tracking-widest uppercase\">\n                                        {api.provider === 'Plaid' && (plaidClientId ? 'Authorized' : 'Requires Config')}\n                                        {api.provider === 'Modern Treasury' && (modernTreasuryApiKey ? 'Authorized' : 'Requires Config')}\n                                        {api.provider === 'Stripe' && (reownProjectId ? 'Authorized' : 'Requires Config')}\n                                        {api.provider === 'Google Gemini' && 'Environment Fixed'}\n                                    </p>\n                                </div>\n                                <div className=\"flex items-center gap-8\">\n                                    <p className=\"text-[10px] text-gray-500 font-mono tracking-[0.2em]\">{api.responseTime}MS</p>\n                                    {api.provider !== 'Google Gemini' && (\n                                        <button onClick={() => {\n                                            if (api.provider === 'Modern Treasury') setModal('mt');\n                                            if (api.provider === 'Plaid') setModal('plaid');\n                                            if (api.provider === 'Stripe') setModal('reown');\n                                        }} className=\"bg-cyan-600/10 p-3 rounded-xl text-cyan-400 hover:bg-cyan-600 hover:text-white transition-all shadow-lg active:scale-95 border border-cyan-900/30\">\n                                            <SettingsIcon className=\"h-5 w-5\"/>\n                                        </button>\n                                    )}\n                                </div>\n                            </div>\n                        ))}\n                    </div>\n                </Card>\n\n                <Card title=\"Sovereign Integrity Monitor\">\n                    <div className=\"space-y-6\">\n                         <div className=\"p-5 bg-black/40 border border-gray-800 rounded-[2rem] flex items-center justify-between\">\n                            <div>\n                                <h5 className=\"text-xs font-black text-white uppercase tracking-[0.2em] mb-1\">Synapse Engine</h5>\n                                <p className=\"text-[10px] text-gray-600 font-medium\">Gemini 3 Pro-Preview Active</p>\n                            </div>\n                            <div className=\"flex items-center gap-2\">\n                                <div className=\"w-2.5 h-2.5 rounded-full bg-cyan-500 animate-ping\"></div>\n                                <span className=\"text-[10px] text-cyan-400 font-black uppercase tracking-widest\">Linked</span>\n                            </div>\n                        </div>\n                        <p className=\"text-[10px] text-gray-700 leading-relaxed italic border-t border-gray-800 pt-6\">Security Protocol: High-latency TradFi rails (Plaid/MT) are anchored via localized identity. Gemini keys are handled via environment variable security context.</p>\n                    </div>\n                </Card>\n            </div>\n\n            {modal && (\n                <div className=\"fixed inset-0 bg-black/95 flex items-center justify-center z-[200] backdrop-blur-3xl p-6\" onClick={() => setModal(null)}>\n                    <div className=\"bg-gray-900 rounded-[3rem] shadow-2xl max-w-lg w-full border border-gray-800 p-10 transform transition-all scale-105\" onClick={e => e.stopPropagation()}>\n                        <div className=\"flex justify-between items-center mb-10\">\n                            <h3 className=\"text-3xl font-black text-white uppercase tracking-tighter italic\">\n                                {modal === 'mt' ? 'Modern Treasury Configuration' : modal === 'plaid' ? 'Plaid Secure Anchor' : 'AppKit Project Config'}\n                            </h3>\n                            <button onClick={() => setModal(null)} className=\"text-gray-600 hover:text-white transition-colors text-3xl font-black\">&times;</button>\n                        </div>\n                        <div className=\"space-y-8\">\n                            {modal === 'mt' && (\n                                <div className=\"space-y-4\">\n                                    <div className=\"space-y-2\">\n                                        <label className=\"text-[9px] font-black uppercase text-gray-500 tracking-[0.2em] ml-2\">Secret Access Key</label>\n                                        <input type=\"password\" value={mtKey} onChange={e => setMtKey(e.target.value)} placeholder=\"sk_live_...\" className=\"w-full bg-black border border-gray-800 rounded-2xl px-6 py-4 text-white focus:ring-2 focus:ring-cyan-500 outline-none\" />\n                                    </div>\n                                    <div className=\"space-y-2\">\n                                        <label className=\"text-[9px] font-black uppercase text-gray-500 tracking-[0.2em] ml-2\">Organization ID</label>\n                                        <input type=\"text\" value={mtOrg} onChange={e => setMtOrg(e.target.value)} placeholder=\"org_...\" className=\"w-full bg-black border border-gray-800 rounded-2xl px-6 py-4 text-white focus:ring-2 focus:ring-cyan-500 outline-none\" />\n                                    </div>\n                                </div>\n                            )}\n                            {modal === 'plaid' && (\n                                <div className=\"space-y-4\">\n                                    <div className=\"space-y-2\">\n                                        <label className=\"text-[9px] font-black uppercase text-gray-500 tracking-[0.2em] ml-2\">Client ID</label>\n                                        <input type=\"text\" value={pId} onChange={e => setPId(e.target.value)} placeholder=\"Client ID\" className=\"w-full bg-black border border-gray-800 rounded-2xl px-6 py-4 text-white focus:ring-2 focus:ring-cyan-500 outline-none\" />\n                                    </div>\n                                    <div className=\"space-y-2\">\n                                        <label className=\"text-[9px] font-black uppercase text-gray-500 tracking-[0.2em] ml-2\">Secret (Sandbox)</label>\n                                        <input type=\"password\" value={pSec} onChange={e => setPSec(e.target.value)} placeholder=\"Secret Key\" className=\"w-full bg-black border border-gray-800 rounded-2xl px-6 py-4 text-white focus:ring-2 focus:ring-cyan-500 outline-none\" />\n                                    </div>\n                                </div>\n                            )}\n                            {modal === 'reown' && (\n                                <div className=\"space-y-2\">\n                                    <label className=\"text-[9px] font-black uppercase text-gray-500 tracking-[0.2em] ml-2\">Project ID</label>\n                                    <input type=\"text\" value={reownId} onChange={e => setReownId(e.target.value)} placeholder=\"Project ID\" className=\"w-full bg-black border border-gray-800 rounded-2xl px-6 py-4 text-white focus:ring-2 focus:ring-cyan-500 outline-none\" />\n                                </div>\n                            )}\n                            <button onClick={handleSave} className=\"w-full py-5 bg-cyan-600 hover:bg-cyan-500 text-white font-black rounded-2xl transition-all shadow-xl shadow-cyan-900/40 uppercase tracking-[0.3em] mt-6 active:scale-95\">Synchronize Railset</button>\n                        </div>\n                    </div>\n                </div>\n            )}\n        </div>\n    );\n};\n\nexport default APIIntegrationView;"
