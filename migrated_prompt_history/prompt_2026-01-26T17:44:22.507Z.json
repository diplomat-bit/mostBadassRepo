stopColor=\"#06b6d4\" stopOpacity={0.8}/>\n                                    <stop offset=\"95%\" stopColor=\"#06b6d4\" stopOpacity={0}/>\n                                </linearGradient>\n                            </defs>\n                            <RechartsTooltip contentStyle={{ backgroundColor: '#111827', borderColor: '#374151', borderRadius: '12px' }} />\n                            <Area type=\"monotone\" dataKey=\"load\" stroke=\"#06b6d4\" strokeWidth={3} fill=\"url(#loadColor)\" />\n                        </AreaChart>\n                    </ResponsiveContainer>\n                </div>\n            </Card>\n\n            {modal && (\n                <div className=\"fixed inset-0 bg-black/90 flex items-center justify-center z-[100] backdrop-blur-xl\" onClick={() => setModal(null)}>\n                    <div className=\"bg-gray-900 rounded-3xl shadow-2xl max-w-lg w-full border border-gray-700 p-8 transform transition-all scale-105\" onClick={e => e.stopPropagation()}>\n                        <h3 className=\"text-2xl font-black text-white uppercase tracking-tighter italic mb-8\">\n                            {modal === 'mt' ? 'Modern Treasury Config' : modal === 'plaid' ? 'Plaid Portal' : modal === 'webhook' ? 'Webhook Endpoint' : 'Web3 Project Access'}\n                        </h3>\n                        <div className=\"space-y-6\">\n                            {modal === 'mt' && (\n                                <>\n                                    <input type=\"password\" value={mtKey} onChange={e => setMtKey(e.target.value)} placeholder=\"API Key\" className=\"w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-3 text-white\" />\n                                    <input type=\"text\" value={mtOrg} onChange={e => setMtOrg(e.target.value)} placeholder=\"Org ID\" className=\"w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-3 text-white\" />\n                                </>\n                            )}\n           