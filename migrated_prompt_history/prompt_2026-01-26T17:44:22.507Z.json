g-gray-900 rounded-3xl shadow-2xl max-w-lg w-full border border-gray-700 p-8 transform transition-all scale-105\" onClick={e => e.stopPropagation()}>\n                        <div className=\"flex justify-between items-center mb-8\">\n                            <h3 className=\"text-2xl font-black text-white uppercase tracking-tighter italic\">\n                                {modal === 'mt' ? 'Modern Treasury Config' : modal === 'plaid' ? 'Plaid Portal' : modal === 'webhook' ? 'Webhook Endpoint' : 'Web3 Project Access'}\n                            </h3>\n                            <button onClick={() => setModal(null)} className=\"text-gray-500 hover:text-white text-xl\">&times;</button>\n                        </div>\n                        <div className=\"space-y-6\">\n                            {modal === 'mt' && (\n                                <>\n                                    <div className=\"space-y-1\">\n                                        <label className=\"text-[10px] font-bold text-gray-500 uppercase tracking-widest\">Secret Key (Org API Key)</label>\n                                        <input type=\"password\" value={mtKey} onChange={e => setMtKey(e.target.value)} placeholder=\"••••••••••••••••\" className=\"w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-cyan-500 outline-none transition-all\" />\n                                    </div>\n                                    <div className=\"space-y-1\">\n                                        <label className=\"text-[10px] font-bold text-gray-500 uppercase tracking-widest\">Organization ID</label>\n                                        <input type=\"text\" value={mtOrg} onChange={e => setMtOrg(e.target.value)} placeholder=\"org_12345678\" className=\"w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-cyan-500 outline-none transition-all\" />\n                                    </div>\n                                </>\n                            )}\n                            {modal === 'plaid' && (\n                                <>\n                                    <div className=\"space-y-1\">\n                                        <label className=\"text-[10px] font-bold text-gray-500 uppercase tracking-widest\">Client ID</label>\n                                        <input type=\"text\" value={pId} onChange={e => setPId(e.target.value)} placeholder=\"63c8a...\" className=\"w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-cyan-500 outline-none transition-all\" />\n                                    </div>\n                                    <div className=\"space-y-1\">\n                                        <label className=\"text-[10px] font-bold text-gray-500 uppercase tracking-widest\">Client Secret</label>\n                                        <input type=\"password\" value={pSec} onChange={e => setPSec(e.target.value)} placeholder=\"••••••••••••••••\" className=\"w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-cyan-500 outline-none transition-all\" />\n                                    </div>\n                                </>\n                            )}\n                            {modal === 'webhook' && (\n                                <>\n                                    <div className=\"space-y-1\">\n                                        <label className=\"text-[10px] font-bold text-gray-500 uppercase tracking-widest\">Base API URL</label>\n                                        <input type=\"text\" value={wUrl} onChange={e => setWUrl(e.target.value)} placeholder=\"https://api.myapp.com/webhooks\" className=\"w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-cyan-500 outline-none transition-all\" />\n                                    </div>\n                                    <div className=\"space-y-1\">\n                                        <label className=\"text-[10px] font-bold text-gray-500 uppercase tracking-widest\">Signing Secret</label>\n                                        <input type=\"password\" value={wSec} onChange={e => setWSec(e.target.value)} placeholder=\"whsec_...\" className=\"w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-cyan-500 outline-none transition-all\" />\n                                    </div>\n                                </>\n                            )}\n                            {modal === 'reown' && (\n                                <div className=\"space-y-1\">\n                                    <label className=\"text-[10px] font-bold text-gray-500 uppercase tracking-widest\">AppKit Project ID</label>\n                                    <input type=\"text\" value={reownId} onChange={e => setReownId(e.target.value)} placeholder=\"04a6c...\" className=\"w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-cyan-500 outline-none transition-all\" />\n                                </div>\n                            )}\n                            <button onClick={handleSave} className=\"w-full py-4 bg-cyan-600 hover:bg-cyan-500 text-white font-black rounded-2xl transition-all shadow-lg shadow-cyan-900/30 uppercase tracking-widest mt-4\">Save & Deploy</button>\n                        </div>\n                    </div>\n                </div>\n            )}\n        </div>\n    );\n};\n\nexport default APIIntegrationView;\n"
