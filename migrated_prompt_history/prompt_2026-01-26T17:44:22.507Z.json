              "replacement": "\nimport React, { createContext, useState, ReactNode, useEffect, useCallback, useMemo } from 'react';\nimport { GoogleGenAI } from \"@google/genai\";\nimport { useBalance, useAccount, useSignMessage } from \"wagmi\";\nimport type { \n  Transaction, Asset, BudgetCategory, GamificationState, IllusionType, \n  LinkedAccount, QuantumWeaverState, AIPlan, Subscription, \n  CreditScore, UpcomingBill, SavingsGoal, MarketMover, \n  FinancialGoal, CryptoAsset, VirtualCard, \n  PaymentOperation, AIInsight, CorporateCard, CorporateTransaction, \n  RewardPoints, Notification, NFTAsset, RewardItem, APIStatus, \n  CreditFactor, CorporateCardControls, Counterparty \n} from '../types';\nimport { WeaverStage } from '../types';\nimport { \n  MOCK_TRANSACTIONS, MOCK_ASSETS, MOCK_IMPACT_INVESTMENTS, MOCK_BUDGETS, \n  MOCK_SUBSCRIPTIONS, MOCK_CREDIT_SCORE, MOCK_UPCOMING_BILLS, MOCK_SAVINGS_GOALS, \n  MOCK_MARKET_MOVERS, MOCK_FINANCIAL_GOALS, MOCK_PAYMENT_OPERATIONS, \n  MOCK_CORPORATE_CARDS, MOCK_CORPORATE_TRANSACTIONS, MOCK_REWARD_POINTS, \n  MOCK_NOTIFICATIONS, MOCK_REWARD_ITEMS, MOCK_API_STATUS, MOCK_CREDIT_FACTORS \n} from '../data/mockData';\n\nexport const AIService = {\n    async generateContent(model: string, contents: any, config?: any) {\n        const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });\n        return await ai.models.generateContent({ model, contents, config });\n    }\n};\n\ninterface IDataContext {\n  transactions: Transaction[];\n  assets: Asset[];\n  impactInvestments: Asset[];\n  budgets: BudgetCategory[];\n  addBudget: (budget: Omit<BudgetCategory, 'id' | 'spent' | 'color'>) => void;\n  gamification: GamificationState;\n  impactData: { treesPlanted: number; spendingForNextTree: number; progressToNextTree: number; };\n  customBackgroundUrl: string | null;\n  setCustomBackgroundUrl: (url: string) => void;\n  addTransaction: (tx: Transaction) => void;\n  activeIllusion: IllusionType;\n  setActiveIllusion: (illusion: IllusionType) => void;\n  linkedAccounts: LinkedAccount[];\n  unlinkAccount: (id: string) => void;\n  handlePlaidSuccess: (publicToken: string, metadata: any) => Promise<void>;\n  getPlaidLinkToken: () => Promise<string | null>;\n  weaverState: QuantumWeaverState;\n  pitchBusinessPlan: (plan: string) => Promise<void>;\n  simulateTestPass: () => Promise<void>;\n  subscriptions: Subscription[];\n  creditScore: CreditScore;\n  upcomingBills: UpcomingBill[];\n  savingsGoals: SavingsGoal[];\n  marketMovers: MarketMover[];\n  financialGoals: FinancialGoal[];\n  addFinancialGoal: (goalData: Omit<FinancialGoal, 'id' | 'plan' | 'currentAmount'>) => void;\n  contributeToGoal: (goalId: string, amount: number) => void;\n  generateGoalPlan: (goalId: string) => Promise<void>;\n  cryptoAssets: CryptoAsset[];\n  importToken: (address: string) => Promise<void>;\n  paymentOperations: PaymentOperation[];\n  virtualCard: VirtualCard | null;\n  issueVirtualCard: () => Promise<void>;\n  buyCrypto: (usdAmount: number, cryptoTicker: string) => void;\n  aiInsights: AIInsight[];\n  isInsightsLoading: boolean;\n  corporateCards: CorporateCard[];\n  corporateTransactions: CorporateTransaction[];\n  toggleCorporateCardFreeze: (cardId: string) => void;\n  updateCorporateCard: (cardId: string, newControls: CorporateCardControls, newFrozenState: boolean) => void;\n  rewardPoints: RewardPoints;\n  notifications: Notification[];\n  markNotificationRead: (id: string) => void;\n  isImportingData: boolean;\n  nftAssets: NFTAsset[];\n  mintNFT: (name: string, imageUrl: string) => void;\n  initiatePayment: (details: Omit<PaymentOperation, 'id' | 'status' | 'date'>) => void;\n  rewardItems: RewardItem[];\n  redeemReward: (item: RewardItem) => boolean;\n  apiStatus: APIStatus[];\n  creditFactors: CreditFactor[];\n  modernTreasuryApiKey: string | null;\n  setModernTreasuryApiKey: (key: string) => void;\n  modernTreasuryOrganizationId: string | null;\n  setModernTreasuryOrganizationId: (id: string) => void;\n  plaidClientId: string | null;\n  setPlaidClientId: (id: string) => void;\n  plaidSecret: string | null;\n  setPlaidSecret: (secret: string) => void;\n  webhookSecret: string | null;\n  setWebhookSecret: (secret: string) => void;\n  webhookBaseUrl: string | null;\n  setWebhookBaseUrl: (url: string) => void;\n  reownProjectId: string | null;\n  setReownProjectId: (id: string) => void;\n  counterparties: Counterparty[];\n  addCounterparty: (data: { name: string; email?: string; accountNumber: string; routingNumber: string }) => Promise<void>;\n}\n\nexport const DataContext = createContext<IDataContext | undefined>(undefined);\n\nexport const DataProvider: React.FC<{ children: ReactNode }> = ({ children }) => {\n  const { address, isConnected } = useAccount();\n  const { signMessageAsync } = useSignMessage();\n  const { data: ethBalance } = useBalance({ address });\n\n  const [transactions, setTransactions] = useState<Transaction[]>(MOCK_TRANSACTIONS);\n  const [budgets, setBudgets] = useState<BudgetCategory[]>(MOCK_BUDGETS);\n  const [linkedAccounts, setLinkedAccounts] = useState<LinkedAccount[]>([]);\n  const [isImportingData, setIsImportingData] = useState(false);\n  const [virtualCard, setVirtualCard] = useState<VirtualCard | null>(null);\n  const [importedTokens, setImportedTokens] = useState<CryptoAsset[]>([]);\n\n  // Persistent Credentials\n  const [modernTreasuryApiKey, setModernTreasuryApiKey] = useState<string | null>(localStorage.getItem('mt_api_key'));\n  const [modernTreasuryOrganizationId, setModernTreasuryOrganizationId] = useState<string | null>(localStorage.getItem('mt_org_id'));\n  const [plaidClientId, setPlaidClientId] = useState<string | null>(localStorage.getItem('plaid_client_id'));\n  const [plaidSecret, setPlaidSecret] = useState<string | null>(localStorage.getItem('plaid_secret'));\n  const [webhookSecret, setWebhookSecret] = useState<string | null>(localStorage.getItem('webhook_secret'));\n  const [webhookBaseUrl, setWebhookBaseUrl] = useState<string | null>(localStorage.getItem('webhook_base_url'));\n  const [reownProjectId, setReownProjectId] = useState<string | null>(localStorage.getItem('reownProjectId'));\n\n  useEffect(() => {\n    if (modernTreasuryApiKey) localStorage.setItem('mt_api_key', modernTreasuryApiKey);\n    if (modernTreasuryOrganizationId) localStorage.setItem('mt_org_id', modernTreasuryOrganizationId);\n    if (plaidClientId) localStorage.setItem('plaid_client_id', plaidClientId);\n    if (plaidSecret) localStorage.setItem('plaid_secret', plaidSecret);\n    if (webhookSecret) localStorage.setItem('webhook_secret', webhookSecret);\n    if (webhookBaseUrl) localStorage.setItem('webhook_base_url', webhookBaseUrl);\n    if (reownProjectId) localStorage.setItem('reownProjectId', reownProjectId);\n  }, [modernTreasuryApiKey, modernTreasuryOrganizationId, plaidClientId, plaidSecret, webhookSecret, webhookBaseUrl, reownProjectId]);\n\n  const cryptoAssets = useMemo(() => {\n    const assets: CryptoAsset[] = [];\n    if (isConnected && ethBalance) {\n      assets.push({ ticker: 'ETH', name: 'Ethereum', amount: parseFloat(ethBalance.formatted), value: parseFloat(ethBalance.formatted) * 3200, color: '#627eea' });\n    }\n    return [...assets, ...importedTokens];\n  }, [isConnected, ethBalance, importedTokens]);\n\n  const importToken = async (addr: string) => {\n    if (!isConnected) throw new Error(\"Validation Required: Connect Master Chain Wallet.\");\n    setImportedTokens(prev => [...prev, { ticker: 'USDC', name: 'USD Coin', amount: 100, value: 100, color: '#2775ca' }]);\n  };\n\n  const getPlaidLinkToken = async (): Promise<string | null> => {\n    if (!plaidClientId || !plaidSecret) return null;\n    try {\n      const response = await fetch('https://sandbox.plaid.com/link/token/create', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({\n          client_id: plaidClientId,\n          secret: plaidSecret,\n          user: { client_user_id: address || 'demai_master_user' },\n          client_name: 'Demai Sovereign Hub',\n          products: ['transactions'],\n          country_codes: ['US'],\n          language: 'en'\n        })\n      });\n      const data = await response.json();\n      return data.link_token || null;\n    } catch (e) { return null; }\n  };\n\n  const handlePlaidSuccess = async (publicToken: string, metadata: any) => {\n    setIsImportingData(true);\n    try {\n      setLinkedAccounts(prev => [...prev, { id: metadata.accounts[0].id, name: metadata.institution.name, mask: metadata.accounts[0].mask }]);\n    } finally { setIsImportingData(false); }\n  };\n\n  const issueVirtualCard = async () => {\n    if (!isConnected) throw new Error(\"Validation Required: Connect Master Chain Wallet.\");\n    const timestamp = Date.now();\n    await signMessageAsync({ message: `AUTHORIZE SIGIL FORGE\\nIdentity: ${address}\\nProtocol: Marqeta-Web3 Bridge\\nEpoch: ${timestamp}` });\n    setVirtualCard({ cardNumber: `4111 ${Math.floor(1000 + Math.random() * 9000)} ${Math.floor(1000 + Math.random() * 9000)} ${Math.floor(1000 + Math.random() * 9000)}`, cvv: \"999\", expiry: \"01/30\", holderName: \"MASTER VALIDATOR\" });\n    setTransactions(prev => [{ id: `forge-${timestamp}`, type: 'expense', category: 'Security', description: 'Marqeta Sovereign Forge (Signed)', amount: 0, date: new Date().toISOString().split('T')[0] }, ...prev]);\n  };\n\n  const addTransaction = (tx: Transaction) => setTransactions(prev => [tx, ...prev]);\n\n  return (\n    <DataContext.Provider value={{\n      transactions, assets: MOCK_ASSETS, impactInvestments: MOCK_IMPACT_INVESTMENTS, budgets,\n      addBudget: (b) => setBudgets(prev => [...prev, { ...b, id: Date.now().toString(), spent: 0, color: '#06b6d4' }]),\n      gamification: { score: 999, level: 5, levelName: 'Chain Architect', progress: 100, credits: 5000 },\n      impactData: { treesPlanted: 50, spendingForNextTree: 20, progressToNextTree: 95 },\n      customBackgroundUrl: null, setCustomBackgroundUrl: () => {},\n      addTransaction, activeIllusion: 'none', setActiveIllusion: () => {},\n      linkedAccounts, unlinkAccount: (id) => setLinkedAccounts(prev => prev.filter(a => a.id !== id)),\n      handlePlaidSuccess, getPlaidLinkToken,\n      weaverState: { stage: WeaverStage.Pitch, businessPlan: '', feedback: '', questions: [], loanAmount: 0, coachingPlan: null, error: null },\n      pitchBusinessPlan: async () => {}, simulateTestPass: async () => {},\n      subscriptions: MOCK_SUBSCRIPTIONS, creditScore: MOCK_CREDIT_SCORE,\n      upcomingBills: MOCK_UPCOMING_BILLS, savingsGoals: MOCK_SAVINGS_GOALS,\n      marketMovers: MOCK_MARKET_MOVERS, financialGoals: MOCK_FINANCIAL_GOALS,\n      addFinancialGoal: () => {}, contributeToGoal: () => {}, generateGoalPlan: async () => {},\n      cryptoAssets, importToken, paymentOperations: MOCK_PAYMENT_OPERATIONS,\n      virtualCard, issueVirtualCard, buyCrypto: () => {},\n      aiInsights: [], isInsightsLoading: false,\n      corporateCards: MOCK_CORPORATE_CARDS, corporateTransactions: MOCK_CORPORATE_TRANSACTIONS,\n      toggleCorporateCardFreeze: () => {}, updateCorporateCard: () => {},\n      rewardPoints: MOCK_REWARD_POINTS, notifications: MOCK_NOTIFICATIONS,\n      markNotificationRead: () => {}, isImportingData, nftAssets: [], mintNFT: () => {},\n      initiatePayment: () => {}, rewardItems: MOCK_REWARD_ITEMS, redeemReward: () => false,\n      apiStatus: MOCK_API_STATUS, creditFactors: MOCK_CREDIT_FACTORS,\n      modernTreasuryApiKey, setModernTreasuryApiKey,\n      modernTreasuryOrganizationId, setModernTreasuryOrganizationId,\n      plaidClientId, setPlaidClientId, plaidSecret, setPlaidSecret,\n      webhookSecret, setWebhookSecret, webhookBaseUrl, setWebhookBaseUrl,\n      reownProjectId, setReownProjectId, counterparties: [], addCounterparty: async () => {}\n    }}>\n      {children}\n    </DataContext.Provider>\n  );\n};\n"
