d] = useState(plaidClientId || '');\n    const [pSec, setPSec] = useState(plaidSecret || '');\n    const [wSec, setWSec] = useState(webhookSecret || '');\n    const [wUrl, setWUrl] = useState(webhookBaseUrl || '');\n    const [reownId, setReownId] = useState(reownProjectId || '');\n\n    const handleSave = () => {\n        if (modal === 'mt') { setModernTreasuryApiKey(mtKey); setModernTreasuryOrganizationId(mtOrg); }\n        if (modal === 'plaid') { setPlaidClientId(pId); setPlaidSecret(pSec); }\n        if (modal === 'webhook') { setWebhookSecret(wSec); setWebhookBaseUrl(wUrl); }\n        if (modal === 'reown') { setReownProjectId(reownId); window.location.reload(); }\n        setModal(null);\n    };\n\n    const StatusIndicator: React.FC<{ status: APIStatus['status'] }> = ({ status }) => {\n        const colors = {\n            'Operational': { bg: 'bg-green-500/20', text: 'text-green-300', dot: 'bg-green-400' },\n            'Degraded Performance': { bg: 'bg-yellow-500/20', text: 'text-yellow-300', dot: 'bg-yellow-400' },\n            'Partial Outage': { bg: 'bg-orange-500/20', text: 'text-orange-300', dot: 'bg-orange-400' },\n            'Major Outage': { bg: 'bg-red-500/20', text: 'text-red-300', dot: 'bg-red-400' },\n        };\n        const style = colors[status];\n        return (\n            <div className={`flex items-center gap-2 px-2 py-1 rounded-full text-xs font-medium ${style.bg} ${style.text}`}>\n                <div className={`w-2 h-2 rounded-full ${style.dot}`}></div>\n                {status}\n            </div>\n        );\n    };\n\n    return (\n        <div className=\"space-y-6\">\n            <h2 className=\"text-4xl font-extrabold text-white tracking-tighter\">Developer Portal</h2>\n            <p className=\"text-gray-400 font-medium\">Control Center for the Master Chain Holder & Integrated Railsets.</p>\n            \n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                <Card title=\"Infrastructure Co