tracking-[0.3em] animate-pulse\">Awaiting Act of Will...</p>\n                                    </div>\n                                ) : (\n                                    <>\n                                        <div className=\"w-20 h-20 rounded-full bg-gray-900 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-500 shadow-2xl\">\n                                            <svg className=\"w-10 h-10 text-gray-700 group-hover:text-cyan-500 transition-colors\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M13 10V3L4 14h7v7l9-11h-7z\" /></svg>\n                                        </div>\n                                        <span className=\"text-gray-600 font-black uppercase tracking-[0.4em] group-hover:text-white transition-colors\">Forge Sovereign Card</span>\n                                    </>\n                                )}\n                            </button>\n                        )}\n                    </Card>\n                );\n            default: return null;\n        }\n    };\n\n    return (\n        <div className=\"space-y-8 pb-20\">\n            <div className=\"flex flex-col sm:flex-row justify-between items-start gap-4\">\n                <div>\n                    <h2 className=\"text-5xl font-black text-white tracking-tighter uppercase italic drop-shadow-2xl\">Web3 Nexus</h2>\n                    <p className=\"text-gray-500 font-bold tracking-widest mt-2\">Status: <span className={isConnected ? \"text-cyan-400\" : \"text-red-500\"}>{isConnected ? \"MASTER HUB SYNCHRONIZED\" : \"WAITING FOR IDENTITY\"}</span></p>\n                </div>\n                <div className=\"scale-110\"><appkit-button /></div>\n            </div>\n\n            <nav className=\"border-b border-gray-900 flex space-x-12\">\n                {(['Portfolio', 'Registry', 'Marqeta Bridge'] as const).map(tab => (\n 