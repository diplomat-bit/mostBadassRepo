relative aspect-[85.6/54] w-full max-w-sm mx-auto bg-gradient-to-br from-gray-800 to-black rounded-3xl border border-gray-700 p-8 shadow-2xl overflow-hidden\">\n                                <div className=\"absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_50%,rgba(6,182,212,0.1),transparent)]\"></div>\n                                <div className=\"flex justify-between items-start relative z-10\">\n                                    <div className=\"text-cyan-400 font-black italic text-xl\">DEMAI</div>\n                                    <div className=\"text-gray-500 text-xs font-bold uppercase tracking-tighter\">Sovereign Debit</div>\n                                </div>\n                                <div className=\"mt-12 text-2xl font-mono text-white tracking-[0.2em] relative z-10\">{virtualCard.cardNumber}</div>\n                                <div className=\"mt-auto flex justify-between items-end relative z-10\">\n                                    <div>\n                                        <p className=\"text-[10px] text-gray-500 font-black uppercase\">Valid Thru</p>\n                                        <p className=\"text-white font-mono\">{virtualCard.expiry}</p>\n                                    </div>\n                                    <div className=\"w-12 h-8 bg-white/10 rounded-md\"></div>\n                                </div>\n                            </div>\n                        ) : (\n                            <button \n                                onClick={handleIssueCard}\n                                disabled={isIssuing || !isConnected}\n                                className=\"w-full py-8 border-4 border-dashed border-gray-800 rounded-3xl flex flex-col items-center justify-center group hover:border-cyan-500/50 transition-all disabled:opacity-50\"\n                            >\n                                {isIssuing ? (\n                                    <div className=\"flex flex-col items-center gap-4\">\n                                        <div className=\"w-8 h-8 border-4 border-cyan-500/30 border-t-cyan-500 rounded-full animate-spin\"></div>\n                                        <p className=\"text-cyan-400 font-black uppercase tracking-tighter animate-pulse\">Waiting for Signature...</p>\n                                    </div>\n                                ) : (\n                                    <>\n                                        <svg className=\"w-12 h-12 text-gray-700 group-hover:text-cyan-500 transition-colors mb-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M12 4v16m8-8H4\" /></svg>\n                                        <span className=\"text-gray-600 font-black uppercase tracking-widest group-hover:text-white\">Forge Sovereign Card</span>\n                                    </>\n                                )}\n                            </button>\n                        )}\n                    </Card>\n                );\n            default: return null;\n        }\n    };\n\n    return (\n        <div className=\"space-y-8\">\n            <div className=\"flex flex-col sm:flex-row justify-between items-start gap-4\">\n                <div>\n                    <h2 className=\"text-4xl font-black text-white tracking-tighter uppercase italic\">Web3 Nexus</h2>\n                    <p className=\"text-gray-500 font-medium\">The Master Chain Holder is currently: <span className={isConnected ? \"text-green-400\" : \"text-red-400\"}>{isConnected ? \"ONLINE\" : \"OFFLINE\"}</span></p>\n                </div>\n                <appkit-button />\n            </div>\n\n            <nav className=\"border-b border-gray-800 flex space-x-10\">\n                {(['Portfolio', 'Import', 'Sovereign Card'] as const).map(tab => (\n                    <button\n                        key={tab}\n                        onClick={() => setActiveTab(tab)}\n                        className={`${activeTab === tab ? 'border-cyan-500 text-cyan-400' : 'border-transparent text-gray-500 hover:text-gray-300'} whitespace-nowrap py-4 px-1 border-b-4 font-black text-sm uppercase tracking-widest transition-all`}\n                    >\n                        {tab}\n                    </button>\n                ))}\n            </nav>\n\n            <div className=\"mt-8\">{renderContent()}</div>\n        </div>\n    );\n};\n\nexport default CryptoView;\n"
