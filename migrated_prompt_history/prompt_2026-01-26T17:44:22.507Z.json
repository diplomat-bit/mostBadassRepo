ded-2xl p-5 text-white font-mono focus:ring-2 focus:ring-cyan-500 outline-none shadow-inner\" \n                                />\n                            </div>\n                            <button \n                                onClick={() => importToken(tokenAddr)}\n                                className=\"w-full bg-cyan-600 py-5 rounded-2xl font-black text-white uppercase tracking-[0.3em] hover:bg-cyan-500 transition-all shadow-lg shadow-cyan-900/30 active:scale-95\"\n                            >\n                                Verify & Anchor\n                            </button>\n                        </div>\n                    </Card>\n                );\n            case 'Marqeta Bridge':\n                return (\n                    <Card title=\"Marqeta Alchemical Forge\">\n                        <p className=\"text-sm text-gray-400 mb-10 leading-relaxed italic\">Forge a physical-ready virtual sigil (Debit Card) backed by your Master Chain liquidity. This requires an immediate Act of Will (Cryptographic Signature).</p>\n                        {virtualCard ? (\n                            <div className=\"relative aspect-[85.6/54] w-full max-w-sm mx-auto bg-gradient-to-br from-gray-900 via-gray-800 to-black rounded-[2.5rem] border border-gray-700 p-10 shadow-2xl overflow-hidden group\">\n                                <div className=\"absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_50%,rgba(6,182,212,0.15),transparent)]\"></div>\n                                <div className=\"absolute -right-20 -top-20 w-60 h-60 bg-cyan-500/5 blur-[80px] rounded-full group-hover:bg-cyan-500/10 transition-all duration-700\"></div>\n                                <div className=\"flex justify-between items-start relative z-10\">\n                                    <div className=\"text-cyan-400 font-black italic text-2xl tracking-tighter\">DEMAI</div>\n                                    <div className=\"text-gray-500 text-[10px]