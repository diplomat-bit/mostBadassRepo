              "replacement": "\nimport React, { useState, useContext } from 'react';\nimport { DataContext } from '../context/DataContext';\nimport { APIStatus } from '../types';\nimport Card from './Card';\nimport { ResponsiveContainer, AreaChart, Area, Tooltip as RechartsTooltip } from 'recharts';\n\nfunction SettingsIcon(props: React.SVGProps<SVGSVGElement>) {\n    return (\n        <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" {...props}>\n            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065zM15 12a3 3 0 11-6 0 3 3 0 016 0z\" />\n        </svg>\n    );\n}\n\nconst APIIntegrationView: React.FC = () => {\n    const context = useContext(DataContext);\n    if (!context) throw new Error(\"APIIntegrationView must be within a DataProvider.\");\n    const { \n        apiStatus, \n        modernTreasuryApiKey, setModernTreasuryApiKey,\n        modernTreasuryOrganizationId, setModernTreasuryOrganizationId,\n        plaidClientId, setPlaidClientId,\n        plaidSecret, setPlaidSecret,\n        webhookSecret, setWebhookSecret,\n        webhookBaseUrl, setWebhookBaseUrl,\n        reownProjectId, setReownProjectId\n    } = context;\n\n    const [modal, setModal] = useState<'mt' | 'plaid' | 'webhook' | 'reown' | null>(null);\n\n    // Temp Inputs\n    const [mtKey, setMtKey] = useState(modernTreasuryApiKey || '');\n    const [mtOrg, setMtOrg] = useState(modernTreasuryOrganizationId || '');\n    const [pId, setPId] = useState(plaidClientId || '');\n    const [pSec, setPSec] = useState(plaidSecret || '');\n    const [wSec, setWSec] = useState(webhookSecret || '');\n    const [wUrl, setWUrl] = useState(webhookBaseUrl || '');\n    const [reownId, setReownId] = useState(reownProjectId || '');\n\n    const handleSave = () => {\n        if (modal === 'mt') { setModernTreasuryApiKey(mtKey); setModernTreasuryOrganizationId(mtOrg); }\n        if (modal === 'plaid') { setPlaidClientId(pId); setPlaidSecret(pSec); }\n        if (modal === 'webhook') { setWebhookSecret(wSec); setWebhookBaseUrl(wUrl); }\n        if (modal === 'reown') { setReownProjectId(reownId); window.location.reload(); }\n        setModal(null);\n    };\n\n    const StatusIndicator: React.FC<{ status: APIStatus['status'] }> = ({ status }) => {\n        const colors = {\n            'Operational': { bg: 'bg-green-500/20', text: 'text-green-300', dot: 'bg-green-400' },\n            'Degraded Performance': { bg: 'bg-yellow-500/20', text: 'text-yellow-300', dot: 'bg-yellow-400' },\n            'Partial Outage': { bg: 'bg-orange-500/20', text: 'text-orange-300', dot: 'bg-orange-400' },\n            'Major Outage': { bg: 'bg-red-500/20', text: 'text-red-300', dot: 'bg-red-400' },\n        };\n        const style = colors[status];\n        return (\n            <div className={`flex items-center gap-2 px-2 py-1 rounded-full text-xs font-medium ${style.bg} ${style.text}`}>\n                <div className={`w-2 h-2 rounded-full ${style.dot}`}></div>\n                {status}\n            </div>\n        );\n    };\n\n    return (\n        <div className=\"space-y-6\">\n            <h2 className=\"text-3xl font-bold text-white tracking-wider\">Developer Portal</h2>\n            \n            <Card title=\"Core API Configuration\">\n                <div className=\"space-y-3\">\n                    {apiStatus.map(api => (\n                        <div key={api.provider} className=\"flex flex-col sm:flex-row justify-between items-center p-3 bg-gray-800/50 rounded-lg\">\n                            <div className=\"flex items-center gap-3\">\n                                <h4 className=\"font-semibold text-lg text-white\">{api.provider}</h4>\n                                <StatusIndicator status={api.status} />\n                            </div>\n                            <div className=\"flex items-center gap-4 mt-2 sm:mt-0\">\n                                <p className=\"text-xs text-gray-400 font-mono\">{api.responseTime}ms</p>\n                                {api.provider === 'Modern Treasury' && (\n                                    <button onClick={() => setModal('mt')} className=\"text-cyan-400 hover:text-white transition-colors\">\n                                        <SettingsIcon className=\"h-5 w-5\"/>\n                                    </button>\n                                )}\n                                {api.provider === 'Plaid' && (\n                                    <button onClick={() => setModal('plaid')} className=\"text-cyan-400 hover:text-white transition-colors\">\n                                        <SettingsIcon className=\"h-5 w-5\"/>\n                                    </button>\n                                )}\n                                {api.provider === 'Stripe' && ( // Using Stripe as a placeholder for Reown/Web3 Settings\n                                    <button onClick={() => setModal('reown')} className=\"text-cyan-400 hover:text-white transition-colors\">\n                                        <SettingsIcon className=\"h-5 w-5\"/>\n                                    </button>\n                                )}\n                            </div>\n                        </div>\n                    ))}\n                    <div className=\"flex flex-col sm:flex-row justify-between items-center p-3 bg-gray-800/50 rounded-lg border border-dashed border-gray-700\">\n                        <h4 cl