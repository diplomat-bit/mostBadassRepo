his.request<PaginatedResponse<Transaction>>('/transactions'); \n        },\n        getDetails: (transactionId: string): Promise<Transaction> => this.request<Transaction>(`/transactions/${transactionId}`),\n        categorize: (transactionId: string, data: any) => this.request(`/transactions/${transactionId}/categorize`, { method: 'PUT', body: JSON.stringify(data) }),\n        addNotes: (transactionId: string, notes: string) => this.request(`/transactions/${transactionId}/notes`, { method: 'PUT', body: JSON.stringify({ notes }) }),\n        getRecurring: () => this.request('/transactions/recurring'),\n        getSpendingTrends: () => this.request('/transactions/insights/spending-trends'),\n    };\n\n    public budgets = {\n        list: (): Promise<PaginatedResponse<BudgetCategory>> => this.request<PaginatedResponse<BudgetCategory>>('/budgets'),\n        getDetails: (budgetId: string) => this.request(`/budgets/${budgetId}`),\n        update: (budgetId: string, data: any) => this.request(`/budgets/${budgetId}`, { method: 'PUT', body: JSON.stringify(data) }),\n    };\n\n    public investments = {\n        getPortfolios: (): Promise<PaginatedResponse<Portfolio>> => this.request<PaginatedResponse<Portfolio>>('/investments/portfolios'),\n        getPortfolioDetails: (portfolioId: string): Promise<Portfolio> => this.request<Portfolio>(`/investments/portfolios/${portfolioId}`),\n        rebalancePortfolio: (portfolioId: string, data: any) => this.request(`/investments/portfolios/${portfolioId}/rebalance`, { method: 'POST', body: JSON.stringify(data) }),\n        searchAssets: (query: string) => this.request(`/investments/assets/search?query=${encodeURIComponent(query)}`),\n    };\n\n    public ai = {\n        advisor: {\n            chat: (message: string, sessionId?: string) => this.request('/ai/advisor/chat', { method: 'POST', body: JSON.stringify({ message, sessionId }) }),\n            getHistory: (sessionId?: string) => this.request(`/ai/advisor/chat/history${sessionI