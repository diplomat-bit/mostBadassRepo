   create: (data: any) => this.request('/developers/api-keys', { method: 'POST', body: JSON.stringify(data) }),\n            revoke: (id: string) => this.request(`/developers/api-keys/${id}`, { method: 'DELETE' }),\n        }\n    };\n\n    public goals = {\n        list: () => this.request('/goals'),\n        get: (id: string) => this.request(`/goals/${id}`),\n        update: (id: string, data: any) => this.request(`/goals/${id}`, { method: 'PUT', body: JSON.stringify(data) }),\n        delete: (id: string) => this.request(`/goals/${id}`, { method: 'DELETE' }),\n    };\n\n    public marketplace = {\n        listProducts: (params?: any) => {\n             const query = new URLSearchParams(params).toString();\n             return this.request(`/marketplace/products?${query}`);\n        },\n        simulateImpact: (productId: string, data: any) => this.request(`/marketplace/products/${productId}/impact-simulate`, { method: 'POST', body: JSON.stringify(data) }),\n        redeemOffer: (offerId: string, data: any) => this.request(`/marketplace/offers/${offerId}/redeem`, { method: 'POST', body: JSON.stringify(data) }),\n    };\n    \n    public notifications = {\n        list: () => this.request('/notifications/me'),\n        markRead: (id: string) => this.request(`/notifications/${id}/mark-read`, { method: 'POST' }),\n        getSettings: () => this.request('/notifications/settings'),\n        updateSettings: (data: any) => this.request('/notifications/settings', { method: 'PUT', body: JSON.stringify(data) }),\n    };\n}\n\nexport const quantumClient = new QuantumClient();\n"
