is.simulateDelay(MOCK_TRANSACTIONS.find(t => t.id === id)),\n        getCategorization: (id: string) => this.simulateDelay({ category: 'Updated Category' }),\n    };\n\n    public investments = {\n        getPortfolios: (): Promise<Portfolio[]> => this.simulateDelay(API_EXAMPLE_PORTFOLIOS),\n        getPortfolioDetails: (id: string): Promise<Portfolio | undefined> => this.simulateDelay(API_EXAMPLE_PORTFOLIOS.find(p => p.id === id)),\n        rebalancePortfolio: (id: string) => this.simulateDelay({ status: 'analyzing', message: 'AI is optimizing strategy.' }),\n    };\n\n    public ai = {\n        oracle: {\n            simulate: (prompt: string): Promise<SimulationResult> => this.simulateDelay(API_EXAMPLE_SIMULATION),\n            simulateAdvanced: (scenarios: any) => this.simulateDelay({ simulationId: 'sim_adv_123', status: 'completed' }),\n        },\n        incubator: {\n            submitPitch: (plan: string) => this.simulateDelay({ pitchId: 'pitch_123', status: 'received' }),\n            getPitchDetails: (id: string) => this.simulateDelay({ id, stage: 'analysis' }),\n        },\n        ads: {\n            generate: (prompt: string) => this.simulateDelay({ operationId: 'op_video_123', status: 'processing' }),\n            list: () => this.simulateDelay([]),\n        }\n    };\n\n    public corporate = {\n        cards: {\n            list: (): Promise<CorporateCard[]> => this.simulateDelay(MOCK_CORPORATE_CARDS),\n            issueVirtual: (data: any) => this.simulateDelay({ id: 'card_new_virtual', status: 'active', ...data }),\n            freeze: (id: string, freeze: boolean) => this.simulateDelay({ success: true, frozen: freeze }),\n            getTransactions: (id: string): Promise<CorporateTransaction[]> => this.simulateDelay(MOCK_CORPORATE_TRANSACTIONS.filter(t => t.cardId === id)),\n        },\n        anomalies: {\n            list: (): Promise<CorporateAnomaly[]> => this.simulateDelay(API_EXAMPLE_ANOMALIES),\n            updateStatus: (id: string, sta