              "target": "",
              "replacement": "import React, { useState, useEffect, useCallback, useMemo } from 'react';\nimport { GoogleGenAI } from \"@google/genai\";\nimport Card from './Card';\n\nconst POLLING_MESSAGES = [\n    \"Initializing Veo 3.1 model...\",\n    \"Analyzing prompt semantics...\",\n    \"Generating initial keyframes...\",\n    \"Rendering motion vectors...\",\n    \"Upscaling to high resolution...\",\n    \"Adding audio layer...\",\n    \"Finalizing video file...\"\n];\n\n// =======================================================\n// TYPE DEFINITIONS\n// =======================================================\n\nexport type AspectRatio = '16:9' | '9:16';\nexport type VideoModel = 'veo-3.1-fast-generate-preview' | 'veo-3.1-generate-preview';\n\nexport interface GenerationSettings {\n    model: VideoModel;\n    aspectRatio: AspectRatio;\n    resolution: '720p' | '1080p';\n}\n\nexport interface VideoAsset {\n    id: string;\n    projectId: string;\n    url: string;\n    prompt: string;\n    creationDate: string;\n    settings: GenerationSettings;\n    isFavorite: boolean;\n}\n\nexport interface AdProject {\n    id: string;\n    name: string;\n    lastModified: string;\n    assets: VideoAsset[];\n}\n\n// =======================================================\n// MOCK BACKEND\n// =======================================================\n\nexport class MockBackendAPI {\n    private projects: AdProject[] = [];\n    constructor() { this.load(); }\n    private load() {\n        const stored = localStorage.getItem('ai_ad_studio_projects');\n        if (stored) {\n            this.projects = JSON.parse(stored);\n        } else {\n            this.projects = [{ id: 'proj_default', name: 'Global Launch 2025', lastModified: new Date().toISOString(), assets: [] }];\n            this.save();\n        }\n    }\n    private save() { localStorage.setItem('ai_ad_studio_projects', JSON.stringify(this.projects)); }\n    public async getProjects() { return [...this.projects]; }\n    public async createProject(name: string) {\n        const p = { id: `proj_${Date.now()}`, name, lastModified: new Date().toISOString(), assets: [] };\n        this.projects.push(p);\n        this.save();\n        return p;\n    }\n    public async addAsset(projectId: string, asset: Omit<VideoAsset, 'id'>) {\n        const p = this.projects.find(x => x.id === projectId);\n        if (!p) return;\n        const newAsset = { ...asset, id: `asset_${Date.now()}` };\n        p.assets.unshift(newAsset);\n        p.lastModified = new Date().toISOString();\n        this.save();\n        return newAsset;\n    }\n    public async deleteAsset(projectId: string, assetId: string) {\n        const p = this.projects.find(x => x.id === projectId);\n        if (p) {\n            p.assets = p.assets.filter(a => a.id !== assetId);\n            this.save();\n        }\n    }\n}\n\nconst mockApi = new MockBackendAPI();\n\n// =======================================================\n// SUB-COMPONENTS\n// =======================================================\n\nconst ProjectSidebar: React.FC<{\n    projects: AdProject[];\n    currentProjectId: string | null;\n    onSelect: (id: string) => void;\n    onCreate: (name: string) => void;\n}> = ({ projects, currentProjectId, onSelect, onCreate }) => {\n    const [name, setName] = useState('');\n    return (\n        <div className=\"w-64 bg-gray-900/50 border-r border-gray-800 p-4 flex flex-col h-full\">\n            <h3 className=\"text-lg font-bold text-white mb-4\">Ad Campaigns</h3>\n            <div className=\"flex gap-2 mb-6\">\n                <input\n                    value={name}\n                    onChange={e => setName(e.target.value)}\n                    placeholder=\"New campaign...\"\n                    className=\"flex-1 bg-gray-800 border border-gray-700 rounded p-2 text-sm text-white focus:outline-none focus:ring-1 focus:ring-cyan-500\"\n                />\n                <button onClick={() => { if(name.trim()) { onCreate(name); setName(''); } }} className=\"bg-cyan-600 px-3 rounded text-white font-bold hover:bg-cyan-700 transition-colors\">+</button>\n            </div>\n            <div className=\"flex-1 overflow-y-auto space-y-1\">\n                {projects.map(p => (\n                    <button\n                        key={p.id}\n                        onClick={() => onSelect(p.id)}\n                        className={`w-full text-left p-3 rounded-lg text-sm transition-all ${currentProjectId === p.id ? 'bg-cyan-600/20 text-cyan-400 border-l-4 border-cyan-400' : 'text-gray-400 hover:bg-gray-800'}`}\n                    >\n                        {p.name}\n                    </button>\n                ))}\n            </div>\n        </div>\n    );\n};\n\nconst GenerationControls: React.FC<{\n    settings: GenerationSettings;\n    onChange: (s: Partial<GenerationSettings>) => void;\n    disabled: boolean;\n}> = ({ settings, onChange, disabled }) => (\n    <Card title=\"Production Controls\">\n        <div className=\"space-y-4\">\n            <div>\n                <label className=\"block text-xs text-gray-500 mb-1 font-semibold uppercase tracking-wider\">Aspect Ratio</label>\n                <select\n                    disabled={disabled}\n                    value={settings.aspectRatio}\n                    onChange={e => onChange({ aspectRatio: e.target.value as AspectRatio })}\n                    className=\"w-full bg-gray-800 border border-gray-700 rounded-lg p-2 text-sm text-white focus:ring-1 focus:ring-cyan-500 outline-none\"\n                >\n                    <option value=\"16:9\">Widescreen (16:9)</option>\n                    <option value=\"9:16\">Mobile Portrait (9:16)</option>\n                </select>\n            </div>\n            <div>\n                <label className=\"block text-xs text-gray-500 mb-1 font-semibold uppercase tracking-wider\">Resolution</label>\n                <select\n                    disabled={disabled}\n                    value={settings.resolution}\n                    onChange={e => onChange({ resolution: e.target.value as any })}\n                    className=\"w-full bg-gray-800 border border-gray-700 rounded-lg p-2 text-sm text-white focus:ring-1 focus:ring-cyan-500 outline-none\"\n                >\n                    <option value=\"720p\">720p HD</option>\n                    <option value=\"1080p\">1080p Full HD</option>\n                </select>\n            </div>\n             <div className=\"pt-4 border-t border-gray-800\">\n                <p className=\"text-[10px] text-gray-500 italic\">Note: High-fidelity generation typically takes 2-4 minutes depending on queue latency.</p>\n            </div>\n        </div>\n    </Card>\n);\n\n// =======================================================\n// MAIN COMPONENT\n// =======================================================\n\nconst AIAdStudioView: React.FC = () => {\n    const [hasKey, setHasKey] = useState<boolean | null>(null);\n    const [projects, setProjects] = useState<AdProject[]>([]);\n    const [currentProjectId, setCurrentProjectId] = useState<string | null>(null);\n    const [prompt, setPrompt] = useState('A cinematic 4K video of a glowing digital bank vault opening to reveal a radiant sun, photorealistic, 8k.');\n    const [settings, setSettings] = useState<GenerationSettings>({ model: 'veo-3.1-fast-generate-preview', aspectRatio: '16:9', resolution: '720p' });\n    const [isGenerating, setIsGenerating] = useState(false);\n    const [pollingIndex, setPollingIndex] = useState(0);\n    const [error, setError] = useState<string | null>(null);\n\n    const currentProject = projects.find(p => p.id === currentProjectId);\n\n    useEffect(() => {\n        const checkKey = async () => {\n            const selected = await window.aistudio.hasSelectedApiKey();\n            setHasKey(selected);\n        };\n        checkKey();\n        mockApi.getProjects().then(p => {\n            setProjects(p);\n            if (p.length > 0) setCurrentProjectId(p[0].id);\n        });\n    }, []);\n\n    const handleSelectKey = async () => {\n        await window.aistudio.openSelectKey();\n        setHasKey(true);\n    };\n\n    const handleGenerate = async () => {\n        if (!currentProjectId) return;\n        setIsGenerating(true);\n        setError(null);\n        \n        const interval = setInterval(() => {\n            setPollingIndex(idx => (idx + 1) % POLLING_MESSAGES.length);\n        }, 3500);\n\n        try {\n            const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });\n            let operation = await ai.models.generateVideos({\n                model: settings.model,\n                prompt: prompt,\n                config: {\n                    numberOfVideos: 1,\n                    resolution: settings.resolution,\n                    aspectRatio: settings.aspectRatio\n                }\n            });\n\n            while (!operation.done) {\n                await new Promise(r => setTimeout(r, 10000));\n                operation = await ai.operations.getVideosOperation({ operation });\n            }\n\n            const downloadLink = operation.response?.generatedVideos?.[0]?.video?.uri;\n            if (!downloadLink) throw new Error(\"Video generation yielded no results.\");\n\n            const finalUrl = `${downloadLink}&key=${process.env.API_KEY}`;\n            const newAsset = await mockApi.addAsset(currentProjectId, {\n                projectId: currentProjectId,\n                url: finalUrl,\n                prompt,\n                settings,\n                creationDate: new Date().toISOString(),\n                isFavorite: false\n            });\n\n            if (newAsset) {\n                setProjects(prev => prev.map(p => p.id === currentProjectId ? { ...p, assets: [newAsset, ...p.assets] } : p));\n            }\n\n        } catch (err: any) {\n            console.error(\"Veo Generation Error:\", err);\n            if (err.message?.includes(\"Requested entity was not found\")) {\n                setHasKey(false);\n                setError(\"Your API key session has expired. Please re-select your key.\");\n            } else {\n                setError(err.message || \"Failed to generate video. Please try again with a different prompt.\");\n            }\n        } finally {\n            clearInterval(interval);\n            setIsGenerating(false);\n        }\n    };\n\n    const handleDeleteAsset = async (assetId: string) => {\n        if (!currentProjectId || !confirm(\"Delete this video asset permanently?\")) return;\n        await mockApi.deleteAsset(currentProjectId, assetId);\n        setProjects(prev => prev.map(p => p.id === currentProjectId ? { ...p, assets: p.assets.filter(a => a.id !== assetId) } : p));\n    };\n\n    if (hasKey === null) return (\n        <div className=\"h-full flex items-center justify-center bg-gray-950\">\n            <div className=\"w-12 h-12 border-4 border-cyan-500/30 border-t-cyan-500 rounded-full animate-spin\"></div>\n        </div>\n    );\n\n    if (!hasKey) {\n        return (\n            <div className=\"h-full flex items-center justify-center bg-gray-950 p-6\">\n                <Card title=\"Professional Video Engine Required\" className=\"max-w-md text-center\">\n                    <div className=\"mb-6 flex justify-center\">\n                         <div className=\"p-4 bg-cyan-500/10 rounded-full\">\n                            <svg className=\"w-12 h-12 text-cyan-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z\" />\n                            </svg>\n                         </div>\n                    </div>\n                    <p className=\"text-gray-400 mb-6 leading-relaxed\">\n                        The Veo 3.1 video generation system requires a paid Google Cloud Project API key. This enables high-performance rendering for cinematic advertisements.\n                    </p>\n                    <a \n                        href=\"https://ai.google.dev/gemini-api/docs/billing\" \n                        target=\"_blank\" \n                        className=\"text-cyan-400 text-sm hover:underline block mb-8 font-medium\"\n                    >\n                        View Billing & Project Setup Documentation\n                    </a>\n                    <button\n                        onClick={handleSelectKey}\n                        className=\"w-full py-4 bg-cyan-600 hover:bg-cyan-700 text-white font-bold rounded-xl shadow-lg shadow-cyan-900/20 transition-all transform hover:scale-105 active:scale-95\"\n                    >\n                        Authenticate API Key\n                    </button>\n                </Card>\n            </div>\n        );\n    }\n\n    return (\n        <div className=\"flex h-full bg-gray-950 text-white overflow-hidden\">\n            <ProjectSidebar \n                projects={projects} \n                currentProjectId={currentProjectId} \n                onSelect={setCurrentProjectId}\n                onCreate={async (name) => {\n                    const p = await mockApi.createProject(name);\n                    setProjects(prev => [...prev, p]);\n                    setCurrentProjectId(p.id);\n                }}\n            />\n            \n            <main className=\"flex-1 p-8 space-y-8 overflow-y-auto custom-scrollbar\">\n                <header className=\"flex justify-between items-center\">\n                    <div>\n                        <h2 className=\"text-4xl font-extrabold tracking-tight text-white\">AI Ad Studio</h2>\n                        <p className=\"text-gray-500 mt-1\">Cinematic campaign generation powered by Veo 3.1</p>\n                    </div>\n                    <div className=\"text-right\">\n                        <p className=\"text-xs font-semibold text-gray-500 uppercase tracking-widest\">Active Project</p>\n                        <h3 className=\"text-xl font-bold text-cyan-400\">{currentProject?.name}</h3>\n                    </div>\n                </header>\n\n                <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n                    <div className=\"lg:col-span-2 space-y-8\">\n                        <Card title=\"Scriptwriter AI\">\n                            <div className=\"space-y-4\">\n                                <p className=\"text-sm text-gray-400\">Describe the scene you want to visualize. Be specific about lighting, camera movement, and subject details.</p>\n                                <textarea\n                                    value={prompt}\n                                    onChange={e => setPrompt(e.target.value)}\n                                    disabled={isGenerating}\n                                    className=\"w-full h-40 bg-gray-900 border border-gray-800 rounded-xl p-4 text-sm focus:ring-2 focus:ring-cyan-500 focus:border-transparent outline-none transition-all resize-none\"\n                                    placeholder=\"e.g. A slow tracking shot of a futuristic metropolis during the blue hour...\"\n                                />\n                                <button\n                                    onClick={handleGenerate}\n                                    disabled={isGenerating || !prompt.trim()}\n                                    className=\"w-full py-4 bg-cyan-600 hover:bg-cyan-700 text-white font-bold rounded-xl disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-3 shadow-lg shadow-cyan-900/20 transition-all\"\n                                >\n                                    {isGenerating ? (\n                                        <>\n                                            <div className=\"w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin\"></div>\n                                            <span className=\"animate-pulse\">{POLLING_MESSAGES[pollingIndex]}</span>\n                                        </>\n                                    ) : \"Generate High-Fidelity Ad\"}\n                                </button>\n                                {error && (\n                                    <div className=\"p-4 bg-red-900/20 border border-red-900/30 rounded-lg\">\n                                        <p className=\"text-xs text-red-400 text-center font-medium\">{error}</p>\n                                    </div>\n                                )}\n                            </div>\n                        </Card>\n\n                        <div className=\"space-y-4\">\n                            <h4 className=\"text-lg font-bold text-white flex items-center gap-2\">\n                                <svg className=\"w-5 h-5 text-cyan-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\" />\n                                </svg>\n                                Generated Asset Library\n                            </h4>\n                            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                                {currentProject?.assets.map(asset => (\n                                    <div key={asset.id} className=\"group relative bg-gray-900 rounded-2xl overflow-hidden border border-gray-800 hover:border-cyan-500/50 transition-all shadow-xl\">\n                                        <div className=\"relative aspect-video bg-black\">\n                                            <video \n                                                src={asset.url} \n                                                className=\"w-full h-full object-cover\" \n                                                muted \n                                                loop \n                                                onMouseEnter={e => e.currentTarget.play()} \n                                                onMouseLeave={e => { e.currentTarget.pause(); e.currentTarget.currentTime = 0; }}\n                                            />\n                                            <div className=\"absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4\">\n                                                 <p className=\"text-[10px] text-white line-clamp-2\">{asset.prompt}</p>\n                                            </div>\n                                        </div>\n                                        <div className=\"p-4 flex justify-between items-center bg-gray-900/80\">\n                                            <div className=\"space-y-1\">\n                                                <p className=\"text-[10px] font-bold text-gray-500 uppercase tracking-tighter\">{new Date(asset.creationDate).toLocaleDateString()}</p>\n                                                <p className=\"text-[10px] text-cyan-500 font-mono\">{asset.settings.resolution} • {asset.settings.aspectRatio}</p>\n                                            </div>\n                                            <div className=\"flex gap-2\">\n                                                <a href={asset.url} target=\"_blank\" rel=\"noopener\" className=\"p-2 bg-gray-800 hover:bg-gray-700 rounded-lg text-gray-300 transition-colors\" title=\"Download MP4\">\n                                                    <svg className=\"w-4 h-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                                                        <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M4 16v1a2 2 0 002 2h12a2 2 0 002-2v-1m-4-4l-4 4m0 0l-4-4m4 4V4\" />\n                                                    </svg>\n                                                </a>\n                                                <button onClick={() => handleDeleteAsset(asset.id)} className=\"p-2 bg-gray-800 hover:bg-red-900/50 rounded-lg text-gray-400 hover:text-red-400 transition-colors\">\n                                                    <svg className=\"w-4 h-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                                                        <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16\" />\n                                                    </svg>\n                                                </button>\n                                            </div>\n                                        </div>\n                                    </div>\n                                ))}\n                                {currentProject?.assets.length === 0 && (\n                                    <div className=\"col-span-full py-20 text-center border-2 border-dashed border-gray-800 rounded-3xl\">\n                                        <p className=\"text-gray-600 font-medium italic\">No assets generated for this campaign yet.</p>\n                                    </div>\n                                )}\n                            </div>\n                        </div>\n                    </div>\n\n                    <div className=\"space-y-8\">\n                        <GenerationControls \n                            settings={settings} \n                            onChange={s => setSettings(prev => ({ ...prev, ...s }))} \n                            disabled={isGenerating} \n                        />\n                        \n                        <Card title=\"Strategy Corner\">\n                            <div className=\"space-y-4\">\n                                <div className=\"p-4 bg-indigo-500/10 rounded-xl border border-indigo-500/20\">\n                                    <h5 className=\"text-xs font-bold text-indigo-300 uppercase mb-2\">Director's Pro-Tip</h5>\n                                    <p className=\"text-xs text-gray-400 leading-relaxed\">\n                                        Use \"blue hour\" or \"golden hour\" for natural lighting, and specify \"wide shot\" or \"close up\" to guide the model's composition.\n                                    </p>\n                                </div>\n                                <div className=\"p-4 bg-emerald-500/10 rounded-xl border border-emerald-500/20\">\n                                    <h5 className=\"text-xs font-bold text-emerald-300 uppercase mb-2\">Market Insight</h5>\n                                    <p className=\"text-xs text-gray-400 leading-relaxed\">\n                                        9:16 portrait videos see 4x higher engagement on social channels like TikTok and Instagram Reels.\n                                    </p>\n                                </div>\n                            </div>\n                        </Card>\n                    </div>\n                </div>\n            </main>\n            <style>{`\n                .custom-scrollbar::-webkit-scrollbar { width: 6px; }\n                .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }\n                .custom-scrollbar::-webkit-scrollbar-thumb { background: #374151; border-radius: 10px; }\n                .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #4b5563; }\n            `}</style>\n        </div>\n    );\n};\n\nexport default AIAdStudioView;"
