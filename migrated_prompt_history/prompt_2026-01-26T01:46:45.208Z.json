n\n  const [geminiApiKey, setGeminiApiKeyState] = useState<string | null>(() => {\n      return localStorage.getItem('geminiApiKey');\n  });\n    \n  const [modernTreasuryApiKey, setModernTreasuryApiKey_] = useState<string | null>(() => localStorage.getItem('modernTreasuryApiKey'));\n  const [modernTreasuryOrganizationId, setModernTreasuryOrganizationId_] = useState<string | null>(() => localStorage.getItem('modernTreasuryOrganizationId'));\n  \n  const [userProfile, setUserProfile] = useState<UserProfile | null>(null);\n\n\n  const setGeminiApiKey = (key: string) => {\n      if (key) {\n          localStorage.setItem('geminiApiKey', key);\n          setGeminiApiKeyState(key);\n      } else {\n          localStorage.removeItem('geminiApiKey');\n          setGeminiApiKeyState(null);\n      }\n  };\n    \n  const setModernTreasuryApiKey = (key: string) => {\n      if (key) {\n          localStorage.setItem('modernTreasuryApiKey', key);\n          setModernTreasuryApiKey_(key);\n      } else {\n          localStorage.removeItem('modernTreasuryApiKey');\n          setModernTreasuryApiKey_(null);\n      }\n  };\n\n  const setModernTreasuryOrganizationId = (id: string) => {\n    if (id) {\n        localStorage.setItem('modernTreasuryOrganizationId', id);\n        setModernTreasuryOrganizationId_(id);\n    } else {\n        localStorage.removeItem('modernTreasuryOrganizationId');\n        setModernTreasuryOrganizationId_(null);\n    }\n  };\n\n  // State for new dashboard widgets\n  const [subscriptions] = useState<Subscription[]>(MOCK_SUBSCRIPTIONS);\n  const [creditScore] = useState<CreditScore>(MOCK_CREDIT_SCORE);\n  const [upcomingBills] = useState<UpcomingBill[]>(MOCK_UPCOMING_BILLS);\n  const [savingsGoals, setSavingsGoals] = useState<SavingsGoal[]>(MOCK_SAVINGS_GOALS);\n  const [marketMovers] = useState<MarketMover[]>(MOCK_MARKET_MOVERS);\n  const [rewardPoints, setRewardPoints] = useState<RewardPoints>(MOCK_REWARD_POINTS);\n  \n  // State for Financial Goals\n  const [financialGoals, setFinancialGoals] = useState<FinancialGoal[]>(MOCK_FINANCIAL_GOALS);\n\n  // State for Crypto & Web3 Hub\n  const [cryptoAssets, setCryptoAssets] = useState<CryptoAsset[]>(MOCK_CRYPTO_ASSETS);\n  const [nftAssets, setNftAssets] = useState<NFTAsset[]>([]);\n  const [paymentOperations, setPaymentOperations] = useState<PaymentOperation[]>(MOCK_PAYMENT_OPERATIONS);\n  const [walletInfo, setWalletInfo] = useState<WalletInfo | null>(null);\n  const [virtualCard, setVirtualCard] = useState<VirtualCard | null>(null);\n\n  // State for dynamic AI insights\n  const [aiInsights, setAiInsights] = useState<AIInsight[]>([]);\n  const [isInsightsLoading, setIsInsightsLoading] = useState(false);\n  const [isImportingData, setIsImportingData] = useState(false);\n\n  // State for Corporate Command Center\n  const [corporateCards, setCorporateCards] = useState<CorporateCard[]>(MOCK_CORPORATE_CARDS);\n  const [corporateTransactions, setCorporateTransactions] = useState<CorporateTransaction[]>(MOCK_CORPORATE_TRANSACTIONS);\n  const [counterparties, setCounterparties] = useState<Counterparty[]>(MOCK_COUNTERPARTIES);\n\n\n  // State for new interactive features\n  const [notifications, setNotifications] = useState<Notification[]>(MOCK_NOTIFICATIONS);\n  \n  // State for new views\n  const [rewardItems] = useState<RewardItem[]>(MOCK_REWARD_ITEMS);\n  const [apiStatus, setApiStatus] = useState<APIStatus[]>(MOCK_API_STATUS);\n  const [creditFactors] = useState<CreditFactor[]>(MOCK_CREDIT_FACTORS);\n\n  // --- FETCH INITIAL DATA FROM API ---\n  useEffect(() => {\n      const fetchData = async () => {\n          try {\n              // Parallel data fetching for efficiency\n              const [\n                  userProfileData,\n                  accountsData,\n                  transactionsData,\n                  portfoliosData,\n                  budgetsData,\n                  corpCardsData,\n                  corpAnomaliesData\n              ] = await Promise.allSettled([\n                  quantumClient.users.getMe(),\n                  quantumClient.accounts.list(),\n                  quantumClient.transactions.list(),\n                  quantumClient.investments.getPortfolios(),\n                  quantumClient.budgets.list(),\n                  quantumClient.corporate.cards.list(),\n                  quantumClient.corporate.anomalies.list()\n              ]);\n\n              // Handle User Profile\n              if (userProfileData.status === 'fulfilled') {\n                  setUserProfile(userProfileData.value);\n                  // Sync gamification state if present in profile\n                  if (userProfileData.value.gamificationLevel) {\n                      setGamification(prev => ({...prev, level: userProfileData.value.gamificationLevel, score: userProfileData.value.loyaltyPoints}));\n                  }\n              }\n\n              // Handle Accounts\n              if (accountsData.status === 'fulfilled' && accountsData.value.data) {\n                  setLinkedAccounts(accountsData.value.data);\n              }\n\n              // Handle Transactions\n              if (transactionsData.status === 'fulfilled' && transactionsData.value.data) {\n                  setTransactions(transactionsData.value.data);\n              }\n\n              // Handle Portfolios / Assets\n              if (portfoliosData.status === 'fulfilled' && portfoliosData.value.data) {\n                  const portfolioAssets: Asset[] = [];\n                  portfoliosData.value.data.forEach((p: any) => {\n                      if (p.holdings) {\n                          p.holdings.forEach((h: any) => {\n                              portfolioAssets.push({\n                                  name: h.name,\n                                  value: h.marketValue,\n                                  color: '#06b6d4', // Default color, ideally from API\n                                  ticker: h.symbol,\n                                  performanceYTD: 5 // Mock performance if missing\n                              });\n                          });\n                      }\n                  });\n                  if (portfolioAssets.length > 0) {\n                      setAssets(portfolioAssets);\n                  }\n              }\n\n              // Handle Budgets\n              if (budgetsData.status === 'fulfilled' && budgetsData.value.data) {\n                  setBudgets(budgetsData.value.data);\n              }\n\n              // Handle Corporate Cards\n              if (corpCardsData.status === 'fulfilled' && corpCardsData.value.data) {\n                  setCorporateCards(corpCardsData.value.data);\n              }\n\n          } catch (error) {\n              console.error(\"Failed to fetch initial data from Quantum API:\", error);\n          }\n      };\n\n      fetchData();\n  }, []);\n\n\n  useEffect(() => {\n    setApiStatus(prev => prev.map(s => {\n        if (s.provider === 'Google Gemini') {\n            return { ...s, status: geminiApiKey ? 'Operational' : 'Major Outage' };\n        }\n        if (s.provider === 'Modern Treasury') {\n            return { ...s, status: (modernTreasuryApiKey && modernTreasuryOrganizationId) ? 'Operational' : 'Major Outage' };\n        }\n        return s;\n    }));\n  }, [geminiApiKey, modernTreasuryApiKey, modernTreasuryOrganizationId]);\n\n\n  const setCustomBackgroundUrl = (url: string) => {\n      localStorage.setItem('customBackgroundUrl', url);\n      setCustomBackgroundUrlState(url);\n      localStorage.setItem('activeIllusion', 'none');\n      setActiveIllusionState('none');\n  };\n\n  const setActiveIllusion = (illusion: IllusionType) => {\n    localStorage.setItem('activeIllusion', illusion);\n    setActiveIllusionState(illusion);\n    if (illusion !== 'none') {\n      localStorage.removeItem('customBackgroundUrl');\n      setCustomBackgroundUrlState(null);\n    }\n  };\n  \n  const updateGamification = (points: number) => {\n    setGamification(prev => {\n        const newScore = prev.score + points;\n        const newLevel = Math.floor(newScore / SCORE_PER_LEVEL) + 1;\n        const newProgress = ((newScore % SCORE_PER_LEVEL) / SCORE_PER_LEVEL) * 100;\n        const newLevelName = LEVEL_NAMES[Math.min(newLevel - 1, LEVEL_NAMES.length - 1)];\n        const newCredits = prev.credits + (points > 0 ? Math.floor(points / 2) : 0);\n\n        return { score: newScore, level: newLevel, levelName: newLevelName, progress: newProgress, credits: newCredits };\n    });\n  };\n\n  const generateDashboardInsights = useCallback(async () => {\n    setIsInsightsLoading(true);\n     if (!geminiApiKey) {\n        setAiInsights([{ id: 'error_no_key', title: 'API Key Not Set', description: 'Please configure your Google Gemini API key in the API Status view.', urgency: 'high' }]);\n        setIsInsightsLoading(false);\n        return;\n    }\n    try {\n        const ai = new GoogleGenAI({ apiKey: geminiApiKey });\n        const recentTransactionsSummary = transactions.slice(0, 10).map(t => `${t.description}: $${t.amount.toFixed(2)} (${t.type})`).join(', ');\n        \n        const prompt = `You are Quantum, a proactive AI financial advisor. Analyze the user's recent transactions to generate 3 diverse, actionable insights. Your insights must be concise. If an insight is about high spending, provide chartData for the top 3 items. Format your response as a JSON object that strictly adheres to the provided schema. Do not include any text outside of the JSON object.\n\nRecent Transactions: ${recentTransactionsSummary}`;\n\n        const response = await ai.models.generateContent({\n            model: 'gemini-2.5-flash',\n            contents: prompt,\n            config: {\n                responseMimeType: \"application/json\",\n                responseSchema: {\n                    type: Type.OBJECT,\n                    properties: {\n                        insights: {\n                            type: Type.ARRAY,\n                            description: \"A list of 3 diverse financial insights.\",\n                            items: {\n                                type: Type.OBJECT,\n                                properties: {\n                                    id: { type: Type.STRING, description: \"A unique identifier for the insight, e.g., 'insight_1'.\" },\n                                    title: { type: Type.STRING, description: \"A short, catchy title for the insight (max 10 words).\" },\n                                    description: { type: Type.STRING, description: \"A concise, user-friendly description of the insight (max 2 sentences).\" },\n                                    urgency: { type: Type.STRING, description: \"The urgency level of the insight.\", enum: ['low', 'medium', 'high'] },\n                                    chartData: {\n                                        type: Type.ARRAY,\n                                        description: \"Optional. If the insight is about spending, provide data for a bar chart. Include the top 3 items.\",\n                                        nullable: true,\n                                        items: {\n                                            type: Type.OBJECT,\n                                            properties: {\n                                                name: { type: Type.STRING, description: \"The name of the item for the chart (e.g., a specific transaction description).\" },\n                                                value: { type: Type.NUMBER, description: \"The value (amount) for the chart.\" }\n                                            },\n                                            required: [\"name\", \"value\"]\n                                        }\n                                    }\n                                },\n                                required: [\"id\", \"title\", \"description\", \"urgency\"]\n                            }\n                        }\n                    },\n                    required: [\"insights\"]\n                }\n            }\n        });\n        \n        const parsedResponse = JSON.parse(response.text);\n        if (parsedResponse.insights) {\n            setAiInsights(parsedResponse.insights);\n        }\n\n    } catch (error) {\n        console.error(\"Failed to generate AI insights:\", error);\n        // Fallback to a default insight on error\n        setAiInsights([{ id: 'error_1', title: 'Analysis Paused', description: 'Could not fetch fresh insights at this time. Displaying last known data.', urgency: 'low' }]);\n    } finally {\n        setIsInsightsLoading(false);\n    }\n}, [transactions, geminiApiKey]);\n\nuseEffect(() => {\n    // Only generate insights if we have data or api key\n    if (geminiApiKey) {\n        generateDashboardInsights(); \n        const intervalId = setInterval(generateDashboardInsights, 35000);\n        return () => clearInterval(intervalId);\n    }\n}, [generateDashboardInsights, geminiApiKey]);\n\n  const handlePlaidSuccess = (publicToken: string, metadata: any) => {\n    setIsImportingData(true);\n    console.log(\"Plaid Link Success!\", { publicToken, metadata });\n\n    const newAccount: LinkedAccount = {\n        id: metadata.institution.institution_id,\n        name: metadata.institution.name,\n        mask: metadata.accounts[0].mask,\n    };\n    \n    if (!linkedAccounts.some(acc => acc.id === newAccount.id)) {\n        setLinkedAccounts(prev => [...prev, newAccount]);\n    }\n    \n    // In a real app, we would send the publicToken to the backend here.\n    // For this demo, we simulate fetching new data after a delay.\n    setTimeout(() => {\n        // Fetch fresh data from API to simulate sync\n        quantumClient.transactions.list().then(res => {\n             if(res.data && res.data.length > 0) setTransactions(res.data);\n             setIsImportingData(false);\n        }).catch(err => {\n             console.error(\"Failed to sync transactions\", err);\n             setIsImportingData(false);\n        });\n    }, 2500);\n  };\n\n  const addTransaction = (tx: Transaction) => {\n    setTransactions(prev => [tx, ...prev]);\n    \n    if (tx.type === 'expense') {\n        const spent = tx.amount;\n        setSpendingForNextTree(prev => {\n            let remaining = prev - spent;\n            if (remaining <= 0) {\n                const treesToAdd = Math.floor(Math.abs(remaining) / COST_PER_TREE) + 1;\n                setTreesPlanted(t => t + treesToAdd);\n                remaining = COST_PER_TREE - (Math.abs(remaining) % COST_PER_TREE);\n            }\n            return remaining;\n        });\n        \n        // Update Budget logic if matching category found\n        setBudgets(prev => prev.map(b => {\n            if (b.name === tx.category) {\n                return { ...b, spent: b.spent + tx.amount, remaining: (b.remaining || 0) - tx.amount };\n            }\n            return b;\n        }));\n    }\n    \n    updateGamification(10);\n  };\n\n  const addBudget = (budgetData: Omit<BudgetCategory, 'id' | 'spent' | 'color'>) => {\n      const newBudget: BudgetCategory = {\n          ...budgetData,\n          id: `budget_${Date.now()}`,\n          spent: 0,\n          color: '#' + Math.floor(Math.random()*16777215).toString(16),\n          remaining: budgetData.limit,\n          status: 'active'\n      };\n      setBudgets(prev => [...prev, newBudget]);\n  };\n\n  const unlinkAccount = (id: string) => {\n      setLinkedAccounts(prev => prev.filter(acc => acc.id !== id));\n  };\n\n  const pitchBusinessPlan = async (plan: string) => {\n      setWeaverState(prev => ({ ...prev, stage: WeaverStage.Analysis, businessPlan: plan }));\n      \n      try {\n          const response = await quantumClient.ai.incubator.submitPitch({ \n              businessPlan: plan, \n              financialProjections: {}, // Mock data\n              foundingTeam: [], // Mock data\n              marketOpportunity: \"High potential\" // Mock data\n          });\n          \n          // @ts-ignore\n          if (response.pitchId) {\n               // Simulate transition to feedback/questions\n               setTimeout(async () => {\n                   try {\n                       const details: any = await quantumClient.ai.incubator.getPitchDetails(response.pitchId);\n                       setWeaverState(prev => ({\n                           ...prev,\n                           stage: WeaverStage.Test,\n                           questions: details.questions || [\n                               { id: 'q1', question: \"How does your solution scale?\", category: \"Technology\" },\n                               { id: 'q2', question: \"What is your customer acquisition cost?\", category: \"Market\" }\n                           ],\n                           feedback: details.feedbackSummary || \"Initial analysis complete. Proceeding to detailed assessment.\"\n                       }));\n                   } catch (e) {\n                       console.error(e);\n                   }\n               }, 3000);\n          }\n      } catch (error) {\n          setWeaverState(prev => ({ ...prev, stage: WeaverStage.Error, error: \"Failed to submit plan to Quantum Weaver.\" }));\n      }\n  };\n\n  const simulateTestPass = async () => {\n      setWeaverState(prev => ({ ...prev, stage: WeaverStage.FinalReview }));\n      setTimeout(() => {\n          setWeaverState(prev => ({\n              ...prev,\n              stage: WeaverStage.Approved,\n              loanAmount: 1500000,\n              coachingPlan: {\n                  summary: \"Your plan shows high potential. We've outlined a roadmap for your first 6 months.\",\n                  monthlyContribution: 0, \n                  steps: [\n                      { title: \"Incorporate Entity\", description: \"Form a C-Corp in Delaware.\", timeline: \"Week 1\" },\n                      { title: \"Hire CTO\", description: \"Recruit a technical co-founder.\", timeline: \"Month 1\" },\n                      { title: \"MVP Development\", description: \"Build initial prototype.\", timeline: \"Month 3\" }\n                  ]\n              }\n          }));\n          updateGamification(500);\n      }, 4000);\n  };\n  \n  const addFinancialGoal = (goalData: Omit<FinancialGoal, 'id' | 'plan' | 'currentAmount'>) => {\n      const newGoal: FinancialGoal = {\n          id: `goal_${Date.now()}`,\n          ...goalData,\n          currentAmount: 0,\n          plan: null,\n      };\n      setFinancialGoals(prev => [...prev, newGoal]);\n  };\n\n  const contributeToGoal = (goalId: string, amount: number) => {\n      setFinancialGoals(prev => prev.map(g => {\n          if (g.id === goalId) {\n              const newAmount = g.currentAmount + amount;\n              // Mock contribution history\n              const newContribution: Contribution = {\n                  id: `contrib_${Date.now()}`,\n                  amount: amount,\n                  date: new Date().toISOString(),\n                  type: 'manual'\n              };\n              const updatedGoal = { ...g, currentAmount: newAmount, contributions: [...(g.contributions || []), newContribution] };\n              return updatedGoal;\n          }\n          return g;\n      }));\n      addTransaction({\n          id: `tx_goal_${Date.now()}`,\n          type: 'expense',\n          category: 'Savings',\n          description: `Transfer to Goal`,\n          amount: amount,\n          date: new Date().toISOString().split('T')[0],\n      });\n  };\n\n  const generateGoalPlan = async (goalId: string) => {\n      // Find goal\n      const goal = financialGoals.find(g => g.id === goalId);\n      if(!goal) return;\n\n      // Mock AI generation delay\n      await new Promise(resolve => setTimeout(resolve, 2000));\n\n      const mockPlan: AIGoalPlan = {\n          feasibilitySummary: `Based on your current income and spending, reaching $${goal.targetAmount} by ${new Date(goal.targetDate).toLocaleDateString()} is ambitious but achievable.`,\n          monthlyContribution: Math.ceil((goal.targetAmount - goal.currentAmount) / 24), // Rough calc\n          steps: [\n              { title: \"Optimize Subscriptions\", description: \"Cancel unused streaming services to free up $50/mo.\", category: \"Budgeting\" },\n              { title: \"Automate Transfers\", description: `Set up auto-transfer of your monthly contribution.`, category: \"Savings\" }\n          ]\n      };\n\n      setFinancialGoals(prev => prev.map(g => g.id === goalId ? { ...g, plan: mockPlan } : g));\n  };\n  \n  const connectWallet = () => {\n      setTimeout(() => {\n          setWalletInfo({\n              address: \"0x71C...9A23\",\n              balance: 4.25\n          });\n      }, 1000);\n  };\n  \n  const issueCard = () => {\n      // Call API\n      quantumClient.corporate.cards.issueVirtual({\n          holderName: userProfile?.name || \"The Visionary\",\n          expirationDate: \"2026-12-31\",\n          controls: { monthlyLimit: 5000 }\n      }).then(() => {\n          setVirtualCard({\n              cardNumber: \"4592 0012 9934 8821\",\n              cvv: \"843\",\n              expiry: \"12/28\",\n              holderName: userProfile?.name || \"The Visionary\"\n          });\n      });\n  };\n  \n  const buyCrypto = (usdAmount: number, cryptoTicker: string) => {\n      setCryptoAssets(prev => prev.map(asset => {\n          if (asset.ticker === cryptoTicker) {\n              const amountBought = usdAmount / (asset.value / asset.amount); // rough calc\n              return { ...asset, amount: asset.amount + amountBought, value: asset.value + usdAmount };\n          }\n          return asset;\n      }));\n      addTransaction({\n          id: `tx_crypto_${Date.now()}`,\n          type: 'expense',\n          category: 'Investments',\n          description: `Bought ${cryptoTicker}`,\n          amount: usdAmount,\n          date: new Date().toISOString().split('T')[0],\n      });\n  };\n  \n  const toggleCorporateCardFreeze = (cardId: string) => {\n      const card = corporateCards.find(c => c.id === cardId);\n      if (card) {\n          const newFrozenState = !card.frozen;\n          setCorporateCards(prev => prev.map(c => c.id === cardId ? { ...c, frozen: newFrozenState, status: newFrozenState ? 'Suspended' : 'Active' } : c));\n          quantumClient.corporate.cards.freeze(cardId, newFrozenState);\n      }\n  };\n  \n  const updateCorporateCard = (cardId: string, newControls: CorporateCardControls, newFrozenState: boolean) => {\n      setCorporateCards(prev => prev.map(c => c.id === cardId ? { ...c, controls: newControls, frozen: newFrozenState, status: newFrozenState ? 'Suspended' : 'Active' } : c));\n      quantumClient.corporate.cards.updateControls(cardId, newControls);\n  };\n  \n  const markNotificationRead = (id: string) => {\n      setNotifications(prev => prev.map(n => n.id === id ? { ...n, read: true } : n));\n      quantumClient.notifications.markRead(id);\n  };\n  \n  const mintNFT = (name: string, imageUrl: string) => {\n      const newNFT: NFTAsset = {\n          id: `nft_${Date.now()}`,\n          name: name,\n          imageUrl: imageUrl,\n          contractAddress: \"0x...\",\n          collectionName: \"Quantum Visions\",\n          blockchainNetwork: \"Ethereum\"\n      };\n      setNftAssets(prev => [...prev, newNFT]);\n  };\n  \n  const mintToken = (name: string, ticker: string, amount: number) => {\n      // Mock logic for token minting\n      alert(`Minted ${amount} ${ticker} ($${name}) on the testnet.`);\n  };\n  \n  const initiatePayment = (details: Omit<PaymentOperation, 'id' | 'status' | 'date'>) => {\n      const newOp: PaymentOperation = {\n          id: `po_${Date.now()}`,\n          ...details,\n          status: 'Processing',\n          date: new Date().toISOString().split('T')[0]\n      };\n      setPaymentOperations(prev => [newOp, ...prev]);\n      setTimeout(() => {\n          setPaymentOperations(prev => prev.map(op => op.id === newOp.id ? { ...op, status: 'Completed' } : op));\n      }, 5000);\n  };\n  \n  const redeemReward = (item: RewardItem) => {\n      if (rewardPoints.balance >= item.cost) {\n          setRewardPoints(prev => ({\n              ...prev,\n              balance: prev.balance - item.cost,\n              lastRedeemed: item.cost\n          }));\n          return true;\n      }\n      return false;\n  };\n  \n  const addCounterparty = async (data: { name: string, email: string, accountNumber: string, routingNumber: string }) => {\n      const newCP: Counterparty = {\n          id: `cp_${Date.now()}`,\n          name: data.name,\n          email: data.email,\n          send_remittance_advice: true,\n          accounts: [{\n              id: `cpa_${Date.now()}`,\n              party_name: data.name,\n              account_details: [{ account_number_safe: data.accountNumber.slice(-4) }]\n          }],\n          created_at: new Date().toISOString()\n      };\n      setCounterparties(prev => [...prev, newCP]);\n  };\n\n  const value = {\n    transactions,\n    assets,\n    impactInvestments,\n    budgets,\n    addBudget,\n    gamification,\n    impactData: {\n      treesPlanted,\n      spendingForNextTree,\n      progressToNextTree: Math.round(((COST_PER_TREE - spendingForNextTree) / COST_PER_TREE) * 100),\n    },\n    customBackgroundUrl,\n    setCustomBackgroundUrl,\n    addTransaction,\n    activeIllusion,\n    setActiveIllusion,\n    linkedAccounts,\n    unlinkAccount,\n    handlePlaidSuccess,\n    weaverState,\n    pitchBusinessPlan,\n    simulateTestPass,\n    subscriptions,\n    creditScore,\n    upcomingBills,\n    savingsGoals,\n    marketMovers,\n    financialGoals,\n    addFinancialGoal,\n    contributeToGoal,\n    generateGoalPlan,\n    cryptoAssets,\n    paymentOperations,\n    walletInfo,\n    virtualCard,\n    connectWallet,\n    issueCard,\n    buyCrypto,\n    aiInsights,\n    isInsightsLoading,\n    corporateCards,\n    corporateTransactions,\n    toggleCorporateCardFreeze,\n    updateCorporateCard,\n    rewardPoints,\n    notifications,\n    markNotificationRead,\n    isImportingData,\n    nftAssets,\n    mintNFT,\n    mintToken,\n    initiatePayment,\n    rewardItems,\n    redeemReward,\n    apiStatus,\n    creditFactors,\n    geminiApiKey,\n    setGeminiApiKey,\n    modernTreasuryApiKey,\n    setModernTreasuryApiKey,\n    modernTreasuryOrganizationId,\n    setModernTreasuryOrganizationId,\n    counterparties,\n    addCounterparty,\n    client: quantumClient,\n    userProfile\n  };\n\n  return <DataContext.Provider value={value}>{children}</DataContext.Provider>;\n};\n"
