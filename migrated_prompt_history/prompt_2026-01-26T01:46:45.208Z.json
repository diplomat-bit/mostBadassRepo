              "replacement": "\nimport React, { useState, useEffect, useCallback, useMemo, useRef, Reducer, useReducer } from 'react';\nimport { GoogleGenAI } from \"@google/genai\";\nimport Card from './Card';\n\nconst POLLING_MESSAGES = [\n    \"Initializing Veo 3.1 model...\",\n    \"Analyzing prompt semantics...\",\n    \"Generating initial keyframes...\",\n    \"Rendering motion vectors...\",\n    \"Upscaling to high resolution...\",\n    \"Adding audio layer...\",\n    \"Finalizing video file...\"\n];\n\n// =======================================================\n// TYPE DEFINITIONS\n// =======================================================\n\nexport type GenerationState = 'idle' | 'generating' | 'polling' | 'done' | 'error';\nexport type AspectRatio = '16:9' | '9:16';\nexport type VideoModel = 'veo-3.1-fast-generate-preview' | 'veo-3.1-generate-preview';\nexport type GenerationMode = 'single' | 'storyboard';\n\nexport interface GenerationSettings {\n    model: VideoModel;\n    aspectRatio: AspectRatio;\n    resolution: '720p' | '1080p';\n}\n\nexport interface VideoAsset {\n    id: string;\n    projectId: string;\n    url: string;\n    prompt: string;\n    creationDate: string;\n    settings: GenerationSettings;\n    isFavorite: boolean;\n}\n\nexport interface AdProject {\n    id: string;\n    name: string;\n    lastModified: string;\n    assets: VideoAsset[];\n}\n\n// =======================================================\n// MOCK BACKEND\n// =======================================================\n\nexport class MockBackendAPI {\n    private projects: AdProject[] = [];\n    constructor() { this.load(); }\n    private load() {\n        const stored = localStorage.getItem('ai_ad_studio_projects');\n        if (stored) this.projects = JSON.parse(stored);\n        else {\n            this.projects = [{ id: 'proj_default', name: 'My First Campaign', lastModified: new Date().toISOString(), assets: [] }];\n            this.save();\n        }\n    }\n    private save() { localStorage.setItem('ai_ad_studio_projects', JSON.stringify(this.projects)); }\n    public async getProjects() { return [...this.projects]; }\n    public async createProject(name: string) {\n        const p = { id: `proj_${Date.now()}`, name, lastModified: new Date().toISOString(), assets: [] };\n        this.projects.push(p);\n        this.save();\n        return p;\n    }\n    public async addAsset(projectId: string, asset: Omit<VideoAsset, 'id'>) {\n        const p = this.projects.find(x => x.id === projectId);\n        if (!p) return;\n        const newAsset = { ...asset, id: `asset_${Date.now()}` };\n        p.assets.unshift(newAsset);\n        p.lastModified = new Date().toISOString();\n        this.save();\n        return newAsset;\n    }\n    public async deleteAsset(projectId: string, assetId: string) {\n        const p = this.projects.find(x => x.id === projectId);\n        if (p) {\n            p.assets = p.assets.filter(a => a.id !== assetId);\n            this.save();\n        }\n    }\n}\n\nconst mockApi = new MockBackendAPI();\n\n// =======================================================\n// SUB-COMPONENTS\n// =======================================================\n\nexport const ProjectSidebar: React.FC<{\n    projects: AdProject[];\n    currentProjectId: string | null;\n    onSelect: (id: string) => void;\n    onCreate: (name: string) => void;\n}> = ({ projects, currentProjectId, onSelect, onCreate }) => {\n    const [name, setName] = useState('');\n    return (\n        <div className=\"w-64 bg-gray-900/50 border-r border-gray-800 p-4 flex flex-col h-full\">\n            <h3 className=\"text-lg font-bold text-white mb-4\">Ad Campaigns</h3>\n            <div className=\"flex gap-2 mb-6\">\n                <input\n                    value={name}\n                    onChange={e => setName(e.target.value)}\n                    placeholder=\"New...\"\n                    className=\"flex-1 bg-gray-800 border border-gray-700 rounded p-1 text-sm text-white\"\n                />\n                <button onClick={() => { onCreate(name); setName(''); }} className=\"bg-cyan-600 px-2 rounded text-white\">+</button>\n            </div>\n            <div className=\"flex-1 overflow-y-auto space-y-1\">\n                {projects.map(p => (\n                    <button\n                        key={p.id}\n                        onClick={() => onSelect(p.id)}\n                        className={`w-full text-left p-2 rounded text-sm transition-colors ${currentProjectId === p.id ? 'bg-cyan-600/20 text-cyan-400' : 'text-gray-400 hover:bg-gray-800'}`}\n                    >\n                        {p.name}\n                    </button>\n                ))}\n            </div>\n        </div>\n    );\n};\n\nexport const GenerationControls: React.FC<{\n    settings: GenerationSettings;\n    onChange: (s: Partial<GenerationSettings>) => void;\n    disabled: boolean;\n}> = ({ settings, onChange, disabled }) => (\n    <Card title=\"Video Parameters\">\n        <div className=\"grid grid-cols-2 gap-4\">\n            <div>\n                <label className=\"block text-xs text-gray-500 mb-1\">Aspect Ratio</label>\n                <select\n                    disabled={disabled}\n                    value={settings.aspectRatio}\n                    onChange={e => onChange({ aspectRatio: e.target.value as AspectRatio })}\n                    className=\"w-full bg-gray-800 border border-gray-700 rounded p-2 text-sm text-white\"\n                >\n                    <option value=\"16:9\">Landscape (16:9)</option>\n                    <option value=\"9:16\">Portrait (9:16)</option>\n                </select>\n            </div>\n            <div>\n                <label className=\"block text-xs text-gray-500 mb-1\">Resolution</label>\n                <select\n                    disabled={disabled}\n                    value={settings.resolution}\n                    onChange={e => onChange({ resolution: e.target.value as any })}\n                    className=\"w-full bg-gray-800 border border-gray-700 rounded p-2 text-sm text-white\"\n                >\n                    <option value=\"720p\">720p</option>\n                    <option value=\"1080p\">1080p</option>\n                </select>\n            </div>\n        </div>\n    </Card>\n);\n\n// =======================================================\n// MAIN COMPONENT\n// =======================================================\n\nconst AIAdStudioView: React.FC = () => {\n    const [hasKey, setHasKey] = useState<boolean | null>(null);\n    const [projects, setProjects] = useState<AdProject[]>([]);\n    const [currentProjectId, setCurrentProjectId] = useState<string | null>(null);\n    const [prompt, setPrompt] = useState('A cinematic drone shot of a high-tech city with neon lights reflecting on wet streets.');\n    const [settings, setSettings] = useState<GenerationSettings>({ model: 'veo-3.1-fast-generate-preview', aspectRatio: '16:9', resolution: '720p' });\n    const [isGenerating, setIsGenerating] = useState(false);\n    const [pollingIndex, setPollingIndex] = useState(0);\n    const [error, setError] = useState<string | null>(null);\n\n    const currentProject = projects.find(p => p.id === currentProjectId);\n\n    useEffect(() => {\n        const checkKey = async () => {\n            const selected = await window.aistudio.hasSelectedApiKey();\n            setHasKey(selected);\n        };\n        checkKey();\n        mockApi.getProjects().then(p => {\n            setProjects(p);\n            if (p.length > 0) setCurrentProjectId(p[0].id);\n        });\n    }, []);\n\n    const handleSelectKey = async () => {\n        await window.aistudio.openSelectKey();\n        setHasKey(true);\n    };\n\n    const handleGenerate = async () => {\n        if (!currentProjectId) return;\n        setIsGenerating(true);\n        setError(null);\n        \n        const interval = setInterval(() => {\n            setPollingIndex(idx => (idx + 1) % POLLING_MESSAGES.length);\n        }, 3000);\n\n        try {\n            const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });\n            let operation = await ai.models.generateVideos({\n                model: settings.model,\n                prompt: prompt,\n                config: {\n                    numberOfVideos: 1,\n                    resolution: settings.resolution,\n                    aspectRatio: settings.aspectRatio\n                }\n            });\n\n            while (!operation.done) {\n                await new Promise(r => setTimeout(r, 10000));\n                operation = await ai.operations.getVideosOperation({ operation });\n            }\n\n            const downloadLink = operation.response?.generatedVideos?.[0]?.video?.uri;\n            if (!downloadLink) throw new Error(\"No video generated\");\n\n            const finalUrl = `${downloadLink}&key=${process.env.API_KEY}`;\n            // FIX: Added projectId to new asset object to match VideoAsset interface requirement.\n            const newAsset = await mockApi.addAsset(currentProjectId, {\n                projectId: currentProjectId,\n                url: finalUrl,\n                prompt,\n                settings,\n                creationDate: new Date().toISOString(),\n                isFavorite: false\n            });\n\n            if (newAsset) {\n                setProjects(prev => prev.map(p => p.id === currentProjectId ? { ...p, assets: [newAsset, ...p.assets] } : p));\n            }\n\n        } catch (err: any) {\n            console.error(err);\n            if (err.message?.includes(\"Requested entity was not found\")) {\n                setHasKey(false);\n                setError(\"Your API key session expired. Please re-select your key.\");\n            } else {\n                setError(\"Failed to generate video. Please try a different prompt.\");\n            }\n        } finally {\n            clearInterval(interval);\n            setIsGenerating(false);\n        }\n    };\n\n    if (hasKey === null) return <div className=\"p-10 text-white\">Loading security session...</div>;\n\n    if (!hasKey) {\n        return (\n            <div className=\"h-full flex items-center justify-center\">\n                <Card title=\"API Key Required\" className=\"max-w-md text-center\">\n                    <p className=\"text-gray-400 mb-6\">\n                        To use the Veo 3.1 video generation engine, you must select a paid API key from your Google Cloud Project.\n                    </p>\n                    <a \n                        href=\"https://ai.google.dev/gemini-api/docs/billing\" \n                        target=\"_blank\" \n                        className=\"text-cyan-400 text-sm hover:underline block mb-6\"\n                    >\n                        Learn about Gemini API billing\n                    </a>\n                    <button\n                        onClick={handleSelectKey}\n                        className=\"w-full py-3 bg-cyan-600 hover:bg-cyan-700 text-white font-bold rounded-lg transition-transform hover:scale-105\"\n                    >\n                        Select API Key\n                    </button>\n                </Card>\n            </div>\n        );\n    }\n\n    return (\n        <div className=\"flex h-full bg-gray-950 text-white\">\n            <ProjectSidebar \n                projects={projects} \n                currentProjectId={currentProjectId} \n                onSelect={setCurrentProjectId}\n                onCreate={async (name) => {\n                    const p = await mockApi.createProject(name);\n                    setProjects(prev => [...prev, p]);\n                    setCurrentProjectId(p.id);\n                }}\n            />\n            \n            <main className=\"flex-1 p-6 space-y-6 overflow-y-auto\">\n                <header className=\"flex justify-between items-center\">\n                    <h2 className=\"text-3xl font-bold tracking-tight\">AI Ad Studio</h2>\n                    <div className=\"text-right\">\n                        <p className=\"text-sm text-gray-500\">Project: <span className=\"text-gray-300 font-medium\">{currentProject?.name}</span></p>\n                    </div>\n                </header>\n\n                <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n                    <div className=\"lg:col-span-2 space-y-6\">\n                        <Card title=\"Script & Prompt\">\n                            <textarea\n                                value={prompt}\n                                onChange={e => setPrompt(e.target.value)}\n                                disabled={isGenerating}\n                                className=\"w-full h-32 bg-gray-900 border border-gray-800 rounded-lg p-3 text-sm focus:ring-1 focus:ring-cyan-500 outline-none\"\n                                placeholder=\"Describe your cinematic advertisement...\"\n                            />\n                            <button\n                                onClick={handleGenerate}\n                                disabled={isGenerating || !prompt}\n                                className=\"w-full mt-4 py-3 bg-cyan-600 hover:bg-cyan-700 text-white font-bold rounded-lg disabled:opacity-50 flex items-center justify-center gap-2\"\n                            >\n                                {isGenerating ? (\n                                    <>\n                                        <div className=\"w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin\"></div>\n                                        {POLLING_MESSAGES[pollingIndex]}\n                                    </>\n                                ) : \"Generate Video Ad\"}\n                            </button>\n                            {error && <p className=\"mt-2 text-xs text-red-400 text-center\">{error}</p>}\n                        </Card>\n\n                        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n                            {currentProject?.assets.map(asset => (\n                                <div key={asset.id} className=\"group relative bg-gray-900 rounded-lg overflow-hidden border border-gray-800\">\n                                    <video \n                                        src={asset.url} \n                                        className=\"w-full aspect-video object-cover\" \n                                        muted \n                                        loop \n                                        onMouseEnter={e => e.currentTarget.play()} \n                                        onMouseLeave={e => { e.currentTarget.pause(); e.currentTarget.currentTime = 0; }}\n                                    />\n                                    <div className=\"p-2\">\n                                        <p className=\"text-[10px] text-gray-500 truncate\">{asset.prompt}</p>\n                                        <div className=\"flex justify-between items-center mt-1\">\n                                            <span className=\"text-[9px] text-gray-600\">{new Date(asset.creationDate).toLocaleDateString()}</span>\n                                            <a href={asset.url} download className=\"text-cyan-500 text-[10px] hover:underline\">Download</a>\n                                        </div>\n                                    </div>\n                                </div>\n                            ))}\n                        </div>\n                    </div>\n\n                    <div className=\"space-y-6\">\n                        <GenerationControls \n                            settings={settings} \n                            onChange={s => setSettings(prev => ({ ...prev, ...s }))} \n                            disabled={isGenerating} \n                        />\n                        \n                        <Card title=\"Production Tips\">\n                            <ul className=\"text-xs text-gray-500 space-y-2 list-disc pl-4\">\n                                <li>Be specific about camera movement (e.g., \"slow zoom\", \"panning\").</li>\n                                <li>Include lighting details (e.g., \"golden hour\", \"neon glow\").</li>\n                                <li>Mention style (e.g., \"photorealistic\", \"cyberpunk\").</li>\n                                <li>Veo 3.1 generation usually takes 2-4 minutes.</li>\n                            </ul>\n                        </Card>\n                    </div>\n                </div>\n            </main>\n        </div>\n    );\n};\n\nexport default AIAdStudioView;\n"
